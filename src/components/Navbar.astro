---
import { SignedIn, SignedOut } from '@clerk/astro/components';
---

<nav>
  <a href="/" class="nav-logo">Unmarked</a>

  <ul class="nav-links">
    <li><a href="/destinazioni">Destinazioni</a></li>
    <li><a href="/itinerari">Itinerari</a></li>
    <li><a href="/film">Film</a></li>
    <li><a href="/podcast">Podcast</a></li>
    <li><a href="/consulenze">Consulenze</a></li>
  </ul>

  <div class="nav-icons">
    <button id="nav-search-btn" class="nav-icon-btn" aria-label="Cerca">
      <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="9" cy="9" r="6"/>
        <path d="M15 15l3 3" stroke-linecap="round"/>
      </svg>
    </button>
    <a href="/mappa" class="nav-icon-btn" aria-label="Mappa mondo">
      <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <!-- Cornice mappa -->
        <rect x="1" y="3" width="18" height="14" rx="1"/>
        <!-- Nord America -->
        <path fill="currentColor" stroke="none" d="M2.5 5.5h3.5l.5 1.5L6 9l-1 1.5-1.5-.5L2 8.5V7z"/>
        <!-- Sud America -->
        <path fill="currentColor" stroke="none" d="M5 11l2-.5.5 2.5-.5 2.5-1.5.5-1-1.5z"/>
        <!-- Europa -->
        <path fill="currentColor" stroke="none" d="M9.5 5h2l.5 1.5-1 2H9.5L9 7z"/>
        <!-- Africa -->
        <path fill="currentColor" stroke="none" d="M9.5 8.5h2.5l.5 3-.5 3-2 .5-1-2V10z"/>
        <!-- Asia -->
        <path fill="currentColor" stroke="none" d="M12 5h5.5l1 2v2.5l-3 1.5-3.5-.5V7z"/>
        <!-- Australia -->
        <path fill="currentColor" stroke="none" d="M15.5 13h2.5l.5 2-1.5 1.5-2-.5.5-2z"/>
      </svg>
    </a>
    <SignedOut>
      <a href="/sign-in" class="btn-abbonati">Accedi</a>
    </SignedOut>
    <SignedIn>
      <a href="/account" class="nav-account-link" title="Il mio account">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="10" cy="7" r="3"/>
          <path d="M3 18c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke-linecap="round"/>
        </svg>
      </a>
    </SignedIn>
  </div>
</nav>

<style>
  .nav-icon-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .nav-account-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-avatar-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--terra);
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .nav-account-link:hover .nav-avatar-dot {
    opacity: 1;
  }
</style>