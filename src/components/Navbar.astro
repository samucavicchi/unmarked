---
import { SignedIn, SignedOut } from '@clerk/astro/components';
---

<nav>
  <a href="/" class="nav-logo">Unmarked</a>

  <ul class="nav-links">
    <li><a href="/destinazioni">Destinazioni</a></li>
    <li><a href="/itinerari">Itinerari</a></li>
    <li><a href="/film">Film</a></li>
    <li><a href="/podcast">Podcast</a></li>
    <li><a href="/consulenze">Consulenze</a></li>
    <li><a href="/chi-siamo">Chi siamo</a></li>
  </ul>

  <button class="nav-hamburger" id="nav-hamburger" aria-label="Menu" style="display:none;">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="2" y1="5" x2="18" y2="5"/>
      <line x1="2" y1="10" x2="18" y2="10"/>
      <line x1="2" y1="15" x2="18" y2="15"/>
    </svg>
  </button>

  <div class="nav-icons">
    <button id="nav-search-btn" class="nav-icon-btn" aria-label="Cerca">
      <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="9" cy="9" r="6"/>
        <path d="M15 15l3 3" stroke-linecap="round"/>
      </svg>
    </button>
    <a href="/mappa" class="nav-icon-btn" aria-label="Mappa mondo">
      <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M10 2a6 6 0 0 1 6 6c0 4-6 10-6 10S4 12 4 8a6 6 0 0 1 6-6z" stroke-linejoin="round"/>
        <circle cx="10" cy="8" r="2"/>
      </svg>
    </a>
    <SignedOut>
      <a href="/sign-in" class="btn-abbonati">Accedi</a>
    </SignedOut>
    <SignedIn>
      <a href="/account" class="nav-account-link" title="Il mio account">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="10" cy="7" r="3"/>
          <path d="M3 18c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke-linecap="round"/>
        </svg>
      </a>
    </SignedIn>
  </div>
</nav>

<script is:inline>
  function initHamburger() {
    const btn = document.getElementById('nav-hamburger');
    if (!btn) return;
    // Rimuovi vecchi listener clonando il nodo
    const newBtn = btn.cloneNode(true);
    btn.parentNode.replaceChild(newBtn, btn);
    newBtn.addEventListener('click', function () {
      document.querySelector('nav').classList.toggle('nav-open');
    });
  }

  function initNavClose() {
    document.addEventListener('click', function (e) {
      if (!e.target.closest('nav')) {
        const nav = document.querySelector('nav');
        if (nav) nav.classList.remove('nav-open');
      }
    });
  }

  // Prima carica
  document.addEventListener('DOMContentLoaded', function () {
    initHamburger();
    initNavClose();
  });

  // Dopo ogni navigazione con ViewTransitions
  document.addEventListener('astro:page-load', initHamburger);
</script>

<style>
  .nav-hamburger {
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--muted);
    display: none;
    align-items: center;
    order: -1;
  }
  .nav-icon-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .nav-account-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .nav-avatar-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--terra);
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  .nav-account-link:hover .nav-avatar-dot {
    opacity: 1;
  }
</style>