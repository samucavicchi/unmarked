---
// Newsletter — sezione iscrizione.
// I numeri sono placeholder: collegheremo i veri stats quando avremo Buttondown/Substack/altro.

export interface Props {
  readers?: string;
  issues?: string;
}

const {
  readers = '4.800+',
  issues = '52'
} = Astro.props;
---

<div class="nl-section">
  <div class="nl-left">
    <div class="nl-logo">Unmarked</div>
    <div class="nl-stats">
      <div>
        <div class="nl-stat-num">{readers}</div>
        <div class="nl-stat-label">Lettori ogni lunedì</div>
      </div>
      <div>
        <div class="nl-stat-num">{issues}</div>
        <div class="nl-stat-label">Numeri pubblicati</div>
      </div>
    </div>
  </div>
  <div class="nl-right">
    <div class="nl-copy">
      <div class="nl-tag">Itinerario settimanale</div>
      <div class="nl-title">Ogni lunedì una rotta.</div>
      <div class="nl-sub">
        Quello che i travel blog non pubblicano,<br />
        nella tua casella ogni settimana.
      </div>
    </div>
    <div>
      <form class="nl-form" id="nl-form-home">
        <input class="nl-input" type="email" name="email" placeholder="la tua email" required />
        <button class="nl-btn" type="submit">Iscriviti — è gratis</button>
      </form>
      <div id="nl-msg-home" style="display:none;margin-top:8px;font-size:12px;color:var(--terra);"></div>
      <div class="nl-legal" style="margin-top:8px;">Nessuno spam. Disiscrizione in un click.</div>

      <script is:inline>
        document.getElementById('nl-form-home').addEventListener('submit', async function(e) {
          e.preventDefault();
          const email = this.email.value;
          const btn = this.querySelector('button');
          const msg = document.getElementById('nl-msg-home');
          btn.disabled = true;
          btn.textContent = '...';
          try {
            const res = await fetch('/.netlify/functions/newsletter-subscribe', {
              method: 'POST',
              body: JSON.stringify({ email }),
            });
            if (res.ok) {
              msg.textContent = 'Grazie! Sei iscritto alla newsletter.';
              msg.style.display = 'block';
              this.reset();
            } else {
              msg.textContent = 'Qualcosa è andato storto. Riprova.';
              msg.style.display = 'block';
            }
          } catch {
            msg.textContent = 'Errore di connessione. Riprova.';
            msg.style.display = 'block';
          }
          btn.disabled = false;
          btn.textContent = 'Iscriviti — è gratis';
        });
      </script>
    </div>
  </div>
</div>
