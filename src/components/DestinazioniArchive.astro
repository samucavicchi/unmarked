---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'destinazioni'>[];
  continenti: string[];
  eyebrow: string;
  title: string;
  description: string;
  currentContinent?: string | null;
  currentPaese?: string | null;
  backLink?: boolean;
}

const {
  items,
  continenti,
  eyebrow,
  title,
  description,
  currentContinent = null,
  currentPaese = null,
  backLink = false,
} = Astro.props;

const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');

const isAllActive = !currentContinent && !currentPaese;

type DestEntry = CollectionEntry<'destinazioni'>;
const featured: DestEntry[] = items.filter((e) => e.data.featured);
const normali: DestEntry[] = items.filter((e) => !e.data.featured);
const ordered: DestEntry[] = [...normali];
featured.forEach((f, i) => {
  const total = ordered.length + 1;
  const pos = Math.floor((total * (i + 1)) / (featured.length + 1));
  ordered.splice(pos, 0, f);
});
---

{/* HERO */}
<div class="dst-hero">
  <div class="dst-hero-overlay"></div>
  <div class="dst-hero-content">
    <div class="dst-hero-tag">{eyebrow}</div>
    <h1 class="dst-hero-title">{title}</h1>
    <p class="dst-hero-sub">{description}</p>
    {backLink && (
      <a href="/destinazioni" class="dst-hero-back">← Tutte le destinazioni</a>
    )}
  </div>
</div>

{/* FILTRI */}
<div class="dst-filters-bar">
  <a href="/destinazioni" class={`dst-filter-btn ${isAllActive ? 'active' : ''}`}>Tutti</a>
  {continenti.map((c) => {
    const cSlug = slugify(c);
    const active = currentContinent === cSlug;
    return (
      <a href={`/destinazioni/continente/${cSlug}`} class={`dst-filter-btn ${active ? 'active' : ''}`}>{c}</a>
    );
  })}
</div>

{/* GRIGLIA */}
{ordered.length === 0 ? (
  <div class="dst-empty">
    <p>Nessuna destinazione qui per ora. Torna fra qualche giorno.</p>
  </div>
) : (
  <div class="dst-grid">
    {ordered.map((entry) => {
      const isFeat = entry.data.featured;
      return (
        <a href={`/destinazioni/${entry.slug}`} class={`dst-card ${isFeat ? 'dst-card-feat' : ''}`}>
          <div class="dst-card-img">
            <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} />
            <div class="dst-card-img-ov"></div>
            {isFeat && (
              <div class="dst-card-badges">
                <span class="dst-badge dst-badge-feat">In evidenza</span>
              </div>
            )}
            <div class="dst-card-img-title">
              <div class="dst-card-area">{entry.data.country} · {entry.data.continent}</div>
              <div class="dst-card-name">{entry.data.title}</div>
            </div>
          </div>
          <div class="dst-card-body">
            <div class="dst-card-desc">{entry.data.excerpt}</div>
            <div class="dst-card-foot">
              <span class="dst-card-label">{entry.data.region || 'Reportage'}</span>
              <span class="dst-card-cta">Leggi →</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
)}

<style>
  .dst-hero { position: relative; width: 100%; min-height: 280px; background: var(--dark); padding: 56px 40px 48px; overflow: hidden; }
  .dst-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(26,24,20,0.94) 0%, rgba(26,24,20,0.7) 60%, rgba(26,24,20,0.5) 100%); z-index: 1; }
  .dst-hero-content { position: relative; z-index: 2; max-width: 720px; }
  .dst-hero-tag { font-size: 9px; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sand); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .dst-hero-tag::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--terra); }
  .dst-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 52px; font-weight: 300; color: #FAFAF8; line-height: 1.0; margin-bottom: 14px; }
  .dst-hero-sub { font-size: 13px; font-weight: 300; color: rgba(250,250,248,0.65); line-height: 1.72; max-width: 520px; }
  .dst-hero-back { display: inline-block; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--terra); text-decoration: none; margin-top: 18px; }
  .dst-hero-back:hover { text-decoration: underline; }

  .dst-filters-bar { padding: 20px 40px; border-bottom: 1px solid var(--light-border); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .dst-filter-btn { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; padding: 7px 14px; border: 1px solid var(--light-border); border-radius: 2px; color: var(--muted); background: transparent; text-decoration: none; transition: all 0.2s; }
  .dst-filter-btn:hover { border-color: var(--terra); color: var(--terra); }
  .dst-filter-btn.active { background: var(--dark); color: #FAFAF8; border-color: var(--dark); }

  .dst-grid { padding: 40px 40px 60px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .dst-empty { text-align: center; padding: 80px 40px; color: var(--muted); font-style: italic; }

  .dst-card { border: 1px solid var(--light-border); border-radius: 3px; overflow: hidden; cursor: pointer; transition: border-color 0.2s; display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--cream); }
  .dst-card:hover { border-color: var(--sand); }
  .dst-card-feat { grid-column: span 2; flex-direction: row; border-color: rgba(26,24,20,0.35); }
  .dst-card-feat .dst-card-img { flex: 1 1 50%; height: auto; min-height: 320px; }
  .dst-card-feat .dst-card-body { flex: 1 1 50%; display: flex; flex-direction: column; justify-content: center; padding: 28px 32px; }

  .dst-card-img { height: 220px; position: relative; overflow: hidden; }
  .dst-card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .dst-card:hover .dst-card-img img { transform: scale(1.04); }
  .dst-card-img-ov { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.6) 0%, transparent 55%); }
  .dst-card-badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; }
  .dst-badge { font-size: 8px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; padding: 3px 8px; border-radius: 2px; }
  .dst-badge-feat { background: var(--terra); color: #fff; }
  .dst-card-img-title { position: absolute; bottom: 0; left: 0; right: 0; padding: 14px 16px; }
  .dst-card-area { font-size: 8px; font-weight: 300; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(250,250,248,0.55); margin-bottom: 4px; }
  .dst-card-name { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 300; color: #FAFAF8; line-height: 1.2; }
  .dst-card-feat .dst-card-name { font-size: 30px; line-height: 1.1; }

  .dst-card-body { padding: 16px 18px; display: flex; flex-direction: column; flex: 1; }
  .dst-card-desc { font-size: 12px; font-weight: 300; color: var(--muted); line-height: 1.65; flex: 1; margin-bottom: 14px; }
  .dst-card-feat .dst-card-desc { font-size: 14px; line-height: 1.7; margin-bottom: 22px; }
  .dst-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--light-border); margin-top: auto; }
  .dst-card-label { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .dst-card-cta { font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); }

  @media (max-width: 900px) {
    .dst-hero { padding: 40px 24px 32px; min-height: 240px; }
    .dst-hero-title { font-size: 40px; }
    .dst-grid { grid-template-columns: repeat(2, 1fr); padding: 32px 24px 40px; gap: 20px; }
    .dst-card-feat { grid-column: span 2; flex-direction: column; }
    .dst-card-feat .dst-card-img { min-height: 0; height: 240px; }
    .dst-card-feat .dst-card-body { padding: 18px 20px; }
    .dst-card-feat .dst-card-name { font-size: 24px; }
    .dst-card-feat .dst-card-desc { font-size: 13px; margin-bottom: 14px; }
    .dst-filters-bar { padding: 16px 24px; }
  }
  @media (max-width: 600px) {
    .dst-grid { grid-template-columns: 1fr; }
    .dst-card-feat { grid-column: span 1; }
    .dst-hero-title { font-size: 34px; }
  }
</style>
