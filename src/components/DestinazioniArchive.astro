---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'libreria'>[];
  continenti: string[];
  eyebrow: string;
  title: string;
  description: string;
  currentContinent?: string | null;
  currentPaese?: string | null;
  backLink?: boolean;
  grouped?: boolean;
}

const {
  items,
  continenti,
  eyebrow,
  title,
  description,
  currentContinent = null,
  currentPaese = null,
  backLink = false,
  grouped = false,
} = Astro.props;

const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
const isAllActive = !currentContinent && !currentPaese;

const heroEntry = items.find((e) => e.data.featured) ?? items[0] ?? null;
const gridItems = heroEntry ? items.filter((e) => e.slug !== heroEntry.slug) : items;

// Ordine categorie per la visualizzazione a sezioni
const CATEGORY_ORDER = ['Destinazione', 'Attrezzatura', 'Consigli di viaggio', 'Cosa portare', 'Ispirazione'];
const grouped_sections = grouped
  ? CATEGORY_ORDER
      .map(cat => ({
        cat,
        entries: gridItems.filter(e => (e.data.category ?? 'Destinazione') === cat),
      }))
      .filter(s => s.entries.length > 0)
  : [];
---

{/* HERO CARD */}
{heroEntry ? (
  <div class="dst-hero-wrap">
    {backLink && (
      <div class="dst-hero-topbar">
        <a href="/libreria" class="dst-hero-back">← Tutta la libreria</a>
      </div>
    )}
    <a href={`/libreria/${heroEntry.slug}`} class="dst-hero-card">
      <div class="dst-hero-card-photo">
        <img src={heroEntry.data.coverImage.src} alt={heroEntry.data.coverImageAlt} class="dst-hero-card-bg" />
        <div class="dst-hero-card-overlay"></div>
        <div class="dst-hero-card-top">
          <span class="dst-hero-card-archive">{eyebrow}</span>
        </div>
        <div class="dst-hero-card-bottom">
          <div class="dst-hero-card-text">
            <div class="dst-hero-card-geo">{heroEntry.data.category || 'Libreria'}{heroEntry.data.country ? ` · ${heroEntry.data.country}` : ''}{heroEntry.data.continent ? ` · ${heroEntry.data.continent}` : ''}</div>
            <h1 class="dst-hero-card-title">{heroEntry.data.title}</h1>
            {heroEntry.data.subtitle && <p class="dst-hero-card-sub">{heroEntry.data.subtitle}</p>}
          </div>
          <span class="dst-hero-card-cta-btn">Leggi il reportage</span>
        </div>
      </div>
      <div class="dst-hero-card-strip">
        <div class="dst-hero-strip-desc">{heroEntry.data.excerpt}</div>
        <div class="dst-hero-strip-foot">
          <span class="dst-hero-strip-label">{heroEntry.data.region || 'Reportage'}</span>
        </div>
      </div>
    </a>
  </div>
) : (
  <div class="dst-hero">
    <div class="dst-hero-overlay"></div>
    <div class="dst-hero-content">
      <div class="dst-hero-tag">{eyebrow}</div>
      <h1 class="dst-hero-title">{title}</h1>
      <p class="dst-hero-sub">{description}</p>
      {backLink && <a href="/libreria" class="dst-hero-back-plain">← Tutta la libreria</a>}
    </div>
  </div>
)}

{/* FILTRI — sfondo scuro */}
<div class="dst-filters-bar">
  <a href="/libreria" class={`dst-filter-btn ${isAllActive ? 'active' : ''}`}>Tutti</a>
  {continenti.map((c) => {
    const cSlug = slugify(c);
    const active = currentContinent === cSlug;
    return (
      <a href={`/libreria/continente/${cSlug}`} class={`dst-filter-btn ${active ? 'active' : ''}`}>{c}</a>
    );
  })}
</div>

{/* VISTA FLAT (pagine filtrate per continente/paese) */}
{!grouped && (
  gridItems.length === 0 ? (
    <div class="dst-empty">
      <p>Nessun articolo qui per ora. Torna fra qualche giorno.</p>
    </div>
  ) : (
    <div class="dst-grid">
      {gridItems.map((entry) => (
        <a href={`/libreria/${entry.slug}`} class="dst-card">
          <div class="dst-card-img">
            <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} />
            <div class="dst-card-img-ov"></div>
            <div class="dst-card-img-title">
              <div class="dst-card-area">{entry.data.country}{entry.data.continent ? ` · ${entry.data.continent}` : ''}</div>
              <div class="dst-card-name">{entry.data.title}</div>
            </div>
          </div>
          <div class="dst-card-body">
            <div class="dst-card-desc">{entry.data.excerpt}</div>
            <div class="dst-card-foot">
              <span class="dst-card-label">{entry.data.category || entry.data.region || 'Reportage'}</span>
              <span class="dst-card-cta">Leggi</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  )
)}

{/* VISTA A SEZIONI PER CATEGORIA (pagina principale libreria) */}
{grouped && (
  <div class="dst-sections">
    {grouped_sections.map(({ cat, entries }) => (
      <section class="dst-section">
        <div class="dst-section-header">
          <span class="dst-section-label">{cat}</span>
          <div class="dst-section-line"></div>
        </div>
        <div class="dst-grid dst-grid--section">
          {entries.map((entry) => (
            <a href={`/libreria/${entry.slug}`} class="dst-card">
              <div class="dst-card-img">
                <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} />
                <div class="dst-card-img-ov"></div>
                <div class="dst-card-img-title">
                  <div class="dst-card-area">{entry.data.country}{entry.data.continent ? ` · ${entry.data.continent}` : ''}</div>
                  <div class="dst-card-name">{entry.data.title}</div>
                </div>
              </div>
              <div class="dst-card-body">
                <div class="dst-card-desc">{entry.data.excerpt}</div>
                <div class="dst-card-foot">
                  <span class="dst-card-label">{entry.data.region || cat}</span>
                  <span class="dst-card-cta">Leggi</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
)}

<style>
/* HERO WRAP */
.dst-hero-wrap { position: relative; }
.dst-hero-topbar { padding: 16px 40px 0; }
.dst-hero-back { font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--terra); text-decoration: none; }
.dst-hero-back:hover { text-decoration: underline; }

/* HERO CARD */
.dst-hero-card { display: block; text-decoration: none; color: inherit; }

.dst-hero-card-photo { position: relative; height: 520px; overflow: hidden; }
.dst-hero-card-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
.dst-hero-card:hover .dst-hero-card-bg { transform: scale(1.03); }
.dst-hero-card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.78) 0%, rgba(26,24,20,0.28) 55%, rgba(26,24,20,0.1) 100%); }

.dst-hero-card-top { position: absolute; top: 0; left: 0; right: 0; padding: 28px 40px; z-index: 2; }
.dst-hero-card-archive { font-size: 9px; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sand); display: inline-flex; align-items: center; gap: 10px; }
.dst-hero-card-archive::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--terra); }

.dst-hero-card-bottom { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 40px 36px; z-index: 2; display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 32px; }
.dst-hero-card-text { flex: 1; }
.dst-hero-card-geo { font-size: 9px; font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(250,250,248,0.5); margin-bottom: 10px; }
.dst-hero-card-title { font-family: 'Cormorant Garamond', serif; font-size: 62px; font-weight: 300; color: #FAFAF8; line-height: 1.0; margin-bottom: 10px; letter-spacing: 0.01em; }
.dst-hero-card-sub { font-size: 15px; font-weight: 300; color: rgba(250,250,248,0.72); line-height: 1.55; }

.dst-hero-card-cta-btn { flex-shrink: 0; display: inline-block; border: 1px solid rgba(250,250,248,0.55); color: #FAFAF8; font-size: 9px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; padding: 13px 22px; white-space: nowrap; align-self: flex-end; margin-bottom: 6px; transition: background 0.25s ease, border-color 0.25s ease; }
.dst-hero-card:hover .dst-hero-card-cta-btn { background: rgba(250,250,248,0.1); border-color: rgba(250,250,248,0.9); }

/* STRISCIA BIANCA */
.dst-hero-card-strip { background: var(--cream); border: 1px solid var(--light-border); border-top: none; padding: 18px 40px 20px; }
.dst-hero-strip-desc { font-size: 13px; font-weight: 300; color: var(--muted); line-height: 1.65; margin-bottom: 14px; }
.dst-hero-strip-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--light-border); }
.dst-hero-strip-label { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

/* FALLBACK HERO */
.dst-hero { position: relative; width: 100%; min-height: 280px; background: var(--dark); padding: 56px 40px 48px; overflow: hidden; }
.dst-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(26,24,20,0.94) 0%, rgba(26,24,20,0.7) 60%, rgba(26,24,20,0.5) 100%); z-index: 1; }
.dst-hero-content { position: relative; z-index: 2; max-width: 720px; }
.dst-hero-tag { font-size: 9px; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sand); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
.dst-hero-tag::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--terra); }
.dst-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 52px; font-weight: 300; color: #FAFAF8; line-height: 1.0; margin-bottom: 14px; }
.dst-hero-sub { font-size: 13px; font-weight: 300; color: rgba(250,250,248,0.65); line-height: 1.72; max-width: 520px; }
.dst-hero-back-plain { display: inline-block; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--terra); text-decoration: none; margin-top: 18px; }

/* FILTRI SCURI */
.dst-filters-bar { padding: 16px 40px; background: var(--dark); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.dst-filter-btn { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; padding: 7px 14px; border: 1px solid rgba(250,250,248,0.15); border-radius: 2px; color: rgba(250,250,248,0.45); background: transparent; text-decoration: none; transition: all 0.2s; }
.dst-filter-btn:hover { border-color: var(--terra); color: var(--sand); }
.dst-filter-btn.active { background: rgba(250,250,248,0.08); color: #FAFAF8; border-color: rgba(250,250,248,0.35); }

/* GRIGLIA */
.dst-grid { padding: 40px 40px 60px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }

/* SEZIONI PER CATEGORIA */
.dst-sections { padding: 16px 0 60px; }
.dst-section { margin-bottom: 12px; }
.dst-section-header { display: flex; align-items: center; gap: 20px; padding: 32px 40px 0; }
.dst-section-label { font-size: 9px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: var(--terra); white-space: nowrap; }
.dst-section-line { flex: 1; height: 1px; background: var(--light-border); }
.dst-grid--section { padding-top: 24px; padding-bottom: 0; }
.dst-empty { text-align: center; padding: 80px 40px; color: var(--muted); font-style: italic; }

/* CARD */
.dst-card { border: 1px solid var(--light-border); border-radius: 3px; overflow: hidden; cursor: pointer; transition: border-color 0.2s; display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--cream); }
.dst-card:hover { border-color: var(--sand); }
.dst-card-img { height: 220px; position: relative; overflow: hidden; }
.dst-card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.dst-card:hover .dst-card-img img { transform: scale(1.04); }
.dst-card-img-ov { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.6) 0%, transparent 55%); }
.dst-card-img-title { position: absolute; bottom: 0; left: 0; right: 0; padding: 14px 16px; }
.dst-card-area { font-size: 8px; font-weight: 300; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(250,250,248,0.55); margin-bottom: 4px; }
.dst-card-name { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 300; color: #FAFAF8; line-height: 1.2; }
.dst-card-body { padding: 16px 18px; display: flex; flex-direction: column; flex: 1; }
.dst-card-desc { font-size: 12px; font-weight: 300; color: var(--muted); line-height: 1.65; flex: 1; margin-bottom: 14px; }
.dst-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--light-border); margin-top: auto; }
.dst-card-label { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.dst-card-cta { font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); }

/* RESPONSIVE */
@media (max-width: 900px) {
  .dst-hero-card-photo { height: 420px; }
  .dst-hero-card-title { font-size: 44px; }
  .dst-hero-card-bottom { padding: 28px 24px 32px; gap: 20px; }
  .dst-hero-card-top { padding: 20px 24px; }
  .dst-hero-topbar { padding: 14px 24px 0; }
  .dst-hero-card-strip { padding: 16px 24px 18px; }
  .dst-grid { grid-template-columns: repeat(2, 1fr); padding: 32px 24px 40px; gap: 20px; }
  .dst-filters-bar { padding: 14px 24px; }
}
@media (max-width: 600px) {
  .dst-hero-card-photo { height: 360px; }
  .dst-hero-card-title { font-size: 34px; }
  .dst-hero-card-bottom { flex-direction: column; align-items: flex-start; gap: 16px; }
  .dst-hero-card-cta-btn { align-self: flex-start; }
  .dst-grid { grid-template-columns: 1fr; }
}
</style>
