---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'libreria'>[];
  continenti: string[];
  eyebrow: string;
  title: string;
  description: string;
  currentContinent?: string | null;
  currentPaese?: string | null;
  backLink?: boolean;
  grouped?: boolean;
}

const {
  items,
  continenti,
  eyebrow,
  title,
  description,
  currentContinent = null,
  currentPaese = null,
  backLink = false,
  grouped = false,
} = Astro.props;

const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
const isAllActive = !currentContinent && !currentPaese;

// ── MODALITÀ GROUPED (pagina principale libreria) ──────────────────────
const featuredEntry = grouped
  ? (items.find((e) => e.data.featured) ?? items[0] ?? null)
  : null;

const CATEGORY_ORDER = ['Destinazione', 'Attrezzatura', 'Consigli di viaggio', 'Cosa portare', 'Ispirazione'];

const grouped_sections = grouped
  ? CATEGORY_ORDER
      .map(cat => ({
        cat,
        entries: items.filter(e => (e.data.category ?? 'Destinazione') === cat),
      }))
      .filter(s => s.entries.length > 0)
  : [];

// ── MODALITÀ FILTRATA (continente/paese) ──────────────────────────────
const heroEntry = grouped ? null : (items.find((e) => e.data.featured) ?? items[0] ?? null);
const gridItems = heroEntry ? items.filter((e) => e.slug !== heroEntry.slug) : items;
---

{/* ════════════════════════════════════════════════
    VISTA NETFLIX — pagina principale libreria
    ════════════════════════════════════════════════ */}
{grouped && featuredEntry && (
  <>
    {/* HERO con crossfade */}
    <div class="nx-hero" id="nx-hero">
      {/* Layer A — immagine attiva */}
      <img
        class="nx-hero-img nx-layer-a is-active"
        id="nx-layer-a"
        src={featuredEntry.data.coverImage.src}
        alt={featuredEntry.data.coverImageAlt}
      />
      {/* Layer B — immagine in arrivo */}
      <img
        class="nx-hero-img nx-layer-b"
        id="nx-layer-b"
        src={featuredEntry.data.coverImage.src}
        alt=""
      />
      <div class="nx-hero-overlay"></div>
      <div class="nx-hero-content">
        <span class="nx-hero-cat">{featuredEntry.data.category}{featuredEntry.data.country ? ` · ${featuredEntry.data.country}` : ''}</span>
        <h1 class="nx-hero-title" id="nx-hero-title">{featuredEntry.data.title}</h1>
        <p class="nx-hero-excerpt" id="nx-hero-excerpt">{featuredEntry.data.excerpt}</p>
        <a class="nx-hero-btn" id="nx-hero-btn" href={`/libreria/${featuredEntry.slug}`}>Leggi</a>
      </div>
      {/* Fade in basso verso il resto della pagina */}
      <div class="nx-hero-bottom-fade"></div>
    </div>

    {/* RIGHE PER CATEGORIA */}
    <div class="nx-rows">
      {grouped_sections.map(({ cat, entries }) => (
        <div class="nx-row">
          <div class="nx-row-header">
            <span class="nx-row-label">{cat}</span>
            <div class="nx-row-line"></div>
          </div>
          <div class="nx-row-track-wrap">
            <button class="nx-arrow nx-arrow-prev" aria-label="Precedente">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="nx-row-track">
              {entries.map((entry) => (
                <a
                  href={`/libreria/${entry.slug}`}
                  class="nx-card"
                  data-cover={entry.data.coverImage.src}
                  data-title={entry.data.title}
                  data-excerpt={entry.data.excerpt}
                  data-href={`/libreria/${entry.slug}`}
                  data-cat={`${entry.data.category}${entry.data.country ? ' · ' + entry.data.country : ''}`}
                >
                  <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} class="nx-card-img" />
                  {/* Info sempre visibili */}
                  <div class="nx-card-info">
                    <span class="nx-card-info-cat">{entry.data.category}</span>
                    <div class="nx-card-info-title">{entry.data.title}</div>
                  </div>
                  {/* CTA solo all'hover */}
                  <div class="nx-card-hover">
                    <span class="nx-card-hover-cta">Leggi →</span>
                  </div>
                </a>
              ))}
            </div>
            <button class="nx-arrow nx-arrow-next" aria-label="Successivo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
      ))}
    </div>
  </>
)}

{/* Fallback grouped senza articoli */}
{grouped && !featuredEntry && (
  <div class="dst-hero-classic">
    <div class="dst-hero-classic-content">
      <div class="dst-hero-tag">{eyebrow}</div>
      <h1 class="dst-hero-title">{title}</h1>
      <p class="dst-hero-sub">{description}</p>
    </div>
  </div>
)}

{/* ════════════════════════════════════════════════
    VISTA FILTRATA — continente / paese
    ════════════════════════════════════════════════ */}

{/* HERO CARD — pagine filtrate */}
{!grouped && heroEntry && (
  <div class="dst-hero-wrap">
    {backLink && (
      <div class="dst-hero-topbar">
        <a href="/libreria" class="dst-hero-back">Tutta la libreria</a>
      </div>
    )}
    <a href={`/libreria/${heroEntry.slug}`} class="dst-hero-card">
      <div class="dst-hero-card-photo">
        <img src={heroEntry.data.coverImage.src} alt={heroEntry.data.coverImageAlt} class="dst-hero-card-bg" />
        <div class="dst-hero-card-overlay"></div>
        <div class="dst-hero-card-top">
          <span class="dst-hero-card-archive">{eyebrow}</span>
        </div>
        <div class="dst-hero-card-bottom">
          <div class="dst-hero-card-text">
            <div class="dst-hero-card-geo">{heroEntry.data.category || 'Libreria'}{heroEntry.data.country ? ` · ${heroEntry.data.country}` : ''}{heroEntry.data.continent ? ` · ${heroEntry.data.continent}` : ''}</div>
            <h1 class="dst-hero-card-title">{heroEntry.data.title}</h1>
            {heroEntry.data.subtitle && <p class="dst-hero-card-sub">{heroEntry.data.subtitle}</p>}
          </div>
          <span class="dst-hero-card-cta-btn">Leggi</span>
        </div>
      </div>
      <div class="dst-hero-card-strip">
        <div class="dst-hero-strip-desc">{heroEntry.data.excerpt}</div>
        <div class="dst-hero-strip-foot">
          <span class="dst-hero-strip-label">{heroEntry.data.region || heroEntry.data.category || 'Reportage'}</span>
        </div>
      </div>
    </a>
  </div>
)}

{/* FALLBACK */}
{!grouped && !heroEntry && (
  <div class="dst-hero">
    <div class="dst-hero-overlay"></div>
    <div class="dst-hero-content">
      <div class="dst-hero-tag">{eyebrow}</div>
      <h1 class="dst-hero-title">{title}</h1>
      <p class="dst-hero-sub">{description}</p>
      {backLink && <a href="/libreria" class="dst-hero-back-plain">← Tutta la libreria</a>}
    </div>
  </div>
)}

{/* FILTRI CONTINENTE — pagine filtrate */}
{!grouped && (
  <div class="dst-filters-bar">
    <a href="/libreria" class={`dst-filter-btn ${isAllActive ? 'active' : ''}`}>Tutti</a>
    {continenti.map((c) => {
      const cSlug = slugify(c);
      const active = currentContinent === cSlug;
      return (
        <a href={`/libreria/continente/${cSlug}`} class={`dst-filter-btn ${active ? 'active' : ''}`}>{c}</a>
      );
    })}
  </div>
)}

{/* GRIGLIA FLAT — pagine filtrate */}
{!grouped && (
  gridItems.length === 0 ? (
    <div class="dst-empty">
      <p>Nessun articolo qui per ora. Torna fra qualche giorno.</p>
    </div>
  ) : (
    <div class="dst-grid">
      {gridItems.map((entry) => (
        <a href={`/libreria/${entry.slug}`} class="dst-card">
          <div class="dst-card-img">
            <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} />
            <div class="dst-card-img-ov"></div>
            <div class="dst-card-img-title">
              <div class="dst-card-area">{entry.data.country}{entry.data.continent ? ` · ${entry.data.continent}` : ''}</div>
              <div class="dst-card-name">{entry.data.title}</div>
            </div>
          </div>
          <div class="dst-card-body">
            <div class="dst-card-desc">{entry.data.excerpt}</div>
            <div class="dst-card-foot">
              <span class="dst-card-label">{entry.data.category || entry.data.region || 'Reportage'}</span>
              <span class="dst-card-cta">Leggi</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  )
)}

<style>
/* ═══════════════════════════════
   NETFLIX HERO
═══════════════════════════════ */
.nx-hero {
  position: sticky;
  top: 60px; /* altezza esatta della navbar */
  z-index: 20;
  width: 100%;
  height: 52vh;
  min-height: 340px;
  overflow: hidden;
  background: #0E0C0A;
}
.nx-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: opacity 0.55s ease;
}
.nx-layer-a { z-index: 1; opacity: 0; }
.nx-layer-b { z-index: 2; opacity: 0; }
.nx-layer-a.is-active { opacity: 1; z-index: 2; }
.nx-layer-b.is-active { opacity: 1; z-index: 2; }

.nx-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  background:
    linear-gradient(to right, rgba(14,12,10,0.85) 0%, rgba(14,12,10,0.4) 50%, rgba(14,12,10,0.05) 100%),
    linear-gradient(to top, rgba(14,12,10,0.7) 0%, rgba(14,12,10,0.0) 40%);
}
.nx-hero-bottom-fade {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 50%;
  z-index: 4;
  background: linear-gradient(to bottom, rgba(14,12,10,0) 0%, rgba(14,12,10,0.85) 70%, rgba(14,12,10,1) 100%);
}
.nx-hero-content {
  position: absolute;
  bottom: 60px;
  left: 60px;
  z-index: 5;
  max-width: 540px;
}
.nx-hero-cat {
  display: block;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--terra, #C4855A);
  margin-bottom: 14px;
}
.nx-hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(42px, 5vw, 72px);
  font-weight: 300;
  color: #FAFAF8;
  line-height: 1.0;
  margin-bottom: 16px;
  letter-spacing: -0.01em;
  transition: opacity 0.3s ease;
}
.nx-hero-excerpt {
  font-size: 14px;
  font-weight: 300;
  color: rgba(250,250,248,0.65);
  line-height: 1.7;
  margin-bottom: 28px;
  transition: opacity 0.3s ease;
}
.nx-hero-btn {
  display: inline-block;
  background: rgba(250,250,248,0.12);
  border: 1px solid rgba(250,250,248,0.45);
  color: #FAFAF8;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 13px 28px;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
}
.nx-hero-btn:hover {
  background: rgba(250,250,248,0.22);
  border-color: rgba(250,250,248,0.85);
}

/* ═══════════════════════════════
   RIGHE CATEGORIE
═══════════════════════════════ */
.nx-rows {
  background: #0E0C0A;
  padding: 40px 0 80px;
  position: relative;
  z-index: 1;
}
.nx-row {
  margin-bottom: 48px;
}
.nx-row-header {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 0 60px;
  margin-bottom: 16px;
}
.nx-row-label {
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(250,250,248,0.55);
  white-space: nowrap;
}
.nx-row-line {
  flex: 1;
  height: 1px;
  background: rgba(201,185,154,0.1);
}
.nx-row-track-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.nx-row-track {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
  padding: 8px 60px 16px;
  flex: 1;
}
.nx-row-track::-webkit-scrollbar { display: none; }

/* ═══════════════════════════════
   CARD NETFLIX
═══════════════════════════════ */
.nx-card {
  position: relative;
  flex-shrink: 0;
  width: 280px;
  height: 180px;
  overflow: hidden;
  cursor: pointer;
  text-decoration: none;
  display: block;
  border-radius: 2px;
  transition: transform 0.3s ease, z-index 0s;
}
.nx-card:hover {
  transform: scale(1.08);
  z-index: 10;
}
.nx-card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
/* Info sempre visibili in basso */
.nx-card-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 32px 14px 12px;
  background: linear-gradient(to top, rgba(14,12,10,0.92) 0%, rgba(14,12,10,0.0) 100%);
  z-index: 2;
}
.nx-card-info-cat {
  font-size: 7px;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--terra, #C4855A);
  margin-bottom: 4px;
  display: block;
}
.nx-card-info-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 15px;
  font-weight: 300;
  color: #FAFAF8;
  line-height: 1.2;
}
/* CTA compare solo all'hover */
.nx-card-hover {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 14px 12px;
  opacity: 0;
  transition: opacity 0.25s ease;
}
.nx-card:hover .nx-card-hover {
  opacity: 1;
}
.nx-card-hover-cta {
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(250,250,248,0.8);
}

/* ═══════════════════════════════
   FRECCE
═══════════════════════════════ */
.nx-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  background: rgba(14,12,10,0.7);
  border: 1px solid rgba(201,185,154,0.15);
  color: rgba(250,250,248,0.6);
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s, color 0.2s;
  backdrop-filter: blur(4px);
}
.nx-arrow:hover { background: rgba(14,12,10,0.92); color: #FAFAF8; }
.nx-arrow-prev { left: 12px; }
.nx-arrow-next { right: 12px; }

/* ═══════════════════════════════
   VISTA FILTRATA (invariata)
═══════════════════════════════ */
.dst-hero-wrap { position: relative; }
.dst-hero-topbar { background: var(--dark); border-bottom: 1px solid rgba(201,185,154,0.1); }
.dst-hero-back { display: inline-flex; align-items: center; gap: 10px; padding: 16px 40px; font-size: 9px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(250,250,248,0.45); text-decoration: none; transition: color 0.2s; }
.dst-hero-back::before { content: '←'; font-size: 13px; }
.dst-hero-back:hover { color: var(--terra); }
.dst-hero-card { display: block; text-decoration: none; color: inherit; }
.dst-hero-card-photo { position: relative; height: 520px; overflow: hidden; }
.dst-hero-card-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
.dst-hero-card:hover .dst-hero-card-bg { transform: scale(1.03); }
.dst-hero-card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.78) 0%, rgba(26,24,20,0.28) 55%, rgba(26,24,20,0.1) 100%); }
.dst-hero-card-top { position: absolute; top: 0; left: 0; right: 0; padding: 28px 40px; z-index: 2; }
.dst-hero-card-archive { font-size: 9px; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sand); display: inline-flex; align-items: center; gap: 10px; }
.dst-hero-card-archive::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--terra); }
.dst-hero-card-bottom { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 40px 36px; z-index: 2; display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 32px; }
.dst-hero-card-text { flex: 1; }
.dst-hero-card-geo { font-size: 9px; font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(250,250,248,0.5); margin-bottom: 10px; }
.dst-hero-card-title { font-family: 'Cormorant Garamond', serif; font-size: 62px; font-weight: 300; color: #FAFAF8; line-height: 1.0; margin-bottom: 10px; letter-spacing: 0.01em; }
.dst-hero-card-sub { font-size: 15px; font-weight: 300; color: rgba(250,250,248,0.72); line-height: 1.55; }
.dst-hero-card-cta-btn { flex-shrink: 0; display: inline-block; border: 1px solid rgba(250,250,248,0.55); color: #FAFAF8; font-size: 9px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; padding: 13px 22px; white-space: nowrap; align-self: flex-end; margin-bottom: 6px; transition: background 0.25s ease, border-color 0.25s ease; }
.dst-hero-card:hover .dst-hero-card-cta-btn { background: rgba(250,250,248,0.1); border-color: rgba(250,250,248,0.9); }
.dst-hero-card-strip { background: var(--cream); border: 1px solid var(--light-border); border-top: none; padding: 18px 40px 20px; }
.dst-hero-strip-desc { font-size: 13px; font-weight: 300; color: var(--muted); line-height: 1.65; margin-bottom: 14px; }
.dst-hero-strip-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid var(--light-border); }
.dst-hero-strip-label { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
.dst-hero-classic { background: var(--dark); padding: 80px 40px 64px; border-bottom: 1px solid rgba(201,185,154,0.12); }
.dst-hero-classic-content { max-width: 760px; }
.dst-hero { position: relative; width: 100%; min-height: 280px; background: var(--dark); padding: 56px 40px 48px; overflow: hidden; }
.dst-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(26,24,20,0.94) 0%, rgba(26,24,20,0.7) 60%, rgba(26,24,20,0.5) 100%); z-index: 1; }
.dst-hero-content { position: relative; z-index: 2; max-width: 720px; }
.dst-hero-tag { font-size: 9px; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sand); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
.dst-hero-tag::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--terra); }
.dst-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 52px; font-weight: 300; color: #FAFAF8; line-height: 1.0; margin-bottom: 14px; }
.dst-hero-sub { font-size: 13px; font-weight: 300; color: rgba(250,250,248,0.65); line-height: 1.72; max-width: 520px; }
.dst-hero-back-plain { display: inline-block; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--terra); text-decoration: none; margin-top: 18px; }
.dst-filters-bar { padding: 16px 40px; background: var(--dark); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.dst-filter-btn { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; padding: 7px 14px; border: 1px solid rgba(250,250,248,0.15); border-radius: 2px; color: rgba(250,250,248,0.45); background: transparent; text-decoration: none; transition: all 0.2s; cursor: pointer; }
.dst-filter-btn:hover { border-color: var(--terra); color: var(--sand); }
.dst-filter-btn.active { background: rgba(250,250,248,0.08); color: #FAFAF8; border-color: rgba(250,250,248,0.35); }
.dst-grid { padding: 40px 40px 60px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; background: var(--dark); }
.dst-empty { text-align: center; padding: 80px 40px; color: var(--muted); font-style: italic; background: var(--dark); }
.dst-card { border: 1px solid rgba(201,185,154,0.12); overflow: hidden; cursor: pointer; transition: border-color 0.2s; display: flex; flex-direction: column; text-decoration: none; color: inherit; background: #161310; }
.dst-card:hover { border-color: rgba(201,185,154,0.35); }
.dst-card-img { height: 220px; position: relative; overflow: hidden; }
.dst-card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.dst-card:hover .dst-card-img img { transform: scale(1.04); }
.dst-card-img-ov { position: absolute; inset: 0; background: linear-gradient(to top, rgba(14,12,10,0.7) 0%, transparent 55%); }
.dst-card-img-title { position: absolute; bottom: 0; left: 0; right: 0; padding: 14px 16px; }
.dst-card-area { font-size: 8px; font-weight: 300; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(250,250,248,0.55); margin-bottom: 4px; }
.dst-card-name { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 300; color: #FAFAF8; line-height: 1.2; }
.dst-card-body { padding: 16px 18px; display: flex; flex-direction: column; flex: 1; }
.dst-card-desc { font-size: 12px; font-weight: 300; color: rgba(250,250,248,0.45); line-height: 1.65; flex: 1; margin-bottom: 14px; }
.dst-card-foot { display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid rgba(201,185,154,0.1); margin-top: auto; }
.dst-card-label { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(250,250,248,0.35); }
.dst-card-cta { font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); }

/* ═══════════════════════════════
   RESPONSIVE
═══════════════════════════════ */
@media (max-width: 900px) {
  .nx-hero { height: 70vh; }
  .nx-hero-content { left: 28px; bottom: 80px; max-width: 85%; }
  .nx-row-header { padding: 0 24px; }
  .nx-row-track { padding: 8px 24px 16px; }
  .nx-arrow-prev { left: 2px; }
  .nx-arrow-next { right: 2px; }
  .nx-card { width: 220px; height: 140px; }
  .dst-grid { grid-template-columns: repeat(2, 1fr); padding: 24px 24px 32px; gap: 16px; }
  .dst-filters-bar { padding: 0 24px; overflow-x: auto; flex-wrap: nowrap; }
  .dst-hero-card-photo { height: 420px; }
  .dst-hero-card-title { font-size: 44px; }
  .dst-hero-card-bottom { padding: 28px 24px 32px; gap: 20px; }
  .dst-hero-card-top { padding: 20px 24px; }
  .dst-hero-back { padding: 14px 24px; }
  .dst-hero-card-strip { padding: 16px 24px 18px; }
}
@media (max-width: 600px) {
  .nx-hero { height: 65vh; min-height: 400px; }
  .nx-hero-title { font-size: 32px; }
  .nx-hero-excerpt { display: none; }
  .nx-card { width: 180px; height: 120px; }
  .nx-arrow { display: none; }
  .dst-grid { grid-template-columns: 1fr; }
  .dst-hero-card-photo { height: 360px; }
  .dst-hero-card-title { font-size: 34px; }
  .dst-hero-card-bottom { flex-direction: column; align-items: flex-start; gap: 16px; }
  .dst-hero-card-cta-btn { align-self: flex-start; }
}
</style>

<script>
(function () {
  function init() {
    const hero = document.getElementById('nx-hero');
    if (!hero) return;

    const layerA = document.getElementById('nx-layer-a') as HTMLImageElement | null;
    const layerB = document.getElementById('nx-layer-b') as HTMLImageElement | null;
    const heroTitle = document.getElementById('nx-hero-title');
    const heroExcerpt = document.getElementById('nx-hero-excerpt');
    const heroBtn = document.getElementById('nx-hero-btn') as HTMLAnchorElement | null;

    if (!layerA || !layerB) return;

    // Quale layer è attivo
    let activeLayer: 'a' | 'b' = 'a';
    let defaultSrc = layerA.src;
    let defaultTitle = heroTitle?.textContent ?? '';
    let defaultExcerpt = heroExcerpt?.textContent ?? '';
    let defaultHref = heroBtn?.href ?? '';
    let hoverTimeout: ReturnType<typeof setTimeout>;

    function crossfade(newSrc: string) {
      const incoming = activeLayer === 'a' ? layerB : layerA;
      const outgoing = activeLayer === 'a' ? layerA : layerB;

      if (!incoming || !outgoing) return;
      if (incoming.src === newSrc) return;

      incoming.src = newSrc;
      incoming.classList.add('is-active');
      outgoing.classList.remove('is-active');
      activeLayer = activeLayer === 'a' ? 'b' : 'a';
    }

    function updateText(title: string, excerpt: string, href: string) {
      if (heroTitle) heroTitle.textContent = title;
      if (heroExcerpt) heroExcerpt.textContent = excerpt;
      if (heroBtn) heroBtn.href = href;
    }

    // Attach listeners a tutte le card
    document.querySelectorAll<HTMLElement>('.nx-card').forEach(card => {
      const cover = card.dataset.cover ?? '';
      const title = card.dataset.title ?? '';
      const excerpt = card.dataset.excerpt ?? '';
      const href = card.dataset.href ?? '';

      card.addEventListener('mouseenter', () => {
        clearTimeout(hoverTimeout);
        crossfade(cover);
        updateText(title, excerpt, href);
      });

      card.addEventListener('mouseleave', () => {
        hoverTimeout = setTimeout(() => {
          crossfade(defaultSrc);
          updateText(defaultTitle, defaultExcerpt, defaultHref);
        }, 300);
      });
    });

    // Frecce scroll
    document.querySelectorAll<HTMLElement>('.nx-row-track-wrap').forEach(wrap => {
      const track = wrap.querySelector<HTMLElement>('.nx-row-track');
      const prev = wrap.querySelector<HTMLElement>('.nx-arrow-prev');
      const next = wrap.querySelector<HTMLElement>('.nx-arrow-next');
      if (!track) return;

      const scrollBy = 300;
      prev?.addEventListener('click', () => track.scrollBy({ left: -scrollBy, behavior: 'smooth' }));
      next?.addEventListener('click', () => track.scrollBy({ left: scrollBy, behavior: 'smooth' }));
    });
  }

  document.addEventListener('DOMContentLoaded', init);
  document.addEventListener('astro:page-load', init);
})();
</script>
