---
// Hero della homepage — manifesto editoriale di Unmarked.
// Senza CTA: la hero è dichiarazione di intenti, non vetrina di sezione.
// Il CTA naturale è scrollare verso le sezioni sottostanti.

export interface Props {
  tag?: string;
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  tag = 'Reportage · Fotografia · Itinerari',
  title = 'I luoghi che non trovi<br>sulle guide',
  subtitle = 'Unmarked racconta i posti che esistono ancora. Reportage fotografici, itinerari scritti da chi ci è stato davvero, storie che non seguono le stagioni turistiche.',
  ctaLabel,
  ctaHref,
} = Astro.props;
---

<div class="hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-tag">{tag}</div>
  <h1 class="hero-title" set:html={title}></h1>
  <p class="hero-sub">{subtitle}</p>

  {ctaLabel && ctaHref && (
    <div class="hero-bottom">
      <a href={ctaHref} class="btn-hero">{ctaLabel}</a>
    </div>
  )}
</div>
