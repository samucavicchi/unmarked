---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'itinerari'>[];
  continenti: string[];
  eyebrow: string;
  title: string;
  description: string;
  currentContinent?: string | null;
  currentPaese?: string | null;
  backLink?: boolean;
}

const {
  items,
  continenti,
  eyebrow,
  title,
  description,
  currentContinent = null,
  currentPaese = null,
  backLink = false,
} = Astro.props;

const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');

// "Tutti" attivo solo se NON siamo filtrati per continente/paese
const isAllActive = !currentContinent && !currentPaese;

// Interleave featured "nel mezzo" della griglia
type ItEntry = CollectionEntry<'itinerari'>;
const featured: ItEntry[] = items.filter((e) => e.data.featured);
const normali: ItEntry[] = items.filter((e) => !e.data.featured);
const ordered: ItEntry[] = [...normali];
featured.forEach((f, i) => {
  const total = ordered.length + 1;
  const pos = Math.floor((total * (i + 1)) / (featured.length + 1));
  ordered.splice(pos, 0, f);
});

const subscriberCount = items.length;
---

{/* HERO STRISCIA */}
<div class="iti-hero">
  <div class="iti-hero-overlay"></div>
  <div class="iti-hero-content">
    <div class="iti-hero-tag">{eyebrow}</div>
    <h1 class="iti-hero-title">{title}</h1>
    <p class="iti-hero-sub">{description}</p>
    {backLink && (
      <a href="/itinerari" class="iti-hero-back">← Tutti gli itinerari</a>
    )}
    <div class="iti-hero-banner">
      <div class="iti-hero-banner-text">Con l'abbonamento accedi a <strong>tutti gli itinerari</strong> — nuovi ogni mese. <strong>€29/mese</strong>, disdici quando vuoi.</div>
      <a href="/abbonati" class="iti-hero-banner-btn">Abbonati →</a>
    </div>
  </div>
</div>

{/* FILTRI */}
<div class="iti-filters-bar">
  <div class="iti-filters-left">
    <a href="/itinerari" class={`iti-filter-btn ${isAllActive ? 'active' : ''}`}>Tutti</a>
    {continenti.map((c) => {
      const cSlug = slugify(c);
      const active = currentContinent === cSlug;
      return (
        <a href={`/itinerari/continente/${cSlug}`} class={`iti-filter-btn ${active ? 'active' : ''}`}>{c}</a>
      );
    })}
  </div>
  <div class="iti-filters-right">
    <button class="iti-filter-tag" type="button" disabled>Durata ↕</button>
    <button class="iti-filter-tag" type="button" disabled>Budget ↕</button>
    <button class="iti-filter-tag" type="button" disabled>Difficoltà ↕</button>
  </div>
</div>

{/* GRIGLIA */}
{ordered.length === 0 ? (
  <div class="iti-empty">
    <p>Nessun itinerario qui per ora. Torna fra qualche giorno.</p>
  </div>
) : (
  <div class="iti-grid">
    {ordered.map((entry) => {
      const isFeat = entry.data.featured;
      return (
        <a href={`/itinerari/${entry.slug}`} class={`iti-card ${isFeat ? 'iti-card-feat' : ''}`}>
          <div class="iti-card-img">
            <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} />
            <div class="iti-card-img-ov"></div>
            <div class="iti-card-badges">
              <span class="iti-badge iti-badge-prem">Premium</span>
              <span class="iti-badge iti-badge-dur">{entry.data.duration} giorni</span>
              {isFeat && <span class="iti-badge iti-badge-feat">In evidenza</span>}
            </div>
            <div class="iti-card-img-title">
              <div class="iti-card-area">{entry.data.country} · {entry.data.continent}</div>
              <div class="iti-card-name">{entry.data.title}</div>
            </div>
          </div>
          <div class="iti-card-body">
            <div class="iti-card-desc">{entry.data.excerpt}</div>
            <div class="iti-card-meta">
              <div class="iti-card-meta-item"><div class="iti-card-meta-val">{entry.data.duration}</div><div class="iti-card-meta-label">Giorni</div></div>
              <div class="iti-card-meta-item"><div class="iti-card-meta-val">{entry.data.budget}</div><div class="iti-card-meta-label">Budget</div></div>
              <div class="iti-card-meta-item"><div class="iti-card-meta-val">{entry.data.difficulty}</div><div class="iti-card-meta-label">Difficoltà</div></div>
            </div>
            <div class="iti-card-foot">
              <span class="iti-card-price">€{entry.data.price}</span>
              <span class="iti-card-cta">Vedi itinerario →</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
)}

{/* STRIP ABBONAMENTO */}
<div class="iti-sub-strip">
  <div class="iti-sub-strip-left">
    <div class="iti-sub-strip-label">Abbonamento Unmarked</div>
    <div class="iti-sub-strip-title">Accedi a tutti gli itinerari</div>
    <div class="iti-sub-strip-sub">{subscriberCount} itinerari disponibili ora · nuovi ogni mese · disdici quando vuoi.</div>
  </div>
  <div class="iti-sub-strip-right">
    <div>
      <div class="iti-sub-strip-price">€29</div>
      <div class="iti-sub-strip-period">al mese</div>
    </div>
    <a href="/abbonati" class="iti-sub-strip-btn">Abbonati ora →</a>
  </div>
</div>

<style>
  .iti-hero { position: relative; width: 100%; min-height: 320px; background: var(--dark); padding: 56px 40px 48px; overflow: hidden; }
  .iti-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(26,24,20,0.94) 0%, rgba(26,24,20,0.7) 60%, rgba(26,24,20,0.5) 100%); z-index: 1; }
  .iti-hero-content { position: relative; z-index: 2; max-width: 720px; }
  .iti-hero-tag { font-size: 9px; font-weight: 300; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sand); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .iti-hero-tag::before { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--terra); }
  .iti-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 52px; font-weight: 300; color: #FAFAF8; line-height: 1.0; margin-bottom: 14px; }
  .iti-hero-sub { font-size: 13px; font-weight: 300; color: rgba(250,250,248,0.65); line-height: 1.72; max-width: 520px; margin-bottom: 20px; }
  .iti-hero-back { display: inline-block; font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--terra); text-decoration: none; margin-bottom: 22px; }
  .iti-hero-back:hover { text-decoration: underline; }
  .iti-hero-banner { display: flex; align-items: center; justify-content: space-between; gap: 20px; background: rgba(250,250,248,0.04); border: 1px solid rgba(201,185,154,0.18); border-radius: 3px; padding: 14px 20px; max-width: 620px; }
  .iti-hero-banner-text { font-size: 12px; font-weight: 300; color: rgba(250,250,248,0.6); line-height: 1.55; }
  .iti-hero-banner-text strong { color: var(--sand); font-weight: 400; }
  .iti-hero-banner-btn { font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; background: var(--terra); color: #fff; padding: 9px 18px; border-radius: 2px; text-decoration: none; white-space: nowrap; flex-shrink: 0; }

  .iti-filters-bar { padding: 20px 40px; border-bottom: 1px solid var(--light-border); display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .iti-filters-left { display: flex; gap: 8px; flex-wrap: wrap; }
  .iti-filter-btn { font-size: 9px; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase; padding: 7px 14px; border: 1px solid var(--light-border); border-radius: 2px; color: var(--muted); background: transparent; text-decoration: none; transition: all 0.2s; }
  .iti-filter-btn:hover { border-color: var(--terra); color: var(--terra); }
  .iti-filter-btn.active { background: var(--dark); color: #FAFAF8; border-color: var(--dark); }
  .iti-filters-right { display: flex; gap: 8px; flex-shrink: 0; }
  .iti-filter-tag { font-size: 9px; font-weight: 300; letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 12px; border: 1px solid var(--light-border); border-radius: 2px; color: var(--muted); background: transparent; font-family: 'Inter', sans-serif; opacity: 0.55; cursor: not-allowed; }

  .iti-grid { padding: 40px 40px 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .iti-empty { text-align: center; padding: 80px 40px; color: var(--muted); font-style: italic; }

  .iti-card { border: 1px solid var(--light-border); border-radius: 3px; overflow: hidden; cursor: pointer; transition: border-color 0.2s, transform 0.2s; display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--cream); }
  .iti-card:hover { border-color: var(--sand); }
  .iti-card-feat {
    background: var(--terra);
    border-color: var(--terra);
  }
  .iti-card-feat:hover { border-color: var(--terra); box-shadow: 0 8px 28px rgba(196,133,90,0.3); }
  .iti-card-feat .iti-card-desc { color: rgba(255,255,255,0.75); }
  .iti-card-feat .iti-card-meta { border-color: rgba(255,255,255,0.2); }
  .iti-card-feat .iti-card-meta-item { border-color: rgba(255,255,255,0.2); }
  .iti-card-feat .iti-card-meta-val { color: #fff; }
  .iti-card-feat .iti-card-meta-label { color: rgba(255,255,255,0.55); }
  .iti-card-feat .iti-card-foot { border-color: rgba(255,255,255,0.2); }
  .iti-card-feat .iti-card-price { color: #fff; }
  .iti-card-feat .iti-card-cta { color: rgba(255,255,255,0.9); }
  .iti-card-feat .iti-badge-feat { background: rgba(255,255,255,0.25); color: #fff; }

  .iti-card-img { height: 220px; position: relative; overflow: hidden; }
  .iti-card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .iti-card:hover .iti-card-img img { transform: scale(1.04); }
  .iti-card-img-ov { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.6) 0%, transparent 55%); }
  .iti-card-badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
  .iti-badge { font-size: 8px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; padding: 3px 8px; border-radius: 2px; }
  .iti-badge-prem { background: var(--dark); color: var(--sand); }
  .iti-badge-dur { background: rgba(26,24,20,0.5); color: var(--sand); }
  .iti-badge-feat { background: var(--terra); color: #fff; }
  .iti-card-img-title { position: absolute; bottom: 0; left: 0; right: 0; padding: 14px 16px; }
  .iti-card-area { font-size: 8px; font-weight: 300; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(250,250,248,0.55); margin-bottom: 4px; }
  .iti-card-name { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 300; color: #FAFAF8; line-height: 1.2; }
  .iti-card-body { padding: 16px 18px; display: flex; flex-direction: column; flex: 1; }
  .iti-card-desc { font-size: 12px; font-weight: 300; color: var(--muted); line-height: 1.65; margin-bottom: 14px; }
  .iti-card-meta { display: flex; gap: 0; border-top: 1px solid var(--light-border); padding-top: 12px; }
  .iti-card-meta-item { flex: 1; text-align: center; border-right: 1px solid var(--light-border); padding: 0 8px; }
  .iti-card-meta-item:last-child { border-right: none; }
  .iti-card-meta-val { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 300; color: var(--dark); line-height: 1; margin-bottom: 2px; }
  .iti-card-meta-label { font-size: 8px; font-weight: 300; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .iti-card-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--light-border); }
  .iti-card-price { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 300; color: var(--dark); }
  .iti-card-cta { font-size: 9px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); }

  .iti-sub-strip { margin: 48px 40px 60px; background: var(--dark); border-radius: 3px; padding: 28px 32px; display: flex; justify-content: space-between; align-items: center; gap: 32px; }
  .iti-sub-strip-label { font-size: 9px; font-weight: 300; letter-spacing: 0.22em; text-transform: uppercase; color: var(--sand); margin-bottom: 6px; }
  .iti-sub-strip-title { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 300; color: #FAFAF8; margin-bottom: 6px; }
  .iti-sub-strip-sub { font-size: 12px; font-weight: 300; color: rgba(250,250,248,0.45); }
  .iti-sub-strip-right { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
  .iti-sub-strip-price { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 300; color: #FAFAF8; line-height: 1; }
  .iti-sub-strip-period { font-size: 10px; font-weight: 300; color: rgba(250,250,248,0.45); }
  .iti-sub-strip-btn { font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; background: var(--terra); color: #fff; padding: 12px 24px; border-radius: 2px; text-decoration: none; white-space: nowrap; }

  @media (max-width: 900px) {
    .iti-hero { padding: 40px 24px 32px; min-height: 280px; }
    .iti-hero-title { font-size: 40px; }
    .iti-grid { grid-template-columns: repeat(2, 1fr); padding: 32px 24px 0; gap: 20px; }
    .iti-filters-bar { padding: 16px 24px; }
    .iti-sub-strip { margin: 32px 24px 40px; flex-direction: column; align-items: flex-start; padding: 24px; }
    .iti-hero-banner { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 600px) {
    .iti-grid { grid-template-columns: 1fr; }
    .iti-hero-title { font-size: 34px; }
  }
</style>
