<!-- Mini player audio nativo — persiste tra le pagine con View Transitions -->
<div id="pod-mini-player" class="pod-mini" aria-hidden="true" transition:persist>
  <div class="pod-mini-inner">
    <div class="pod-mini-info">
      <div class="pod-mini-label">In ascolto</div>
      <div id="pod-mini-title" class="pod-mini-title"></div>
    </div>
    <audio id="pod-mini-audio" class="pod-mini-audio" controls preload="none"></audio>
    <button id="pod-mini-close" class="pod-mini-close" aria-label="Chiudi player">✕</button>
  </div>
</div>

<script is:inline>
  (function () {
    // Audio vive in window — mai toccato dal DOM swap
    if (!window.__podAudio) window.__podAudio = new Audio();
    const audio = window.__podAudio;

    function syncUI() {
      const player  = document.getElementById('pod-mini-player');
      const titleEl = document.getElementById('pod-mini-title');
      const domAudio = document.getElementById('pod-mini-audio');
      if (!player) return;
      // Sincronizza UI con stato corrente
      if (window.__podTitle) titleEl.textContent = window.__podTitle;
      if (!audio.paused) {
        player.classList.add('open');
        player.setAttribute('aria-hidden', 'false');
      }
      // L'elemento <audio> nel DOM non viene usato per la riproduzione
      // ma lo nascondiacmo per evitare duplicati
      if (domAudio) domAudio.style.display = 'none';
    }

    function bindControls() {
      const closeBtn = document.getElementById('pod-mini-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          audio.pause();
          const player = document.getElementById('pod-mini-player');
          if (player) {
            player.classList.remove('open');
            player.setAttribute('aria-hidden', 'true');
          }
          window.__podTitle = '';
        });
      }

      // Sostituisci l'elemento <audio> del DOM con una barra di controllo custom
      const player = document.getElementById('pod-mini-player');
      const embed  = player?.querySelector('.pod-mini-embed');
      if (embed && !embed.querySelector('.pod-ctrl')) {
        embed.innerHTML = `
          <div class="pod-ctrl">
            <button class="pod-ctrl-btn" id="pod-play-pause">⏸</button>
            <input class="pod-ctrl-seek" id="pod-seek" type="range" min="0" max="100" value="0" step="0.1" />
            <span class="pod-ctrl-time" id="pod-time">0:00</span>
          </div>`;

        const playPause = document.getElementById('pod-play-pause');
        const seek      = document.getElementById('pod-seek');
        const timeEl    = document.getElementById('pod-time');

        playPause?.addEventListener('click', function () {
          if (audio.paused) { audio.play().catch(() => {}); playPause.textContent = '⏸'; }
          else { audio.pause(); playPause.textContent = '▶'; }
        });

        seek?.addEventListener('input', function () {
          if (audio.duration) audio.currentTime = (seek.value / 100) * audio.duration;
        });

        audio.addEventListener('timeupdate', function () {
          if (!audio.duration) return;
          if (seek) seek.value = (audio.currentTime / audio.duration) * 100;
          if (timeEl) {
            const m = Math.floor(audio.currentTime / 60);
            const s = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
            timeEl.textContent = `${m}:${s}`;
          }
        });

        audio.addEventListener('ended', function () {
          if (playPause) playPause.textContent = '▶';
        });
      }
    }

    function openPlayer(audioUrl, title) {
      window.__podTitle = title;
      if (audio.src !== audioUrl) {
        audio.src = audioUrl;
        audio.load();
      }
      audio.play().catch(() => {});
      const player  = document.getElementById('pod-mini-player');
      const titleEl = document.getElementById('pod-mini-title');
      if (player) { player.classList.add('open'); player.setAttribute('aria-hidden', 'false'); }
      if (titleEl) titleEl.textContent = title;
    }

    // Dopo ogni navigazione: risincronizza UI senza toccare l'audio
    document.addEventListener('astro:page-load', function () {
      syncUI();
      bindControls();
    });

    // Prima carica
    syncUI();
    bindControls();

    document.addEventListener('play-podcast', function (e) {
      openPlayer(e.detail.audioUrl, e.detail.title);
    });
  })();
</script>

<style>
  .pod-mini {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3000;
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--dark);
    border-top: 1px solid rgba(201,185,154,0.15);
    box-shadow: 0 -8px 32px rgba(26,24,20,0.3);
  }
  .pod-mini.open { transform: translateY(0); }

  .pod-mini-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 14px 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .pod-mini-info {
    flex-shrink: 0;
    min-width: 0;
    max-width: 200px;
  }
  .pod-mini-label {
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 4px;
  }
  .pod-mini-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-weight: 300;
    color: #FAFAF8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pod-mini-audio { display: none; }
  .pod-mini-embed { flex: 1; min-width: 0; }
  .pod-ctrl { display: flex; align-items: center; gap: 12px; }
  .pod-ctrl-btn { background: none; border: 1px solid rgba(250,250,248,0.3); color: #FAFAF8; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: border-color 0.2s; }
  .pod-ctrl-btn:hover { border-color: var(--terra); }
  .pod-ctrl-seek { flex: 1; height: 3px; accent-color: var(--terra); cursor: pointer; }
  .pod-ctrl-time { font-size: 11px; color: rgba(250,250,248,0.5); flex-shrink: 0; font-variant-numeric: tabular-nums; }

  .pod-mini-close {
    background: none;
    border: none;
    color: rgba(250,250,248,0.4);
    font-size: 14px;
    cursor: pointer;
    padding: 8px;
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .pod-mini-close:hover { color: #FAFAF8; }

  @media (max-width: 600px) {
    .pod-mini-inner { flex-wrap: wrap; gap: 10px; padding: 12px 16px 16px; }
    .pod-mini-info { max-width: 100%; width: 100%; }
    .pod-mini-audio { width: 100%; }
    .pod-mini-close { position: absolute; top: 10px; right: 12px; }
  }
</style>
