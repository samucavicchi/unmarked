---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ItinerariArchive from '../../../components/ItinerariArchive.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tutti = await getCollection('itinerari');
  const paesi = [...new Set(tutti.map((e) => e.data.country))];
  return paesi.map((paese) => ({
    params: { paese: paese.toLowerCase().replace(/\s+/g, '-') },
    props: {
      paese,
      entries: tutti
        .filter((e) => e.data.country === paese)
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
      allContinenti: [...new Set(tutti.map((e) => e.data.continent))].sort(),
    },
  }));
}

const { paese, entries, allContinenti } = Astro.props;
const slugify = (s) => s.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout
  title={`Itinerari ${paese} — Unmarked`}
  description={`Itinerari in ${paese} — guide complete giorno per giorno.`}
>
  <ItinerariArchive
    items={entries}
    continenti={allContinenti}
    eyebrow="Itinerari · Paese"
    title={paese}
    description={`${entries.length} ${entries.length === 1 ? 'itinerario' : 'itinerari'} in ${paese}.`}
    currentPaese={slugify(paese)}
    backLink={true}
  />
</BaseLayout>
