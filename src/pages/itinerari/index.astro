---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItinerariArchive from '../../components/ItinerariArchive.astro';
import { getCollection } from 'astro:content';

const tutti = (await getCollection('itinerari')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const continenti = [...new Set(tutti.map((e) => e.data.continent))].sort();
---

<BaseLayout
  title="Itinerari — Unmarked"
  description="Guide complete giorno per giorno. Contatti locali verificati, mappe offline, budget reali. Quello che i blog non dicono mai."
>
  <ItinerariArchive
    items={tutti}
    continenti={continenti}
    eyebrow="Archivio"
    title="Itinerari"
    description="Guide complete, giorno per giorno. Contatti locali verificati, mappe offline, budget reali. Quello che i blog non dicono mai."
  />
</BaseLayout>
