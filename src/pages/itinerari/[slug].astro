---
// SSR: verifica auth server-side ad ogni richiesta
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const { slug } = Astro.params;
const entry = await getEntry('itinerari', slug!);

if (!entry) {
  return Astro.redirect('/404');
}

const { data } = entry;

// ── Auth Clerk ─────────────────────────────────────────────────────────────
let currentUser: Awaited<ReturnType<typeof Astro.locals.currentUser>> = null;
try {
  currentUser = await Astro.locals.currentUser();
} catch (clerkErr) {
  console.error('[slug] Clerk currentUser() failed:', clerkErr);
}

const userIsPremium: boolean = !!(
  (currentUser?.publicMetadata?.isPremium) ||
  ((currentUser?.publicMetadata?.purchasedItinerari as string[] | undefined)?.includes(entry.slug))
);

// ── Logica giorni (paywall ignorato se utente premium) ─────────────────────
const days = (data.days || []).slice().sort((a, b) => a.dayNumber - b.dayNumber);
const firstPremiumIdx = userIsPremium ? -1 : days.findIndex((d) => d.isPremium);
const freeDays = firstPremiumIdx === -1 ? days : days.slice(0, firstPremiumIdx);
const premiumDays = firstPremiumIdx === -1 ? [] : days.slice(firstPremiumIdx);

// Stripe checkout via /api/checkout
const checkoutUrl = '#checkout';

const updatedDate = data.publishDate.toLocaleDateString('it-IT', { month: 'short', year: 'numeric' });

// Map markers: solo giorni free (o tutti se utente premium)
const mapPoints = days.map((d) => {
  if (!userIsPremium && d.isPremium) return null; // nascondi punti premium agli utenti non paganti
  const m = (data.mapMarkers || []).find((mm: any) => mm.dayNumber === d.dayNumber);
  if (!m) return null;
  return {
    num: d.dayNumber,
    title: d.title,
    sub: (d.description || '').split('\n')[0].slice(0, 90),
    locked: false,
    lat: m.lat,
    lng: m.lng,
  };
}).filter(Boolean);

const hasMap = !!data.mapCenter && mapPoints.length > 0;

// Step B: "Vale il viaggio" strutturato (3 colonne con primo item free + paywall sui restanti)
const vale = data.vale || null;
// Rileva se l'utente arriva dal checkout (webhook potrebbe non essere ancora arrivato)
const upgraded = Astro.url.searchParams.get('upgraded') === '1';

const valeCols = vale ? [
  { key: 'dormire', label: 'Dormire', items: vale.dormire || [] },
  { key: 'mangiare', label: 'Mangiare', items: vale.mangiare || [] },
  { key: 'tappe', label: 'Non perdere', items: vale.tappe || [] },
] : [];
const valeHasPaywall = valeCols.some((c) => c.items.length > 1);
const badgeLabels: Record<string, string> = {
  must: 'Top pick',
  good: 'Da provare',
  hidden: 'Hidden gem',
};

// Step B: "Mainstream check" strutturato
const ms = data.mainstream || null;
const msFreeItems = ms ? (ms.items || []).slice(0, 1) : [];
const msPremiumItems = ms ? (ms.items || []).slice(1) : [];

// Galleria itinerario
const gallery = data.gallery || [];
---

<BaseLayout
  title={`${data.title} — Itinerario — Unmarked`}
  description={data.excerpt}
  ogImage={data.coverImage.src}
>
  {hasMap && (
    <link
      slot="head"
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  )}

  <header class="it-hero">
    <img src={data.coverImage.src} alt={data.coverImageAlt} class="it-hero-bg" id="it-hero-bg" />
    <div class="it-hero-overlay"></div>
    <div class="it-hero-content">
      <div class="it-hero-tag">
        <a href="/itinerari" class="it-hero-tag-link">Itinerari</a>
        <span>·</span>
        <span>{data.country}</span>
        <span>·</span>
        <span>{data.continent}</span>
      </div>
      <h1 class="it-title">{data.title}</h1>
      {data.subtitle && <p class="it-subtitle">{data.subtitle}</p>}
    </div>
  </header>

  <div class="it-apertura">
    <div class="it-meta-row">
      <div class="it-meta-item"><div class="it-meta-val">{data.duration}</div><div class="it-meta-label">Giorni</div></div>
      <div class="it-meta-item"><div class="it-meta-val">{data.budget}</div><div class="it-meta-label">Budget</div></div>
      <div class="it-meta-item"><div class="it-meta-val">{data.difficulty}</div><div class="it-meta-label">Difficoltà</div></div>
      <div class="it-meta-item"><div class="it-meta-val">{data.bestSeason}</div><div class="it-meta-label">Periodo</div></div>
      <div class="it-meta-item"><div class="it-meta-val">{data.transport}</div><div class="it-meta-label">Trasporto</div></div>
    </div>
  </div>

  {upgraded && !userIsPremium && (
    <div id="upgrade-banner" style="background:var(--dark);color:#FAFAF8;text-align:center;padding:16px 20px;font-size:13px;">
      ⏳ Acquisto in verifica — la pagina si aggiornerà tra pochi secondi...
      <script is:inline>setTimeout(() => location.reload(), 4000);</script>
    </div>
  )}

  <div class="it-body">
    <div class="it-text">
      {data.valeIlViaggio && <p class="it-intro">{data.valeIlViaggio}</p>}
      {vale?.intro && <p class="it-intro">{vale.intro}</p>}

      {freeDays.length > 0 && <div class="preview-badge">Anteprima gratuita — {freeDays.length === 1 ? 'giorno 1' : `giorni 1–${freeDays.length}`}</div>}

      <div class="it-section-label">Programma giornaliero</div>

      <div class="it-days">
        {freeDays.map((day) => (
          <div class="it-day">
            <div class="it-day-num">{String(day.dayNumber).padStart(2, '0')}</div>
            <div class="it-day-content">
              <div class="it-day-title">{day.title}</div>
              <div class="it-day-sub" set:html={(day.description || '').replace(/\n/g, '<br>')}></div>
              <div class="it-day-tags">
                {day.kmTotali && <div class="it-day-tag">{day.kmTotali} km</div>}
                {day.dislivello && <div class="it-day-tag">{day.dislivello}</div>}
                {day.dormire && <div class="it-day-tag">Dormi: {day.dormire}</div>}
                {day.mangiare && <div class="it-day-tag">Mangi: {day.mangiare}</div>}
              </div>
              {day.gallery && day.gallery.length > 0 && (
                <>
                  <div class="day-gallery-toggle">
                    <span class="day-gallery-toggle-icon">+</span>
                    <span>{day.gallery.length} {day.gallery.length === 1 ? 'foto' : 'foto'}</span>
                  </div>
                  <div class="day-gallery">
                    {day.gallery.map((g: any) => (
                      <div class="day-gallery-img" data-caption={g.caption || ''}>
                        <img src={g.image.src} alt={g.caption || ''} />
                      </div>
                    ))}
                    {day.gallery[0]?.caption && (
                      <div class="day-gallery-caption-row">{day.gallery.map((g: any) => g.caption).filter(Boolean).join(' · ')}</div>
                    )}
                  </div>
                </>
              )}
            </div>
          </div>
        ))}
      </div>

      {premiumDays.length > 0 && (
        <div class="paywall-wrap">
          <div class="paywall-blur-content">
            <div class="it-days">
              {premiumDays.map((day) => (
                <div class="it-day">
                  <div class="it-day-num">{String(day.dayNumber).padStart(2, '0')}</div>
                  <div class="it-day-content">
                    <div class="it-day-title">{day.title}</div>
                    <div class="it-day-sub" set:html={(day.description || '').replace(/\n/g, '<br>')}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="paywall-overlay"></div>

          <div class="paywall-box">
            <div class="pw-icon">⌛</div>
            <div class="pw-title">Sblocca l'itinerario completo</div>
            <div class="pw-sub">{premiumDays.length} giorni dettagliati, mappe offline, dove dormire, dove mangiare, contatti locali verificati e aggiornamenti stagionali inclusi.</div>

            <div class="pw-options">
              <div class="pw-opt">
                <div class="pw-opt-label">Solo questo</div>
                <div class="pw-opt-price">€{data.price}</div>
                <div class="pw-opt-period">acquisto unico</div>
                <div class="pw-opt-desc">Accesso permanente a questo itinerario</div>
              </div>
              <div class="pw-opt featured">
                <div class="pw-opt-label">Tutto illimitato</div>
                <div class="pw-opt-price">€29</div>
                <div class="pw-opt-period">al mese</div>
                <div class="pw-opt-desc">Tutti gli itinerari + nuovi ogni mese</div>
              </div>
            </div>

            <button class="pw-btn-sub" data-checkout="subscription">Abbonati — €29/mese</button>
            <button class="pw-btn-single" data-checkout="single">Acquista solo questo — €{data.price}</button>
            <div class="pw-login">Hai già un account? <a href="/sign-in">Accedi</a></div>
          </div>
        </div>
      )}
    </div>

    <div class="it-sidebar">
      {!userIsPremium && (
      <div class="price-box">
        <div class="price-box-title">Sblocca l'itinerario</div>
        <div class="price-main">
          <div class="price-amount">€{data.price}</div>
          <div class="price-period">acquisto unico</div>
        </div>
        <div class="price-or">oppure</div>
        <div class="price-sub-opt">
          <span class="price-sub-label">Con abbonamento</span>
          <span class="price-sub-val">€29/mese</span>
        </div>
        <div class="price-includes">
          <div class="price-item"><div class="price-dot"></div><div>{data.duration} giorni dettagliati giorno per giorno</div></div>
          <div class="price-item"><div class="price-dot"></div><div>Mappa offline scaricabile</div></div>
          <div class="price-item"><div class="price-dot"></div><div>Dove dormire e dove mangiare</div></div>
          <div class="price-item"><div class="price-dot"></div><div>Contatti locali verificati</div></div>
          <div class="price-item"><div class="price-dot"></div><div>Aggiornamenti stagionali inclusi</div></div>
        </div>
        <button class="btn-buy" data-checkout="single">Acquista — €{data.price}</button>
        <button class="btn-sub-sidebar" data-checkout="subscription">Abbonati e accedi a tutto</button>
        <div class="price-already">Sei abbonato? <a href="/sign-in">Accedi</a></div>
      </div>
      )}

      <div class="info-box">
        <div class="info-box-title">Scheda</div>
        <div class="info-item"><span class="info-label">Destinazione</span><span class="info-val">{data.country}</span></div>
        <div class="info-item"><span class="info-label">Durata</span><span class="info-val">{data.duration} giorni</span></div>
        <div class="info-item"><span class="info-label">Budget</span><span class="info-val">{data.budget}</span></div>
        <div class="info-item"><span class="info-label">Periodo</span><span class="info-val">{data.bestSeason}</span></div>
        <div class="info-item"><span class="info-label">Difficoltà</span><span class="info-val">{data.difficulty}</span></div>
        <div class="info-item"><span class="info-label">Trasporto</span><span class="info-val">{data.transport}</span></div>
        <div class="info-item"><span class="info-label">Aggiornato</span><span class="info-val">{updatedDate}</span></div>
      </div>
    </div>
  </div>

  {/* Step B: Vale il viaggio (strutturato) */}
  {vale && valeCols.some((c) => c.items.length > 0) && (
    <div class="vale">
      <div class="vale-head">
        <div class="vale-title">Vale il viaggio</div>
        <div class="vale-sub">Strutture e posti selezionati di persona — non sponsorizzati</div>
      </div>

      <div class="vale-grid">
        {valeCols.map((col) => (
          <div>
            <div class="vale-col-label">{col.label}</div>
            {(userIsPremium ? col.items : col.items.slice(0, 1)).map((it: any) => (
              <div class="vale-item">
                <div class="vale-item-header">
                  <div class="vale-item-name">{it.name}</div>
                  <div class={`vale-item-badge badge-${it.badge || 'must'}`}>{badgeLabels[it.badge] || badgeLabels.must}</div>
                </div>
                {it.location && <div class="vale-item-loc">{it.location}</div>}
                <div class="vale-item-desc">{it.description}</div>
                {it.tip && <div class="vale-item-tip">{it.tip}</div>}
                {it.price && <div class="vale-item-price" set:html={it.price.replace(/(€\d[\d.,]*|Da €\d[\d.,]*\/[^\s,]+|Circa €\d[\d.,]*[^\s,]*|\d+€\/[^\s,]+|gratuito|libero)/i, '<strong>$1</strong>')}></div>}
              </div>
            ))}
          </div>
        ))}
      </div>

      {!userIsPremium && valeHasPaywall && (
        <div class="vale-paywall-wrap">
          <div class="vale-blur">
            <div class="vale-grid">
              {valeCols.map((col) => (
                <div>
                  {col.items.slice(1).map((it: any) => (
                    <div class="vale-item">
                      <div class="vale-item-header">
                        <div class="vale-item-name">{it.name}</div>
                        <div class={`vale-item-badge badge-${it.badge || 'must'}`}>{badgeLabels[it.badge] || badgeLabels.must}</div>
                      </div>
                      {it.location && <div class="vale-item-loc">{it.location}</div>}
                      <div class="vale-item-desc">{it.description}</div>
                      {it.tip && <div class="vale-item-tip">{it.tip}</div>}
                      {it.price && <div class="vale-item-price">{it.price}</div>}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="vale-overlay"></div>
          <div class="vale-pw-box">
            <div class="vale-pw-title">Altri consigli riservati agli abbonati</div>
            <div class="vale-pw-sub">Dove dormire davvero, dove mangiare senza finire in trappola turistica e cosa non perdere per nessun motivo.</div>
            <button class="vale-pw-btn-sub" data-checkout="subscription">Abbonati — €29/mese</button>
            <button class="vale-pw-btn-single" data-checkout="single">Acquista questo itinerario — €{data.price}</button>
            <div class="vale-pw-login">Hai già un account? <a href="/sign-in">Accedi</a></div>
          </div>
        </div>
      )}
    </div>
  )}

  {/* Step B: Mainstream check (strutturato) */}
  {(ms || data.mainstreamCheck) && (
    <div class="ms">
      <div class="ms-head">
        <div class="ms-title">Mainstream check</div>
        <div class="ms-sub">Cosa <em>non</em> visiterai e perché</div>
      </div>
      {ms?.intro && <p class="ms-intro">{ms.intro}</p>}
      {!ms && data.mainstreamCheck && <p class="ms-intro">{data.mainstreamCheck}</p>}

      {ms && (userIsPremium ? ms.items : msFreeItems).length > 0 && (
        <div class="ms-list">
          {(userIsPremium ? ms.items : msFreeItems).map((it: any) => (
            <div class="ms-item">
              <div class="ms-item-grid">
                <div class="ms-item-info">
                  <div class="ms-item-head">
                    <div class="ms-item-name">{it.name}</div>
                    {it.type && <div class="ms-item-type">{it.type}</div>}
                  </div>
                  <div class="ms-item-rating">
                    {Array.from({ length: 5 }, (_, i) => (
                      <span class={`ms-star ${i < it.rating ? 'ms-star-filled' : ''}`}>★</span>
                    ))}
                    <span class="ms-rating-num">{it.rating}/5</span>
                  </div>
                  <div class="ms-item-verdict">{it.verdict}</div>
                  {it.alternative && (
                    <div class="ms-item-alt">
                      <div class="ms-item-alt-label">Alternativa Unmarked</div>
                      <div class="ms-item-alt-name">{it.alternative.name}</div>
                      <div class="ms-item-alt-reason">{it.alternative.reason}</div>
                    </div>
                  )}
                </div>
                {it.distance && <div class="ms-item-distance">{it.distance}</div>}
              </div>
            </div>
          ))}
        </div>
      )}

      {!userIsPremium && ms && msPremiumItems.length > 0 && (
        <div class="ms-paywall-wrap">
          <div class="ms-blur">
            <div class="ms-list">
              {msPremiumItems.map((it: any) => (
                <div class="ms-item">
                  <div class="ms-item-grid">
                    <div class="ms-item-info">
                      <div class="ms-item-head">
                        <div class="ms-item-name">{it.name}</div>
                        {it.type && <div class="ms-item-type">{it.type}</div>}
                      </div>
                      <div class="ms-item-rating">
                        {Array.from({ length: 5 }, (_, i) => (
                          <span class={`ms-star ${i < it.rating ? 'ms-star-filled' : ''}`}>★</span>
                        ))}
                        <span class="ms-rating-num">{it.rating}/5</span>
                      </div>
                      <div class="ms-item-verdict">{it.verdict}</div>
                      {it.alternative && (
                        <div class="ms-item-alt">
                          <div class="ms-item-alt-label">Alternativa Unmarked</div>
                          <div class="ms-item-alt-name">{it.alternative.name}</div>
                          <div class="ms-item-alt-reason">{it.alternative.reason}</div>
                        </div>
                      )}
                    </div>
                    {it.distance && <div class="ms-item-distance">{it.distance}</div>}
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="vale-overlay"></div>
          <div class="vale-pw-box">
            <div class="vale-pw-title">Altri mainstream check riservati agli abbonati</div>
            <div class="vale-pw-sub">Cosa NON visiterai, e cosa vedere al suo posto.</div>
            <button class="vale-pw-btn-sub" data-checkout="subscription">Abbonati — €29/mese</button>
            <button class="vale-pw-btn-single" data-checkout="single">Acquista questo itinerario — €{data.price}</button>
            <div class="vale-pw-login">Hai già un account? <a href="/sign-in">Accedi</a></div>
          </div>
        </div>
      )}
    </div>
  )}

  {hasMap && (
    <div class="it-map">
      <div class="it-map-label">Mappa dell'itinerario</div>
      <div
        id="it-map"
        class="it-map-container"
        data-center={JSON.stringify(data.mapCenter)}
        data-points={JSON.stringify(mapPoints)}
      ></div>
      <div class="it-map-caption">I punti sbloccati mostrano il percorso completo · Giorni premium disponibili con l'acquisto</div>
      {userIsPremium && data.mapMarkers?.length > 0 && (
        <a href={`/itinerari/${entry.slug}.kml`} download class="kml-download-btn">
          ↓ Scarica mappa per Google Maps / GPS
        </a>
      )}
    </div>
  )}

  {/* Step B: Galleria itinerario (sotto la mappa) */}
  {gallery.length > 0 && (
    <div class="it-gallery">
      <div class="it-gallery-label">Fotografie dall'itinerario</div>
      <div class="it-gallery-grid">
        {gallery.map((g: any) => (
          <div class={`gal-item ${g.wide ? 'wide' : ''}`} data-caption={g.caption || ''}>
            <img src={g.image.src} alt={g.caption || ''} />
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="consulenza-strip">
    <div class="consulenza-strip-left">
      <div class="consulenza-strip-icon">✦</div>
      <div class="consulenza-strip-text">
        <div class="consulenza-strip-title">Vuoi un itinerario costruito su misura?</div>
        <div class="consulenza-strip-sub">Una consulenza con noi per il tuo viaggio specifico.</div>
      </div>
    </div>
    <a href="/consulenze" class="consulenza-strip-cta">Scopri →</a>
  </div>

  {/* Lightbox per gallerie */}
  <div class="lightbox" id="lightbox">
    <div class="lightbox-close" id="lb-close">✕</div>
    <img class="lightbox-img" id="lb-img" src="" alt="" />
    <div class="lightbox-caption" id="lb-caption"></div>
  </div>

  <script is:inline>
    // Toggle gallerie giorno
    document.querySelectorAll('.day-gallery-toggle').forEach(function(btn){
      btn.addEventListener('click', function(){
        var gallery = btn.nextElementSibling;
        btn.classList.toggle('open');
        if (gallery) gallery.classList.toggle('open');
      });
    });

    // Lightbox: click su qualsiasi foto in galleria
    var lb = document.getElementById('lightbox');
    var lbImg = document.getElementById('lb-img');
    var lbCap = document.getElementById('lb-caption');
    function openLb(src, caption){
      if (!lb || !lbImg) return;
      lbImg.src = src;
      if (lbCap) lbCap.textContent = caption || '';
      lb.classList.add('open');
    }
    function closeLb(){ if (lb) lb.classList.remove('open'); }
    document.querySelectorAll('.day-gallery-img, .gal-item').forEach(function(el){
      el.addEventListener('click', function(e){
        e.stopPropagation();
        var img = el.querySelector('img');
        if (img) openLb(img.src, el.dataset.caption || img.alt || '');
      });
    });
    if (lb) lb.addEventListener('click', closeLb);
    var close = document.getElementById('lb-close');
    if (close) close.addEventListener('click', function(e){ e.stopPropagation(); closeLb(); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeLb(); });
  </script>

  {/* Banner acquisto completato */}
  <div class="upgrade-banner" id="upgrade-banner" style="display:none">
    <div class="upgrade-banner-inner">
      <div class="upgrade-banner-icon">✓</div>
      <div>
        <div class="upgrade-banner-title">Acquisto completato!</div>
        <div class="upgrade-banner-sub">Ricarica la pagina se alcuni contenuti non sono ancora visibili.</div>
      </div>
      <button class="upgrade-banner-close" onclick="this.closest('#upgrade-banner').style.display='none'">✕</button>
    </div>
  </div>

  {/* Script Stripe checkout */}
  <script is:inline define:vars={{ itSlug: entry.slug, itPrice: data.price, itTitle: data.title, userIsLoggedIn: !!currentUser }}>
    if (new URLSearchParams(window.location.search).get('upgraded') === '1') {
      var banner = document.getElementById('upgrade-banner');
      if (banner) banner.style.display = 'block';
      window.history.replaceState({}, '', window.location.pathname);
    }

    async function startCheckout(type) {
      // Se non loggato, manda al login con redirect back all'itinerario
      if (!userIsLoggedIn) {
        window.location.href = '/sign-in?redirect_url=' + encodeURIComponent(window.location.pathname);
        return;
      }
      var allBtns = document.querySelectorAll('[data-checkout]');
      allBtns.forEach(function(b){ b.disabled = true; b.style.opacity = '0.6'; });
      try {
        var res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: type, slug: itSlug, price: itPrice, title: itTitle }),
        });
        var json = await res.json();
        if (json.url) {
          window.location.href = json.url;
        } else {
          alert('Errore nel checkout: ' + (json.error || 'risposta inattesa'));
        }
      } catch (err) {
        alert('Errore di rete. Riprova.');
      } finally {
        allBtns.forEach(function(b){ b.disabled = false; b.style.opacity = ''; });
      }
    }

    document.querySelectorAll('[data-checkout]').forEach(function(btn) {
      btn.addEventListener('click', function() { startCheckout(btn.dataset.checkout); });
    });
  </script>


  {hasMap && (
    <>
      <script
        is:inline
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""
      ></script>
      <script is:inline>
        function initItMap() {
          var el = document.getElementById('it-map');
          if (!el) return;
          if (typeof L === 'undefined') { setTimeout(initItMap, 50); return; }
          var center = JSON.parse(el.dataset.center);
          var points = JSON.parse(el.dataset.points || '[]');
          var map = L.map('it-map', { center: [center.lat, center.lng], zoom: center.zoom || 9, scrollWheelZoom: false });
          L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '© OpenStreetMap contributors © CARTO',
            maxZoom: 18
          }).addTo(map);
          var coordsAll = points.map(function(p){ return [p.lat, p.lng]; });
          var coordsFree = points.filter(function(p){ return !p.locked; }).map(function(p){ return [p.lat, p.lng]; });
          if (coordsAll.length > 1) {
            L.polyline(coordsAll, { color: '#C9B99A', weight: 1.5, opacity: 0.4, dashArray: '6, 8' }).addTo(map);
          }
          if (coordsFree.length > 1) {
            L.polyline(coordsFree, { color: '#C4855A', weight: 2, opacity: 0.8 }).addTo(map);
          }
          points.forEach(function(p){
            var icon = L.divIcon({
              className: '',
              html: '<div class="map-marker ' + (p.locked ? 'locked' : '') + '">' + (p.locked ? '🔒' : p.num) + '</div>',
              iconSize: [28, 28],
              iconAnchor: [14, 14],
              popupAnchor: [0, -16]
            });
            var popup = p.locked
              ? '<div class="popup-day">Giorno ' + p.num + '</div><div class="popup-title">' + p.title + '</div><div class="popup-locked">🔒 Disponibile con l\'acquisto</div>'
              : '<div class="popup-day">Giorno ' + p.num + '</div><div class="popup-title">' + p.title + '</div><div class="popup-sub">' + p.sub + '</div>';
            L.marker([p.lat, p.lng], { icon: icon }).addTo(map).bindPopup(popup);
          });
        }
        if (document.readyState !== 'loading') initItMap();
        else window.addEventListener('load', initItMap);
      </script>
    </>
  )}

  <script is:inline>
    (function() {
      var bg = document.querySelector('.it-hero-bg');
      var hero = document.querySelector('.it-hero');
      if (!bg || !hero) return;
      function onScroll() {
        var rect = hero.getBoundingClientRect();
        if (rect.bottom < 0) return;
        var y = -rect.top * 0.22;
        bg.style.transform = 'scale(1.06) translateY(' + y + 'px)';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
