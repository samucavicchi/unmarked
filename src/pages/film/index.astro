---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const tutti = (await getCollection('film')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Film di viaggio — Unmarked"
  description="Documentari, cortometraggi e reportage video dai posti che non trovi sulle guide."
>
  <section>
    <div class="archive-head">
      <div class="archive-eyebrow">Film · Documentari · Reportage video</div>
      <h1 class="archive-title">Film di viaggio</h1>
      <p class="archive-sub">
        Storie raccontate in immagini in movimento. Tre settimane in una valle del Tian Shan,
        un'estate dietro un branco di renne, un fine settimana in un villaggio dimenticato.
      </p>
    </div>

    {tutti.length === 0 && (
      <div class="archive-empty">
        <p>I primi film stanno per uscire. Torna fra qualche giorno.</p>
      </div>
    )}

    <div class="film-stack pb60">
      {tutti.map((entry) => {
        const data = entry.data;
        const dateLabel = data.publishDate.toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
        const href = `/film/${entry.slug}`;
        return (
          <a href={href} class="film-wide">
            <div class="film-wide-img">
              <img src={data.coverImage.src} alt={data.coverImageAlt} loading="lazy" />
              <div class="film-wide-ov"></div>
              <div class="film-wide-play"><div class="film-wide-play-icon"></div></div>
              <div class="film-wide-content">
                <div class="film-wide-tag">{data.country} · {data.continent} · {data.type}</div>
                <h2 class="film-wide-title">{data.title}</h2>
                {data.subtitle && <p class="film-wide-subtitle">{data.subtitle}</p>}
                <div class="film-wide-meta">{data.duration} min · {dateLabel}</div>
              </div>
            </div>
            {data.excerpt && <p class="film-wide-desc">{data.excerpt}</p>}
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .archive-head {
    padding: 60px 0 40px;
    border-bottom: 1px solid var(--light-border);
    margin-bottom: 40px;
  }
  .archive-eyebrow {
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 16px;
  }
  .archive-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 300;
    line-height: 1.0;
    color: var(--dark);
    margin-bottom: 18px;
    letter-spacing: 0.01em;
  }
  .archive-sub {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 540px;
  }
  .archive-empty {
    text-align: center;
    padding: 80px 40px;
    color: var(--muted);
    font-style: italic;
  }

  .film-stack {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .film-wide {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .film-wide-img {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: 3px;
    background: var(--dark);
    transition: transform 0.3s;
  }
  .film-wide:hover .film-wide-img {
    transform: scale(1.005);
  }
  .film-wide-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-wide-ov {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,24,20,0.85) 0%, rgba(26,24,20,0.25) 50%, rgba(26,24,20,0.05) 100%);
  }
  .film-wide-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 24, 20, 0.4);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .film-wide:hover .film-wide-play {
    background: rgba(196, 133, 90, 0.85);
    border-color: var(--terra);
    transform: translate(-50%, -50%) scale(1.05);
  }
  .film-wide-play-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 12px 0 12px 22px;
    border-color: transparent transparent transparent #fff;
    margin-left: 5px;
  }
  .film-wide-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 32px 40px;
    color: #FAFAF8;
  }
  .film-wide-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--sand);
    margin-bottom: 10px;
  }
  .film-wide-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 42px;
    font-weight: 300;
    line-height: 1.1;
    color: #FAFAF8;
    margin: 0 0 8px;
    letter-spacing: 0.01em;
    max-width: 800px;
  }
  .film-wide-subtitle {
    font-size: 14px;
    color: rgba(250, 250, 248, 0.75);
    line-height: 1.5;
    margin-bottom: 10px;
    max-width: 600px;
  }
  .film-wide-meta {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.55);
  }
  .film-wide-desc {
    font-size: 13px;
    line-height: 1.72;
    color: var(--muted);
    margin-top: 18px;
    max-width: 800px;
  }

  @media (max-width: 700px) {
    .film-wide-content { padding: 20px; }
    .film-wide-title { font-size: 28px; }
    .film-wide-play { width: 60px; height: 60px; }
    .film-wide-play-icon { border-width: 9px 0 9px 16px; }
    .film-stack { gap: 36px; }
  }
</style>
