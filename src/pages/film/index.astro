---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilmCard from '../../components/FilmCard.astro';
import { getCollection } from 'astro:content';

const tutti = (await getCollection('film')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featured = tutti.find((e) => e.data.featured) || tutti[0];
const altri = tutti.filter((e) => e.slug !== featured?.slug);
---

<BaseLayout
  title="Film di viaggio — Unmarked"
  description="Documentari, cortometraggi e reportage video dai posti che non trovi sulle guide."
>
  <section>
    <div class="archive-head">
      <div class="archive-eyebrow">Film · Documentari · Reportage video</div>
      <h1 class="archive-title">Film di viaggio</h1>
      <p class="archive-sub">
        Storie raccontate in immagini in movimento. Tre settimane in una valle del Tian Shan,
        un'estate dietro un branco di renne, un fine settimana in un villaggio dimenticato.
      </p>
    </div>

    {tutti.length === 0 && (
      <div class="archive-empty">
        <p>I primi film stanno per uscire. Torna fra qualche giorno.</p>
      </div>
    )}

    {featured && (
      <div class="film-grid pb60">
        <FilmCard entry={featured} variant="main" />
        <div class="film-list">
          {altri.slice(0, 4).map((entry) => <FilmCard entry={entry} variant="episode" />)}
        </div>
      </div>
    )}

    {altri.length > 4 && (
      <div class="film-cards-grid pb60">
        {altri.slice(4).map((entry) => <FilmCard entry={entry} variant="grid" />)}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .archive-head {
    padding: 60px 0 40px;
    border-bottom: 1px solid var(--light-border);
    margin-bottom: 40px;
  }
  .archive-eyebrow {
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 16px;
  }
  .archive-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 300;
    line-height: 1.0;
    color: var(--dark);
    margin-bottom: 18px;
    letter-spacing: 0.01em;
  }
  .archive-sub {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 540px;
  }
  .archive-empty {
    text-align: center;
    padding: 80px 40px;
    color: var(--muted);
    font-style: italic;
  }
  .film-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }
  @media (max-width: 900px) {
    .film-cards-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .film-cards-grid { grid-template-columns: 1fr; }
  }
</style>
