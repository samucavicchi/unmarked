---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shopProducts } from '../../data/shop-data';
import Stripe from 'stripe';

export async function getStaticPaths() {
  const stripe = import.meta.env.STRIPE_SECRET_KEY
    ? new Stripe(import.meta.env.STRIPE_SECRET_KEY as string, { apiVersion: '2024-11-20.acacia' })
    : null;

  return Promise.all(
    shopProducts.filter(p => p.available).map(async (p) => {
      let images: string[] = [p.image];
      if (stripe && p.stripeProductId && !p.stripeProductId.startsWith('prod_xxx')) {
        try {
          const sp = await stripe.products.retrieve(p.stripeProductId);
          if (sp.images && sp.images.length > 0) images = sp.images;
        } catch (_) {}
      }
      return { params: { id: p.id }, props: { product: p, allImages: images } };
    })
  );
}

const { product, allImages } = Astro.props;
const isDigital = product.type === 'digital';
const otherProducts = shopProducts.filter(p => p.available && p.id !== product.id).slice(0, 3);
const hasGallery = allImages.length > 1;
---

<BaseLayout
  title={`${product.title} — Unmarked Shop`}
  description={product.description}
>

  <div class="pd-wrap">

    <!-- BREADCRUMB -->
    <div class="pd-breadcrumb">
      <a href="/shop">Shop</a>
      <span>→</span>
      <span>{product.title}</span>
    </div>

    <!-- PRODOTTO -->
    <div class="pd-main">

      <!-- IMMAGINE + GALLERIA -->
      <div class="pd-gallery">
        <div class="pd-img-wrap">
          <div class="pd-img" id="pd-main-img" style={`background-image: url('${allImages[0]}')`}></div>
          {product.badge && <div class="pd-badge">{product.badge}</div>}
        </div>
        {hasGallery && (
          <div class="pd-thumbs">
            {allImages.map((src, i) => (
              <button
                class={`pd-thumb${i === 0 ? ' active' : ''}`}
                data-src={src}
                aria-label={`Immagine ${i + 1}`}
              >
                <div class="pd-thumb-img" style={`background-image: url('${src}')`}></div>
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- DETTAGLI -->
      <div class="pd-info">
        <div class="pd-type">
          {isDigital ? (
            <span class="pd-type-tag pd-type-digital">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v10m0 0l-3-3m3 3l3-3"/><path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"/></svg>
              Digitale — download immediato
            </span>
          ) : (
            <span class="pd-type-tag pd-type-physical">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l-1.5 9H6.5L5 8z"/><path d="M3 5h2.5l1.5 3M16 5h2.5L21 8"/><circle cx="9" cy="20" r="1"/><circle cx="15" cy="20" r="1"/></svg>
              Fisico — spedizione inclusa
            </span>
          )}
        </div>

        <div class="pd-sub">{product.subtitle}</div>
        <h1 class="pd-title">{product.title}</h1>

        {product.fullDescription && (
          <p class="pd-desc">{product.fullDescription}</p>
        )}

        {product.details && product.details.length > 0 && (
          <ul class="pd-details">
            {product.details.map(d => (
              <li class="pd-detail-item">
                <span class="pd-detail-dot"></span>
                {d}
              </li>
            ))}
          </ul>
        )}

        {product.variants && product.variants.length > 0 && (
          <div class="pd-variants">
            <div class="pd-variants-label">Formato</div>
            <div class="pd-variants-grid">
              {product.variants.map((v, i) => (
                <button
                  class={`pd-variant-btn${i === 0 ? ' active' : ''}`}
                  data-price={v.price}
                  data-price-id={v.stripePriceId}
                >
                  <span class="pd-variant-label">{v.label}</span>
                  {v.size && <span class="pd-variant-size">{v.size}</span>}
                  <span class="pd-variant-price">€{v.price}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <div class="pd-buy">
          <div class="pd-price" id="pd-price">€{product.price}</div>
          <button
            class="pd-buy-btn"
            id="buy-btn"
            data-product-id={product.id}
            data-price-id={product.variants ? product.variants[0].stripePriceId : product.stripePriceId}
          >
            {isDigital ? 'Acquista e scarica' : 'Acquista'}
          </button>
        </div>

        {!isDigital && (
          <p class="pd-shipping-note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            Spedito in tutta Europa. L'indirizzo viene raccolto al checkout.
          </p>
        )}
      </div>

    </div>

    <!-- ALTRI PRODOTTI -->
    {otherProducts.length > 0 && (
      <div class="pd-others">
        <div class="pd-others-label">Altri prodotti</div>
        <div class="pd-others-grid">
          {otherProducts.map(p => (
            <a href={`/shop/${p.id}`} class="pd-other-card">
              <div class="pd-other-img" style={`background-image: url('${p.image}')`}></div>
              <div class="pd-other-info">
                <div class="pd-other-sub">{p.subtitle}</div>
                <div class="pd-other-title">{p.title}</div>
                <div class="pd-other-price">€{p.price}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>

</BaseLayout>

<script is:inline>
  // Galleria immagini
  document.querySelectorAll('.pd-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var src = thumb.dataset.src;
      var main = document.getElementById('pd-main-img');
      if (main && src) {
        main.style.opacity = '0';
        setTimeout(function() {
          main.style.backgroundImage = "url('" + src + "')";
          main.style.opacity = '1';
        }, 180);
      }
      document.querySelectorAll('.pd-thumb').forEach(function(t) { t.classList.remove('active'); });
      thumb.classList.add('active');
    });
  });

  // Selezione variante (formato stampa)
  document.querySelectorAll('.pd-variant-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.pd-variant-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var price = btn.dataset.price;
      var priceId = btn.dataset.priceId;
      var priceEl = document.getElementById('pd-price');
      var buyBtn = document.getElementById('buy-btn');
      if (priceEl && price) priceEl.textContent = '€' + price;
      if (buyBtn && priceId) buyBtn.dataset.priceId = priceId;
    });
  });

  // Checkout
  document.getElementById('buy-btn')?.addEventListener('click', async function() {
    var btn = document.getElementById('buy-btn');
    var productId = btn.dataset.productId;
    var variantPriceId = btn.dataset.priceId || null;
    var label = btn.textContent;
    btn.textContent = '...';
    btn.disabled = true;
    try {
      var res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'shop', productId, variantPriceId }),
      });
      var data = await res.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Errore durante il checkout. Riprova.');
        btn.textContent = label;
        btn.disabled = false;
      }
    } catch(e) {
      alert('Errore di rete. Riprova.');
      btn.textContent = label;
      btn.disabled = false;
    }
  });
</script>

<style>
  .pd-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 40px 100px;
  }

  /* BREADCRUMB */
  .pd-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 48px;
  }
  .pd-breadcrumb a { color: var(--terra); text-decoration: none; }
  .pd-breadcrumb a:hover { text-decoration: underline; }

  /* LAYOUT PRINCIPALE */
  .pd-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-bottom: 80px;
    padding-bottom: 80px;
    border-bottom: 1px solid rgba(201,185,154,0.15);
  }

  /* GALLERIA */
  .pd-gallery { display: flex; flex-direction: column; gap: 8px; }
  .pd-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(201,185,154,0.08);
  }
  .pd-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: opacity 0.18s ease;
  }
  .pd-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--terra);
    color: #fff;
    padding: 5px 12px;
    z-index: 1;
  }
  .pd-thumbs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pd-thumb {
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid transparent;
    background: none;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.2s;
    overflow: hidden;
  }
  .pd-thumb:hover { border-color: rgba(201,185,154,0.5); }
  .pd-thumb.active { border-color: var(--terra); }
  .pd-thumb-img {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  /* INFO */
  .pd-type { margin-bottom: 20px; }
  .pd-type-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 6px 12px;
    border: 1px solid rgba(201,185,154,0.3);
    color: var(--muted);
  }
  .pd-sub {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 10px;
  }
  .pd-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 24px;
  }
  .pd-desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 28px;
  }

  /* DETAILS */
  .pd-details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 36px;
    padding: 24px;
    background: rgba(201,185,154,0.06);
    border-left: 2px solid rgba(201,185,154,0.3);
  }
  .pd-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1.5;
  }
  .pd-detail-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--terra);
    flex-shrink: 0;
    margin-top: 6px;
  }

  /* VARIANTI */
  .pd-variants { margin-bottom: 28px; }
  .pd-variants-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .pd-variants-grid { display: flex; gap: 8px; flex-wrap: wrap; }
  .pd-variant-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 14px 20px;
    border: 1px solid rgba(201,185,154,0.3);
    background: none;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    min-width: 80px;
  }
  .pd-variant-btn:hover { border-color: var(--terra); }
  .pd-variant-btn.active {
    border-color: var(--terra);
    background: rgba(196,133,90,0.06);
  }
  .pd-variant-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1;
  }
  .pd-variant-size {
    font-size: 9px;
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .pd-variant-price {
    font-size: 11px;
    font-weight: 500;
    color: var(--terra);
    margin-top: 4px;
    letter-spacing: 0.06em;
  }

  /* BUY */
  .pd-buy {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 16px;
  }
  .pd-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 44px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1;
  }
  .pd-buy-btn {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    background: var(--dark);
    color: #FAFAF8;
    border: none;
    padding: 16px 40px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .pd-buy-btn:hover { background: var(--terra); }
  .pd-buy-btn:disabled { opacity: 0.5; cursor: default; }

  .pd-shipping-note {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 300;
    color: rgba(138,126,106,0.7);
  }

  /* ALTRI PRODOTTI */
  .pd-others-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terra);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }
  .pd-others-label::before { content: ''; width: 24px; height: 1px; background: var(--terra); display: block; }
  .pd-others-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .pd-other-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(201,185,154,0.15);
    transition: border-color 0.2s;
  }
  .pd-other-card:hover { border-color: var(--terra); }
  .pd-other-img {
    aspect-ratio: 3/2;
    background-size: cover;
    background-position: center;
    background-color: rgba(201,185,154,0.08);
  }
  .pd-other-info { padding: 16px 18px; }
  .pd-other-sub {
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 4px;
  }
  .pd-other-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 300;
    color: var(--dark);
    margin-bottom: 6px;
  }
  .pd-other-price {
    font-size: 12px;
    font-weight: 300;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .pd-wrap { padding: 24px 20px 80px; }
    .pd-main { grid-template-columns: 1fr; gap: 32px; }
    .pd-title { font-size: 38px; }
    .pd-price { font-size: 36px; }
    .pd-buy { flex-direction: column; align-items: flex-start; gap: 16px; }
    .pd-buy-btn { width: 100%; text-align: center; }
    .pd-others-grid { grid-template-columns: 1fr; }
  }
</style>
