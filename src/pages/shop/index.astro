---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shopProducts } from '../../data/shop-data';
import fs from 'fs';
import path from 'path';

const available = shopProducts.filter(p => p.available);
const digital = available.filter(p => p.type === 'digital');
const physical = available.filter(p => p.type === 'physical');

const digitalTags = ['preset', 'lut', 'sfx', 'flare'] as const;
const physicalTags = ['maps', 'prints', 'gear'] as const;

// Ricava automaticamente l'ultima immagine della cartella come hover image
function getHoverImage(product: typeof shopProducts[0]): string | undefined {
  if (product.hoverImage) return product.hoverImage; // override manuale
  const dir = path.join(process.cwd(), 'public', 'shop', product.id);
  if (!fs.existsSync(dir)) return undefined;
  const files = fs.readdirSync(dir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .sort();
  if (files.length <= 1) return undefined;
  return `/shop/${product.id}/${files[files.length - 1]}`;
}
---

<BaseLayout
  title="Shop — Unmarked"
  description="Preset fotografici, stampe fine art e oggetti Unmarked. Fatti sul campo, pensati per chi ci vive."
>

  <!-- HERO -->
  <section class="sh-hero">
    <div class="sh-hero-inner">
      <div class="sh-label">Unmarked · Shop</div>
      <h1 class="sh-title">Fatti sul<br/>campo.</h1>
      <p class="sh-sub">Preset calibrati sul campo, stampe fine art in edizione limitata e oggetti pensati per chi viaggia con una macchina fotografica.</p>
    </div>
    <div class="sh-hero-deco" aria-hidden="true">S</div>
  </section>

  <!-- FISICI -->
  {physical.length > 0 && (
    <section class="sh-section" data-section="physical">
      <div class="sh-section-head">
        <div class="sh-section-label">Fisico</div>
        <span class="sh-section-count">{physical.length} {physical.length === 1 ? 'prodotto' : 'prodotti'}</span>
        <div class="sh-section-line"></div>
        <span class="sh-section-note">Spedito in tutta Europa</span>
      </div>

      <div class="sh-filters" data-filter-group="physical">
        <button class="sh-filter active" data-filter="all">Tutti</button>
        {physicalTags.map(tag => {
          const hasProducts = physical.some(p => p.tag === tag);
          return (
            <button
              class={`sh-filter${!hasProducts ? ' sh-filter-empty' : ''}`}
              data-filter={tag}
            >{tag}</button>
          );
        })}
      </div>

      <div class="sh-grid sh-grid-physical" data-grid="physical">
        {physical.map(product => (
          <a href={`/shop/${product.id}`} class="sh-card sh-card-physical" data-tag={product.tag}>
            <div class="sh-card-img-wrap">
              <div class="sh-card-img" style={`background-image: url('${product.image}')`}></div>
              {getHoverImage(product) && <div class="sh-card-img-hover" style={`background-image: url('${getHoverImage(product)}')`}></div>}
              {product.badge && <div class="sh-badge">{product.badge}</div>}
              <div class="sh-card-overlay">
                <span class="sh-overlay-cta">Scopri →</span>
              </div>
            </div>
            <div class="sh-card-body">
              <div class="sh-card-top">
                <div>
                  <div class="sh-card-sub">{product.subtitle}</div>
                  <h2 class="sh-card-title">{product.title}</h2>
                </div>
                <div class="sh-price">€{product.price}</div>
              </div>
              <p class="sh-card-desc">{product.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- DIGITALI -->
  {digital.length > 0 && (
    <section class="sh-section" data-section="digital">
      <div class="sh-section-head">
        <div class="sh-section-label">Digitale</div>
        <span class="sh-section-count">{digital.length} {digital.length === 1 ? 'prodotto' : 'prodotti'}</span>
        <div class="sh-section-line"></div>
        <span class="sh-section-note">Download immediato</span>
      </div>

      <div class="sh-filters" data-filter-group="digital">
        <button class="sh-filter active" data-filter="all">Tutti</button>
        {digitalTags.map(tag => {
          const hasProducts = digital.some(p => p.tag === tag);
          return (
            <button
              class={`sh-filter${!hasProducts ? ' sh-filter-empty' : ''}`}
              data-filter={tag}
            >{tag}</button>
          );
        })}
      </div>

      <div class={`sh-grid sh-grid-${digital.length === 1 ? 'single' : 'digital'}`} data-grid="digital">
        {digital.map(product => (
          <a href={`/shop/${product.id}`} class="sh-card sh-card-digital" data-tag={product.tag}>
            <div class="sh-card-img-wrap">
              <div class="sh-card-img" style={`background-image: url('${product.image}')`}></div>
              {getHoverImage(product) && <div class="sh-card-img-hover" style={`background-image: url('${getHoverImage(product)}')`}></div>}
              {product.badge && <div class="sh-badge">{product.badge}</div>}
              <div class="sh-card-overlay">
                <span class="sh-overlay-cta">Scopri →</span>
              </div>
            </div>
            <div class="sh-card-body">
              <div class="sh-card-top">
                <div>
                  <div class="sh-card-sub">{product.subtitle}</div>
                  <h2 class="sh-card-title">{product.title}</h2>
                </div>
                <div class="sh-price">€{product.price}</div>
              </div>
              <p class="sh-card-desc">{product.description}</p>
              <div class="sh-card-cta">
                <span class="sh-cta-btn">Scopri il prodotto →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- NOTE FOOTER -->
  <section class="sh-notes">
    <div class="sh-notes-inner">
      <div class="sh-note">
        <div class="sh-note-icon">01</div>
        <div class="sh-note-title">Stampe fine art</div>
        <div class="sh-note-text">Prodotte su ordinazione in 5–7 giorni. Spedite in tubo rigido. Tiratura limitata — ogni esemplare firmato e numerato.</div>
      </div>
      <div class="sh-note">
        <div class="sh-note-icon">02</div>
        <div class="sh-note-title">Preset digitali</div>
        <div class="sh-note-text">Link di download disponibile subito dopo il pagamento. Compatibile con Lightroom Classic, CC e mobile. Nessuna scadenza.</div>
      </div>
      <div class="sh-note">
        <div class="sh-note-icon">03</div>
        <div class="sh-note-title">Resi</div>
        <div class="sh-note-text">Prodotti fisici restituibili entro 14 giorni se danneggiati. I digitali non sono rimborsabili dopo il download.</div>
      </div>
    </div>
  </section>

<script is:inline>
  document.querySelectorAll('.sh-filters').forEach(function(filterGroup) {
    filterGroup.querySelectorAll('.sh-filter').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (btn.classList.contains('sh-filter-empty')) return;
        var tag = btn.dataset.filter;
        var grid = filterGroup.nextElementSibling;
        // aggiorna active
        filterGroup.querySelectorAll('.sh-filter').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        // mostra/nascondi cards
        grid.querySelectorAll('.sh-card').forEach(function(card) {
          if (tag === 'all' || card.dataset.tag === tag) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
        // aggiorna contatore
        var section = filterGroup.closest('.sh-section');
        var visible = grid.querySelectorAll('.sh-card:not(.hidden)').length;
        var counter = section.querySelector('.sh-section-count');
        if (counter) counter.textContent = visible + (visible === 1 ? ' prodotto' : ' prodotti');
      });
    });
  });
</script>

</BaseLayout>

<style>
  /* HERO */
  .sh-hero {
    background: var(--dark);
    padding: 80px 56px 72px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(201,185,154,0.1);
  }
  .sh-hero-deco {
    position: absolute;
    right: 40px;
    bottom: -80px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 340px;
    font-weight: 300;
    color: rgba(201,185,154,0.04);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .sh-hero-inner { max-width: 640px; position: relative; z-index: 1; }
  .sh-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terra);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .sh-label::before { content: ''; width: 24px; height: 1px; background: var(--terra); display: block; }
  .sh-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 80px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 0.95;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }
  .sh-sub {
    font-size: 13px;
    font-weight: 300;
    color: rgba(250,250,248,0.42);
    line-height: 1.8;
    max-width: 480px;
  }

  /* SECTION */
  .sh-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px 72px;
    border-bottom: 1px solid var(--light-border);
  }
  .sh-section-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .sh-section-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terra);
    flex-shrink: 0;
  }
  .sh-section-count {
    font-size: 9px;
    font-weight: 300;
    color: var(--sand);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }
  .sh-section-line {
    flex: 1;
    height: 1px;
    background: var(--light-border);
  }
  .sh-section-note {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.12em;
    color: var(--muted);
    flex-shrink: 0;
    text-transform: uppercase;
  }

  /* FILTRI */
  .sh-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .sh-filter {
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 7px 16px;
    border: 1px solid rgba(201,185,154,0.25);
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .sh-filter:hover { border-color: var(--terra); color: var(--dark); }
  .sh-filter.active { border-color: var(--terra); background: var(--terra); color: #FAFAF8; }
  .sh-filter-empty { opacity: 0.35; cursor: default; }
  .sh-filter-empty:hover { border-color: rgba(201,185,154,0.25); color: var(--muted); }
  .sh-card.hidden { display: none; }

  /* GRID */
  .sh-grid { display: grid; gap: 2px; }
  .sh-grid-single { grid-template-columns: 1fr; }
  .sh-grid-digital { grid-template-columns: repeat(2, 1fr); }
  .sh-grid-physical { grid-template-columns: repeat(3, 1fr); }

  /* CARD */
  .sh-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--cream);
    border: 1px solid rgba(201,185,154,0.18);
    transition: border-color 0.25s;
  }
  .sh-card:hover { border-color: var(--terra); }

  .sh-card-img-wrap {
    position: relative;
    overflow: hidden;
    background: var(--beige);
  }
  .sh-card-physical .sh-card-img-wrap { aspect-ratio: 3/4; }
  .sh-grid-single .sh-card-img-wrap { aspect-ratio: 16/7; }
  .sh-grid-digital .sh-card-img-wrap { aspect-ratio: 4/3; }

  .sh-card-img-hover {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 1;
  }
  .sh-card:hover .sh-card-img-hover { opacity: 1; }

  .sh-card-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease;
  }
  .sh-card:hover .sh-card-img { transform: scale(1.04); }

  .sh-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--terra);
    color: #fff;
    padding: 4px 12px;
    z-index: 2;
  }

  .sh-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(26,24,20,0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
    z-index: 2;
  }
  .sh-card:hover .sh-card-overlay { background: rgba(26,24,20,0.35); }
  .sh-overlay-cta {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #FAFAF8;
    border: 1px solid rgba(250,250,248,0.5);
    padding: 12px 28px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s, transform 0.25s;
  }
  .sh-card:hover .sh-overlay-cta { opacity: 1; transform: translateY(0); }

  /* CARD BODY */
  .sh-card-body { padding: 24px 24px 28px; display: flex; flex-direction: column; flex: 1; }
  .sh-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }
  .sh-card-sub {
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 6px;
  }
  .sh-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1.1;
    margin: 0;
  }
  .sh-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 300;
    color: var(--dark);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sh-card-desc {
    font-size: 12px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.75;
    margin: 0;
    flex: 1;
  }

  /* CTA (solo per digital single) */
  .sh-card-cta {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(201,185,154,0.2);
  }
  .sh-cta-btn {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terra);
  }

  /* NOTE FOOTER */
  .sh-notes {
    background: var(--dark);
    border-top: 1px solid rgba(201,185,154,0.1);
  }
  .sh-notes-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .sh-note {
    padding: 0 40px 0 0;
    border-right: 1px solid rgba(201,185,154,0.1);
    margin-right: 40px;
  }
  .sh-note:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .sh-note-icon {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 300;
    color: rgba(201,185,154,0.2);
    line-height: 1;
    margin-bottom: 16px;
  }
  .sh-note-title {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 10px;
  }
  .sh-note-text {
    font-size: 12px;
    font-weight: 300;
    color: rgba(250,250,248,0.4);
    line-height: 1.8;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .sh-hero { padding: 56px 24px 52px; }
    .sh-title { font-size: 56px; }
    .sh-section { padding: 48px 24px 56px; }
    .sh-grid-digital,
    .sh-grid-physical { grid-template-columns: repeat(2, 1fr); }
    .sh-grid-single { grid-template-columns: 1fr; }
    .sh-notes-inner { grid-template-columns: 1fr; gap: 36px; padding: 48px 24px; }
    .sh-note { border-right: none; margin-right: 0; padding-right: 0; border-bottom: 1px solid rgba(201,185,154,0.1); padding-bottom: 36px; }
    .sh-note:last-child { border-bottom: none; padding-bottom: 0; }
  }
  @media (max-width: 600px) {
    .sh-title { font-size: 44px; }
    .sh-grid-digital,
    .sh-grid-physical { grid-template-columns: 1fr; }
    .sh-card-physical .sh-card-img-wrap { aspect-ratio: 4/3; }
    .sh-section-head { flex-wrap: wrap; gap: 8px; }
    .sh-section-note { display: none; }
  }
</style>
