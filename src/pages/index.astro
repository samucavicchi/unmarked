---
import { getCollection } from 'astro:content';

const postsRaw = await getCollection('destinazioni');

const posts = postsRaw.filter((post) => {
  const hasTitle = Boolean(post.data.title);
  const hasCover = Boolean(post.data.cover);
  const validDate = !isNaN(new Date(post.data.publishDate).getTime());

  return hasTitle && hasCover && validDate;
});
---

<h1>DEBUG DESTINAZIONI</h1>

<p>Articoli totali letti: {postsRaw.length}</p>
<p>Articoli validi: {posts.length}</p>

<hr />

<h2>Tutti gli articoli letti</h2>

{postsRaw.map((post) => (
  <div style="margin-bottom: 30px; padding: 20px; border: 1px solid #ccc;">
    <h3>{post.slug}</h3>
    <p><strong>Titolo:</strong> {String(post.data.title)}</p>
    <p><strong>Data:</strong> {String(post.data.publishDate)}</p>
    <p><strong>Cover:</strong> {String(post.data.cover)}</p>
  </div>
))}