---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Newsletter from '../components/Newsletter.astro';
import DestinazioneCard from '../components/DestinazioneCard.astro';
import ItinerarioCard from '../components/ItinerarioCard.astro';
import FilmCard from '../components/FilmCard.astro';
import PodcastCard from '../components/PodcastCard.astro';
import { getCollection } from 'astro:content';

const tutteLeDestinazioni = (await getCollection('destinazioni')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const featured = tutteLeDestinazioni.find((e) => e.data.featured) || tutteLeDestinazioni[0];
const sideList = tutteLeDestinazioni.filter((e) => e.slug !== featured?.slug).slice(0, 4);
const grid = tutteLeDestinazioni
  .filter((e) => e.slug !== featured?.slug)
  .filter((e) => !sideList.find((s) => s.slug === e.slug))
  .slice(0, 3);

const tuttiGliItinerari = (await getCollection('itinerari')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const itinerariHome = tuttiGliItinerari.slice(0, 4);

const tuttiIFilm = (await getCollection('film')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const filmFeatured = tuttiIFilm.find((e) => e.data.featured) || tuttiIFilm[0];
const filmAltri = tuttiIFilm.filter((e) => e.slug !== filmFeatured?.slug).slice(0, 4);

const tuttiIPodcast = (await getCollection('podcast')).sort(
  (a, b) => b.data.episodeNumber - a.data.episodeNumber
);
const podcastHome = tuttiIPodcast.slice(0, 4);

const formatDateShort = (date) =>
  date.toLocaleDateString('it-IT', { day: '2-digit', month: 'short' });
---

<BaseLayout
  title="Unmarked — Luoghi che non trovi sulle guide"
  description="Reportage fotografici, itinerari premium e racconti dai posti che non trovi sulle guide."
>
  <Hero />

  <!-- DESTINAZIONI -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Ultime destinazioni</h2>
      <a href="/destinazioni" class="sec-link">Vedi tutte →</a>
    </div>

    {tutteLeDestinazioni.length === 0 && (
      <div style="padding: 60px 0; text-align: center; color: var(--muted); font-style: italic;">
        Le prime destinazioni stanno arrivando.
      </div>
    )}

    {featured && (
      <div class="dest-featured">
        <a href={`/destinazioni/${featured.slug}`} class="feat-img card-link">
          <img src={featured.data.coverImage.src} alt={featured.data.coverImageAlt} class="feat-img-bg" style="object-fit: cover;" />
          <div class="feat-ov"></div>
          <div class="feat-content">
            <div class="feat-tag">{featured.data.country} · {featured.data.continent}{featured.data.region ? ` · ${featured.data.region}` : ''}</div>
            <div class="feat-title">{featured.data.title}</div>
            <div class="feat-meta">{formatDateShort(featured.data.publishDate)}</div>
          </div>
        </a>

        <div class="side-list">
          {sideList.map((entry) => (
            <a href={`/destinazioni/${entry.slug}`} class="side-item card-link">
              <div class="side-thumb">
                <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} class="side-thumb-bg" style="object-fit: cover;" />
              </div>
              <div class="side-info">
                <div class="side-tag">{entry.data.country} · {entry.data.continent}</div>
                <div class="side-title">{entry.data.title}</div>
                <div class="side-meta">{formatDateShort(entry.data.publishDate)}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {grid.length > 0 && (
      <div class="dest-grid pb60">
        {grid.map((entry) => <DestinazioneCard entry={entry} />)}
      </div>
    )}
  </section>

  <!-- ITINERARI -->
  <div class="itinerari-block">
    <div>
      <div class="it-label">Itinerari premium</div>
      <h2 class="it-title">Guide complete.<br />Senza filtri.</h2>
      <p class="it-body">
        Itinerari giorno per giorno, contatti locali verificati, budget reali, mappe offline e
        aggiornamenti stagionali. Quello che i blog non dicono mai.
      </p>
      <a href="/itinerari" class="btn-abbonati">Scopri gli itinerari</a>
    </div>
    <div class="it-cards">
      {itinerariHome.length === 0 && (
        <div class="it-card it-card-placeholder">
          <div>
            <div class="it-card-title">In arrivo · Itinerari premium</div>
            <div class="it-card-meta">I primi itinerari sono in lavorazione.</div>
          </div>
        </div>
      )}
      {itinerariHome.map((entry) => <ItinerarioCard entry={entry} variant="mini" />)}
    </div>
  </div>

  <!-- FILM -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Film di viaggio</h2>
      <a href="/film" class="sec-link">Tutti i film →</a>
    </div>

    {tuttiIFilm.length === 0 && (
      <div style="padding: 60px 0; text-align: center; color: var(--muted); font-style: italic;">
        I primi film stanno per uscire.
      </div>
    )}

    {filmFeatured && (
      <div class="film-grid pb60">
        <FilmCard entry={filmFeatured} variant="main" />
        <div class="film-list">
          {filmAltri.map((entry) => <FilmCard entry={entry} variant="episode" />)}
        </div>
      </div>
    )}
  </section>

  <!-- PODCAST -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Il podcast</h2>
      <a href="/podcast" class="sec-link">Tutti gli episodi →</a>
    </div>

    {tuttiIPodcast.length === 0 && (
      <div style="padding: 60px 0; text-align: center; color: var(--muted); font-style: italic;">
        I primi episodi del podcast stanno arrivando.
      </div>
    )}

    {podcastHome.length > 0 && (
      <div class="pod-grid pb60">
        {podcastHome.map((entry) => <PodcastCard entry={entry} variant="mini" />)}
      </div>
    )}
  </section>

  <!-- SHOP (placeholder) -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Shop</h2>
      <a href="/shop" class="sec-link">Vedi tutto →</a>
    </div>
    <div class="shop-grid pb60">
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#ddd0be,#c4b598);"></div>
          <div class="prod-badge">Nuovo</div>
        </div>
        <div class="prod-name">Pack Unmarked 32L</div>
        <div class="prod-price">€149</div>
      </div>
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#d0c5b3,#bfb09c);"></div>
        </div>
        <div class="prod-name">Field Notes Edition</div>
        <div class="prod-price">€24</div>
      </div>
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#cac0ae,#b9ad9b);"></div>
          <div class="prod-badge">Limitato</div>
        </div>
        <div class="prod-name">Mappa Kirghizistan</div>
        <div class="prod-price">€18</div>
      </div>
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#c5bba9,#b4aa97);"></div>
        </div>
        <div class="prod-name">Bandana Unmarked</div>
        <div class="prod-price">€16</div>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .feat-img-bg, .side-thumb-bg {
    width: 100%;
    height: 100%;
  }
  .it-card-placeholder {
    opacity: 0.6;
    cursor: default;
  }
</style>
