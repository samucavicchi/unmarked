---
// Homepage di Unmarked.
//
// Per ora le sezioni "Ultime destinazioni", "Itinerari premium", "Film", "Podcast"
// e "Shop" sono inline come HTML statico con dati placeholder.
// Nelle Sessioni 3-4 verranno sostituite da componenti che leggono i contenuti
// reali dalle content collections (Destinazioni, Itinerari) gestite via Decap CMS.

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout
  title="Unmarked — Luoghi che non trovi sulle guide"
  description="Reportage fotografici, itinerari premium e racconti dai posti che non trovi sulle guide."
>
  <Hero />

  <!-- DESTINAZIONI (placeholder, diventerà dinamico in Sessione 3) -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Ultime destinazioni</h2>
      <a href="/destinazioni" class="sec-link">Vedi tutte →</a>
    </div>

    <div class="dest-featured">
      <div class="feat-img">
        <div class="feat-img-bg" style="background: linear-gradient(135deg,#d4c5b0,#c9b89a,#b5a585);"></div>
        <div class="feat-ov"></div>
        <div class="feat-content">
          <div class="feat-tag">Val d'Aran · Pirenei · Spagna</div>
          <div class="feat-title">Cinque valli silenziose<br />nei Pirenei catalani</div>
          <div class="feat-meta">7 min · 15 Apr 2026</div>
        </div>
      </div>
      <div class="side-list">
        <div class="side-item">
          <div class="side-thumb">
            <div class="side-thumb-bg" style="background: linear-gradient(135deg,#cdc0ae,#bfad97);"></div>
          </div>
          <div class="side-info">
            <div class="side-tag">Kirghizistan · Asia</div>
            <div class="side-title">A cavallo tra le montagne del Tian Shan</div>
            <div class="side-meta">9 min</div>
          </div>
        </div>
        <div class="side-item">
          <div class="side-thumb">
            <div class="side-thumb-bg" style="background: linear-gradient(135deg,#8A9E8C,#7a8e7c);"></div>
          </div>
          <div class="side-info">
            <div class="side-tag">Albania · Europa</div>
            <div class="side-title">Il segreto meglio custodito del Mediterraneo</div>
            <div class="side-meta">6 min</div>
          </div>
        </div>
        <div class="side-item">
          <div class="side-thumb">
            <div class="side-thumb-bg" style="background: linear-gradient(135deg,#c9bfad,#b8ae9a);"></div>
          </div>
          <div class="side-info">
            <div class="side-tag">Etiopia · Africa</div>
            <div class="side-title">Le chiese rupestri del Tigray, lontano da tutto</div>
            <div class="side-meta">7 min</div>
          </div>
        </div>
        <div class="side-item">
          <div class="side-thumb">
            <div class="side-thumb-bg" style="background: linear-gradient(135deg,#b5a585,#a59575);"></div>
          </div>
          <div class="side-info">
            <div class="side-tag">Portogallo · Europa</div>
            <div class="side-title">Serra de São Mamede prima dell'estate</div>
            <div class="side-meta">5 min</div>
          </div>
        </div>
      </div>
    </div>

    <div class="dest-grid pb60">
      <div class="card">
        <div class="card-img">
          <div class="card-img-bg" style="background:linear-gradient(135deg,#ddd0be,#c9b89a);"></div>
          <div class="card-img-tag">Giappone · Asia</div>
        </div>
        <div class="card-date">10 Apr · 11 min</div>
        <div class="card-title">Shikoku: il pellegrinaggio dei silenzi</div>
        <div class="card-body">1.200 chilometri a piedi attorno all'isola meno visitata del Giappone.</div>
        <div class="card-foot">
          <span class="card-author">Reportage</span>
          <span class="card-read">Leggi →</span>
        </div>
      </div>
      <div class="card">
        <div class="card-img">
          <div class="card-img-bg" style="background:linear-gradient(135deg,#cdc0ae,#bfad97);"></div>
          <div class="card-img-tag">Namibia · Africa</div>
        </div>
        <div class="card-date">3 Apr · 8 min</div>
        <div class="card-title">Il deserto del Namib al tramonto</div>
        <div class="card-body">Dune rosse, silenzio cosmico e un lodge costruito con le pietre del luogo.</div>
        <div class="card-foot">
          <span class="card-author">Reportage</span>
          <span class="card-read">Leggi →</span>
        </div>
      </div>
      <div class="card">
        <div class="card-img">
          <div class="card-img-bg" style="background:linear-gradient(135deg,#c4b598,#b4a588);"></div>
          <div class="card-img-tag">Georgia · Caucaso</div>
        </div>
        <div class="card-date">28 Mar · 6 min</div>
        <div class="card-title">Tbilisi: la città che non vuole essere scoperta</div>
        <div class="card-body">Vecchie terme sulfuree, vino arancione e quartieri che resistono al turismo.</div>
        <div class="card-foot">
          <span class="card-author">Reportage</span>
          <span class="card-read">Leggi →</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ITINERARI (placeholder, diventerà dinamico in Sessione 4) -->
  <div class="itinerari-block">
    <div>
      <div class="it-label">Itinerari premium</div>
      <h2 class="it-title">Guide complete.<br />Senza filtri.</h2>
      <p class="it-body">
        Itinerari giorno per giorno, contatti locali verificati, budget reali, mappe offline e
        aggiornamenti stagionali. Quello che i blog non dicono mai.
      </p>
      <a href="/itinerari" class="btn-abbonati">Scopri gli itinerari</a>
    </div>
    <div class="it-cards">
      <div class="it-card">
        <div>
          <div class="it-card-title">Kirghizistan in autonomia · 14 giorni</div>
          <div class="it-card-meta">Asia Centrale · Avventura · Trekking</div>
        </div>
        <div class="it-price">€12</div>
      </div>
      <div class="it-card">
        <div>
          <div class="it-card-title">Patagonia alternativa · 21 giorni</div>
          <div class="it-card-meta">Sud America · Natura · Fuori stagione</div>
        </div>
        <div class="it-price">€12</div>
      </div>
      <div class="it-card">
        <div>
          <div class="it-card-title">Albania nord a sud · 10 giorni</div>
          <div class="it-card-meta">Europa · Scoperta · Budget</div>
        </div>
        <div class="it-price">€9</div>
      </div>
      <div class="it-card">
        <div>
          <div class="it-card-title">Georgia e Armenia · 16 giorni</div>
          <div class="it-card-meta">Caucaso · Cultura · Gastronomia</div>
        </div>
        <div class="it-price">€12</div>
      </div>
    </div>
  </div>

  <!-- FILM (placeholder) -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Film di viaggio</h2>
      <a href="/film" class="sec-link">Tutti i film →</a>
    </div>
    <div class="film-grid pb60">
      <div>
        <div class="film-main-img">
          <div class="film-main-bg"></div>
          <div class="film-main-ov"></div>
          <div style="position:relative;">
            <div class="film-play"><div class="film-play-icon"></div></div>
            <div class="film-main-tag">Kirghizistan · Documentario</div>
            <div class="film-main-title">Oltre i passi.<br />Un'estate nomade.</div>
            <div class="film-main-dur">24 min · 2026</div>
          </div>
        </div>
        <div class="film-main-desc">
          Un viaggio a cavallo attraverso le vallate del Tian Shan. Tre settimane con una famiglia
          nomade, tra yurte, silenzi e orizzonti senza fine.
        </div>
      </div>
      <div class="film-list">
        <div class="film-ep">
          <div class="film-thumb">
            <div class="film-thumb-bg" style="background:linear-gradient(135deg,#2a2520,#1a1814);"></div>
            <div class="film-thumb-play"></div>
          </div>
          <div>
            <div class="film-ep-tag">Albania · Cortometraggio</div>
            <div class="film-ep-title">Il villaggio che non esiste sulle mappe</div>
            <div class="film-ep-dur">11 min · Mar 2026</div>
          </div>
        </div>
        <div class="film-ep">
          <div class="film-thumb">
            <div class="film-thumb-bg" style="background:linear-gradient(135deg,#251f1a,#181410);"></div>
            <div class="film-thumb-play"></div>
          </div>
          <div>
            <div class="film-ep-tag">Patagonia · Documentario</div>
            <div class="film-ep-title">Torres del Paine fuori stagione</div>
            <div class="film-ep-dur">18 min · Feb 2026</div>
          </div>
        </div>
        <div class="film-ep">
          <div class="film-thumb">
            <div class="film-thumb-bg" style="background:linear-gradient(135deg,#221e1a,#161210);"></div>
            <div class="film-thumb-play"></div>
          </div>
          <div>
            <div class="film-ep-tag">Etiopia · Reportage</div>
            <div class="film-ep-title">Lalibela all'alba, prima dei turisti</div>
            <div class="film-ep-dur">14 min · Gen 2026</div>
          </div>
        </div>
        <div class="film-ep" style="border-bottom:none; padding-bottom:0;">
          <div class="film-thumb">
            <div class="film-thumb-bg" style="background:linear-gradient(135deg,#201c18,#14100e);"></div>
            <div class="film-thumb-play"></div>
          </div>
          <div>
            <div class="film-ep-tag">Giappone · Essay</div>
            <div class="film-ep-title">Shikoku: il pellegrinaggio dei silenzi</div>
            <div class="film-ep-dur">22 min · Dic 2025</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PODCAST (placeholder) -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Il podcast</h2>
      <a href="/podcast" class="sec-link">Tutti gli episodi →</a>
    </div>
    <div class="pod-grid pb60">
      <div class="pod-ep">
        <div class="pod-num">01</div>
        <div style="flex:1;">
          <div class="pod-tag">Destinazioni</div>
          <div class="pod-title">Perché l'Albania è il posto giusto adesso</div>
          <div class="pod-dur">42 min · Mar 2026</div>
        </div>
        <div class="pod-btn"><div class="pod-icon"></div></div>
      </div>
      <div class="pod-ep">
        <div class="pod-num">02</div>
        <div style="flex:1;">
          <div class="pod-tag">Pratiche</div>
          <div class="pod-title">Viaggiare slow: meno cose, più tempo</div>
          <div class="pod-dur">38 min · Mar 2026</div>
        </div>
        <div class="pod-btn"><div class="pod-icon"></div></div>
      </div>
      <div class="pod-ep">
        <div class="pod-num">03</div>
        <div style="flex:1;">
          <div class="pod-tag">Fotografia</div>
          <div class="pod-title">Come fotografo i paesi che nessuno conosce</div>
          <div class="pod-dur">51 min · Feb 2026</div>
        </div>
        <div class="pod-btn"><div class="pod-icon"></div></div>
      </div>
      <div class="pod-ep">
        <div class="pod-num">04</div>
        <div style="flex:1;">
          <div class="pod-tag">Storie</div>
          <div class="pod-title">Il viaggio che ha cambiato tutto</div>
          <div class="pod-dur">29 min · Feb 2026</div>
        </div>
        <div class="pod-btn"><div class="pod-icon"></div></div>
      </div>
    </div>
  </section>

  <!-- SHOP (placeholder) -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Shop</h2>
      <a href="/shop" class="sec-link">Vedi tutto →</a>
    </div>
    <div class="shop-grid pb60">
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#ddd0be,#c4b598);"></div>
          <div class="prod-badge">Nuovo</div>
        </div>
        <div class="prod-name">Pack Unmarked 32L</div>
        <div class="prod-price">€149</div>
      </div>
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#d0c5b3,#bfb09c);"></div>
        </div>
        <div class="prod-name">Field Notes Edition</div>
        <div class="prod-price">€24</div>
      </div>
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#cac0ae,#b9ad9b);"></div>
          <div class="prod-badge">Limitato</div>
        </div>
        <div class="prod-name">Mappa Kirghizistan</div>
        <div class="prod-price">€18</div>
      </div>
      <div class="prod">
        <div class="prod-img">
          <div class="prod-img-bg" style="background:linear-gradient(145deg,#c5bba9,#b4aa97);"></div>
        </div>
        <div class="prod-name">Bandana Unmarked</div>
        <div class="prod-price">€16</div>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
