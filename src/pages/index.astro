---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Newsletter from '../components/Newsletter.astro';
import DestinazioneCard from '../components/DestinazioneCard.astro';
import { getCollection } from 'astro:content';

// Carica le ultime destinazioni dalla collection
const tutteLeDestinazioni = (await getCollection('destinazioni')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Featured = la più recente con featured: true. Se nessuna featured, prende la più recente in assoluto.
const featured = tutteLeDestinazioni.find((e) => e.data.featured) || tutteLeDestinazioni[0];

// Side list = prossime 4 dopo la featured
const sideList = tutteLeDestinazioni
  .filter((e) => e.slug !== featured?.slug)
  .slice(0, 4);

// Grid = altre 3 dopo featured + sideList
const grid = tutteLeDestinazioni
  .filter((e) => e.slug !== featured?.slug)
  .filter((e) => !sideList.find((s) => s.slug === e.slug))
  .slice(0, 3);

const formatDateShort = (date) =>
  date.toLocaleDateString('it-IT', { day: '2-digit', month: 'short' });
---

<BaseLayout
  title="Unmarked — Luoghi che non trovi sulle guide"
  description="Reportage fotografici, itinerari premium e racconti dai posti che non trovi sulle guide."
>
  <Hero />

  <!-- DESTINAZIONI -->
  <section>
    <div class="sec-head">
      <h2 class="sec-title">Ultime destinazioni</h2>
      <a href="/destinazioni" class="sec-link">Vedi tutte →</a>
    </div>

    {tutteLeDestinazioni.length === 0 && (
      <div style="padding: 60px 0; text-align: center; color: var(--muted); font-style: italic;">
        Le prime destinazioni stanno arrivando.
      </div>
    )}

    {featured && (
      <div class="dest-featured">
        <a href={`/destinazioni/${featured.slug}`} class="feat-img card-link">
          <img src={featured.data.coverImage.src} alt={featured.data.coverImageAlt} class="feat-img-bg" style="object-fit: cover;" />
          <div class="feat-ov"></div>
          <div class="feat-content">
            <div class="feat-tag">{featured.data.country} · {featured.data.continent}{featured.data.region ? ` · ${featured.data.region}` : ''}</div>
            <div class="feat-title">{featured.data.title}</div>
            <div class="feat-meta">{formatDateShort(featured.data.publishDate)}</div>
          </div>
        </a>

        <div class="side-list">
          {sideList.map((entry) => (
            <a href={`/destinazioni/${entry.slug}`} class="side-item card-link">
              <div class="side-thumb">
                <img src={entry.data.coverImage.src} alt={entry.data.coverImageAlt} class="side-thumb-bg" style="object-fit: cover;" />
              </div>
              <div class="side-info">
                <div class="side-tag">{entry.data.country} · {entry.data.continent}</div>
                <div class="side-title">{entry.data.title}</div>
                <div class="side-meta">{formatDateShort(entry.data.publishDate)}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {grid.length > 0 && (
      <div class="dest-grid pb60">
        {grid.map((entry) => <DestinazioneCard entry={entry} />)}
      </div>
    )}
  </section>

  <!-- ITINERARI (placeholder, dinamico in Sessione 5) -->
  <div class="itinerari-block">
    <div>
      <div class="it-label">Itinerari premium</div>
      <h2 class="it-title">Guide complete.<br />Senza filtri.</h2>
      <p class="it-body">
        Itinerari giorno per giorno, contatti locali verificati, budget reali, mappe offline e
        aggiornamenti stagionali. Quello che i blog non dicono mai.
      </p>
      <a href="/itinerari" class="btn-abbonati">Scopri gli itinerari</a>
    </div>
    <div class="it-cards">
      <div class="it-card">
        <div>
          <div class="it-card-title">Kirghizistan in autonomia · 14 giorni</div>
          <div class="it-card-meta">Asia Centrale · Avventura · Trekking</div>
        </div>
        <div class="it-price">€12</div>
      </div>
      <div class="it-card">
        <div>
          <div class="it-card-title">Patagonia alternativa · 21 giorni</div>
          <div class="it-card-meta">Sud America · Natura · Fuori stagione</div>
        </div>
        <div class="it-price">€12</div>
      </div>
      <div class="it-card">
        <div>
          <div class="it-card-title">Albania nord a sud · 10 giorni</div>
          <div class="it-card-meta">Europa · Scoperta · Budget</div>
        </div>
        <div class="it-price">€9</div>
      </div>
      <div class="it-card">
        <div>
          <div class="it-card-title">Georgia e Armenia · 16 giorni</div>
          <div class="it-card-meta">Caucaso · Cultura · Gastronomia</div>
        </div>
        <div class="it-price">€12</div>
      </div>
    </div>
  </div>

  <Newsletter />
</BaseLayout>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .feat-img-bg, .side-thumb-bg {
    width: 100%;
    height: 100%;
  }
</style>
