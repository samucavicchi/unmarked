---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const user = await Astro.locals.currentUser();
const isPremium = user?.publicMetadata?.isPremium === true;

const allLocations = await getCollection('blackbook');
const locations = allLocations.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const publishedCount = locations.filter(l => l.data.status === 'published').length;
const countries = [...new Set(locations.map(l => l.data.country))].length;

// Tipi unici per i filtri
const types = [...new Set(locations.map(l => l.data.type))];
const continents = [...new Set(locations.map(l => l.data.continent))];
---

<BaseLayout
  title="Spotsbook — Unmarked"
  description="Location fotografiche segrete. Coordinate precise, ora giusta, luce perfetta. Riservato agli Unmarked Pro."
>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&display=swap" rel="stylesheet" slot="head" />
  <style slot="head">
    .leaflet-container { background: #141210 !important; }
    html, body { background-color: #1A1814 !important; }
  </style>
  <script is:inline slot="head">document.documentElement.style.backgroundColor='#1A1814';</script>

  <!-- HERO -->
  <section class="bb-hero">
    <div class="bb-hero-inner">
      <div class="bb-hero-left">
        <div class="bb-label">Unmarked · Pro</div>
        <h1 class="bb-title">Spotsbook</h1>
        <p class="bb-sub">Coordinate precise, ora giusta, luce perfetta. Quello che abbiamo trovato sul campo — e che non mettiamo sulle guide.</p>
        <div class="bb-stats">
          <div class="bb-stat"><div class="bb-stat-num">{publishedCount}</div><div class="bb-stat-label">Location</div></div>
          <div class="bb-stat"><div class="bb-stat-num">{countries}</div><div class="bb-stat-label">Paesi</div></div>
          <div class="bb-stat"><div class="bb-stat-num">+3</div><div class="bb-stat-label">/ mese</div></div>
        </div>
      </div>
      <div class="bb-hero-right">
        <div class="bb-handwritten-note">
          <span class="bb-hw-line1">Sei un fotografo?</span>
          <span class="bb-hw-line2">questa pagina</span>
          <span class="bb-hw-line3">è dedicata</span>
          <span class="bb-hw-line4">a te.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SEPARATORE -->
  <div class="bb-separator"></div>

  {!isPremium ? (
    <!-- TEASER per non abbonati -->
    <section class="bb-teaser">
      <div class="bb-teaser-map" id="bb-teaser-map">
        <div class="bb-teaser-map-fade"></div>
      </div>
      <div class="bb-teaser-cta">
        <div class="bb-label bb-label-light">Spotsbook · Unmarked Pro</div>
        <h2 class="bb-teaser-title">Location fotografiche segrete.<br/>Coordinate precise.</h2>
        <p class="bb-teaser-text">{publishedCount} location sul campo con ora giusta, luce perfetta e note che non mettiamo sulle guide. Riservato agli Unmarked Pro.</p>
        <div class="bb-teaser-actions">
          <a href="/sign-up" class="bb-cta-btn">Sblocca tutto — €29/mese</a>
          <a href="/sign-in" class="bb-cta-link">Hai già un account? Accedi</a>
        </div>
      </div>
    </section>
    <script define:vars={{ teaserLocations: locations.map(l => ({
      lat: l.data.lat,
      lng: l.data.lng,
      preview: l.data.preview || false,
      title: l.data.title,
      country: l.data.country,
      region: l.data.region || '',
      continent: l.data.continent,
      type: l.data.type,
      bestTime: l.data.bestTime || '',
      bestSeason: l.data.bestSeason || '',
      focalLength: l.data.focalLength || '',
      isoRange: l.data.isoRange || '',
      access: l.data.access || '',
      difficulty: l.data.difficulty || '',
      avvicinamento: l.data.avvicinamento || '',
      handnotes: l.data.handnotes || [],
      checklist: l.data.checklist || [],
      equipment: l.data.equipment || [],
      antiMainstream: l.data.antiMainstream || '',
      personalNote: l.data.personalNote || '',
      coordinates: l.data.coordinates || '',
      images: l.data.images || [],
    })) }}>
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(css);
      const js = document.createElement('script');
      js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      js.onload = () => {
        const map = L.map('bb-teaser-map', { zoomControl: false, dragging: false, scrollWheelZoom: false, doubleClickZoom: false, keyboard: false, tap: false, touchZoom: false, minZoom: 3 }).setView([20, 20], 3);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
          subdomains: 'abcd', maxZoom: 19, attribution: ''
        }).addTo(map);

        teaserLocations.forEach(loc => {
          const isPreview = loc.preview;
          const icon = L.divIcon({
            className: '',
            html: isPreview
              ? `<div style="width:13px;height:13px;border-radius:50%;background:#B1714A;border:2px solid rgba(255,252,240,0.8);box-shadow:0 0 0 4px rgba(177,113,74,0.25);cursor:pointer"></div>`
              : `<div style="width:8px;height:8px;border-radius:50%;background:#B1714A;opacity:0.45;cursor:pointer"></div>`,
            iconSize: isPreview ? [13,13] : [8,8],
            iconAnchor: isPreview ? [6,6] : [4,4]
          });
          const marker = L.marker([loc.lat, loc.lng], { icon, interactive: true });
          marker.on('click', (e) => {
            L.DomEvent.stopPropagation(e);
            L.DomEvent.preventDefault(e);
            if (isPreview) {
              openTeaserPanel(loc);
            } else {
              openLockedPanel();
            }
          });
          marker.addTo(map);
        });
      };
      document.head.appendChild(js);

      function openTeaserPanel(loc) {
        const panel = document.getElementById('bb-teaser-panel');
        const content = document.getElementById('bb-teaser-panel-content');

        let html = `
          <div class="tbp-region">${loc.country}${loc.region ? ' · ' + loc.region : ''} · ${loc.type}</div>
          <div class="tbp-title">${loc.title}</div>
          <div class="tbp-meta">
            ${loc.bestSeason ? `<div class="tbp-meta-row"><span class="tbp-meta-label">Periodo</span><span class="tbp-meta-val">${loc.bestSeason}</span></div>` : ''}
            ${loc.bestTime ? `<div class="tbp-meta-row"><span class="tbp-meta-label">Luce ottimale</span><span class="tbp-meta-val">${loc.bestTime}</span></div>` : ''}
          </div>
        `;

        if (loc.images && loc.images.length) {
          html += `<div class="tbp-gallery">`;
          loc.images.forEach(img => {
            html += `<div class="tbp-img" style="background-image:url('${img.src}')"></div>`;
          });
          html += `</div>`;
        }

        if (loc.difficulty) html += `<div class="tbp-block"><div class="tbp-block-label">Difficoltà fotografica</div><div class="tbp-block-text">${loc.difficulty}</div></div>`;
        if (loc.focalLength) html += `<div class="tbp-block"><div class="tbp-block-label">Tecnica consigliata</div><div class="tbp-block-text">${loc.focalLength}</div></div>`;
        if (loc.isoRange) html += `<div class="tbp-block"><div class="tbp-block-label">Composizione consigliata</div><div class="tbp-block-text">${loc.isoRange}</div></div>`;
        if (loc.antiMainstream) html += `<div class="tbp-block"><div class="tbp-block-label">↯ Anti-mainstream</div><div class="tbp-block-text">${loc.antiMainstream}</div></div>`;

        const fields = [
          { label: 'Accesso', val: loc.access },
          { label: 'Avvicinamento', val: loc.avvicinamento },
        ].filter(f => f.val);
        if (fields.length) {
          html += `<div class="tbp-fields">`;
          fields.forEach(f => {
            html += `<div class="tbp-field"><div class="tbp-field-label">${f.label}</div><div class="tbp-field-val">${f.val}</div></div>`;
          });
          html += `</div>`;
        }

        loc.handnotes.forEach(note => {
          html += `<div class="tbp-handnote"><span>↳</span><span>${note}</span></div>`;
        });

        if (loc.equipment && loc.equipment.length) {
          html += `<div class="tbp-equip-title">Attrezzatura</div><div class="tbp-equip-list">`;
          loc.equipment.forEach(item => {
            html += `<div class="tbp-equip-item"><span class="tbp-equip-check"></span><span class="tbp-equip-label">${item}</span></div>`;
          });
          html += `</div>`;
        }

        if (loc.checklist.length) {
          html += `<div class="tbp-checklist">`;
          loc.checklist.forEach(item => {
            html += `<div class="tbp-check"><svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="#C4855A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>${item}</div>`;
          });
          html += `</div>`;
        }

        if (loc.personalNote) html += `<div class="tbp-personal">★ ${loc.personalNote}</div>`;

        const coordText = loc.coordinates || `${loc.lat}, ${loc.lng}`;
        html += `<div class="tbp-coords">${coordText}</div>`;

        content.innerHTML = html;
        panel.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function openLockedPanel() {
        const panel = document.getElementById('bb-teaser-panel');
        const content = document.getElementById('bb-teaser-panel-content');
        content.innerHTML = `
          <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:300px;text-align:center;gap:16px">
            <svg viewBox="0 0 24 24" fill="none" stroke="rgba(177,113,74,0.6)" stroke-width="1" width="48" height="48"><rect x="3" y="11" width="18" height="11" rx="1"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <div style="font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300;color:#FAFAF8;line-height:1.1">Location bloccata</div>
            <div style="font-size:13px;font-weight:300;color:rgba(250,250,248,0.45);line-height:1.7;max-width:320px">Entra a far parte di Unmarked Pro per accedere a questa e a tutte le altre location fotografiche segrete — coordinate precise, tecnica, luce ottimale e note dal campo.</div>
          </div>
        `;
        panel.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      window.closeTeaserPanel = function() {
        document.getElementById('bb-teaser-panel').classList.remove('is-open');
        document.body.style.overflow = '';
      };
    </script>
  ) : (
    <!-- MAPPA + PANNELLO per abbonati -->
    <section class="bb-app">
      <div class="bb-book">
      <div class="bb-toolbar">
        <div class="bb-toolbar-left">
          <span class="bb-toolbar-label">Filtra</span>
          <button class="bb-chip active" data-filter="all">Tutte</button>
          {types.map(t => <button class="bb-chip" data-filter={t}>{t}</button>)}
          {continents.map(c => <button class="bb-chip" data-filter={c}>{c}</button>)}
          <button class="bb-chip bb-chip-saved" data-filter="saved">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:12px;height:12px;display:inline-block;vertical-align:middle;margin-right:4px"><path d="M5 3h14a1 1 0 0 1 1 1v17l-7-3-7 3V4a1 1 0 0 1 1-1z"/></svg>
            Salvati
          </button>
        </div>
        <div class="bb-toolbar-right">
          <div class="bb-search-wrap">
            <svg class="bb-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
            <input class="bb-search" id="bb-search" type="text" placeholder="Cerca location…" autocomplete="off" />
          </div>
          <span class="bb-count" id="bb-count">{publishedCount} location</span>
        </div>
      </div>

      <div class="bb-layout">
        <div class="bb-map-wrap" id="bb-map">
          <div class="bb-legend">
            <div class="bb-legend-item"><span class="bb-legend-dot bb-legend-dot--available"></span>Disponibile</div>
            <div class="bb-legend-item"><span class="bb-legend-dot bb-legend-dot--saved"></span>Salvata</div>
            <div class="bb-legend-item"><span class="bb-legend-dot bb-legend-dot--new"></span>Nuova</div>
            <div class="bb-legend-item"><span class="bb-legend-dot bb-legend-dot--soon"></span>Coming soon</div>
          </div>
        </div>

        <div class="bb-panel" id="bb-panel">
          <div class="bb-panel-empty" id="bb-panel-empty">
            <div class="bb-panel-empty-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
            </div>
            <p class="bb-panel-empty-text">Seleziona un pin sulla mappa</p>
          </div>
          <div class="bb-panel-content" id="bb-panel-content" style="display:none">
            <div class="bb-panel-top" id="bb-panel-top"></div>
            <div class="bb-panel-divider"></div>
            <div class="bb-panel-body" id="bb-panel-body"></div>
            <div class="bb-panel-nav">
              <button class="bb-nav-btn" id="bb-prev">← Precedente</button>
              <span class="bb-nav-pos" id="bb-nav-pos"></span>
              <button class="bb-nav-btn" id="bb-next">Successiva →</button>
            </div>
          </div>
        </div>
      </div>
      </div>
    </section>
  )}

<!-- PANNELLO TEASER (preview pin per non abbonati) -->
<div id="bb-teaser-panel" class="tbp-wrap" aria-hidden="true">
  <div class="tbp-backdrop" id="bb-teaser-panel-backdrop" onclick="window.closeTeaserPanel()"></div>
  <div class="tbp-panel">
    <button class="tbp-close" id="bb-teaser-panel-close" aria-label="Chiudi" onclick="window.closeTeaserPanel()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="tbp-scroll" id="bb-teaser-panel-content"></div>
    <div class="tbp-footer">
      <div class="tbp-footer-text">Questa è una sola location. Ce ne sono <strong>{publishedCount}</strong> nel Spotsbook, con nuove aggiunte ogni mese.</div>
      <a href="/sign-up" class="bb-cta-btn">Sblocca tutto — €29/mese</a>
      <a href="/sign-in" class="bb-cta-link" style="text-align:center">Hai già un account? Accedi</a>
    </div>
  </div>
</div>

<!-- LIGHTBOX IMMAGINI -->
<div id="sb-lightbox" class="sbl-wrap" aria-hidden="true">
  <div class="sbl-backdrop" id="sb-lightbox-backdrop"></div>
  <button class="sbl-close" id="sb-lightbox-close" aria-label="Chiudi">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <div class="sbl-img-wrap">
    <img class="sbl-img" id="sb-lightbox-img" src="" alt="" />
    <div class="sbl-caption" id="sb-lightbox-caption"></div>
  </div>
</div>

<!-- OVERLAY DETTAGLIO -->
<div id="sb-overlay" class="sbo-wrap" aria-hidden="true">
  <div class="sbo-backdrop" id="sb-overlay-backdrop"></div>
  <div class="sbo-panel">
    <button class="sbo-close" id="sb-overlay-close" aria-label="Chiudi">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="sbo-scroll" id="sb-overlay-content"></div>
  </div>
</div>

</BaseLayout>

{isPremium && (
  <script
    define:vars={{
      locations: locations.map(l => ({
        slug: l.slug,
        title: l.data.title,
        country: l.data.country,
        region: l.data.region || '',
        continent: l.data.continent,
        type: l.data.type,
        lat: l.data.lat,
        lng: l.data.lng,
        status: l.data.status,
        bestTime: l.data.bestTime || '',
        bestSeason: l.data.bestSeason || '',
        focalLength: l.data.focalLength || '',
        isoRange: l.data.isoRange || '',
        access: l.data.access || '',
        difficulty: l.data.difficulty || '',
        avvicinamento: l.data.avvicinamento || '',
        handnotes: l.data.handnotes || [],
        checklist: l.data.checklist || [],
        equipment: l.data.equipment || [],
        antiMainstream: l.data.antiMainstream || '',
        personalNote: l.data.personalNote || '',
        coordinates: l.data.coordinates || '',
        images: l.data.images || [],
        publishDate: l.data.publishDate ? l.data.publishDate.toISOString() : '',
      }))
    }}
  >
    // Carica Leaflet
    const leafletCSS = document.createElement('link');
    leafletCSS.rel = 'stylesheet';
    leafletCSS.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(leafletCSS);
    const leafletJS = document.createElement('script');
    leafletJS.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    leafletJS.onload = () => initMap();
    document.head.appendChild(leafletJS);

    let map, currentIndex = 0, filteredLocations = [...locations], activeMarker = null;

    // ─────────────────────────────────────────────
    // STORAGE LAYER — swap queste 3 funzioni con
    // chiamate Clerk quando sarà il momento:
    //   getSaved()     → clerk.user.publicMetadata.savedSpots
    //   toggleSave()   → clerk.user.update({ publicMetadata: {...} })
    //   isSaved()      → derivata da getSaved()
    // ─────────────────────────────────────────────
    const STORAGE_KEY = 'spotsbook_saved';

    function getSaved() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); }
      catch { return []; }
    }

    function toggleSave(slug) {
      const saved = getSaved();
      const idx = saved.indexOf(slug);
      if (idx === -1) saved.push(slug);
      else saved.splice(idx, 1);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
      return getSaved();
    }

    function isSaved(slug) {
      return getSaved().includes(slug);
    }
    // ─────────────────────────────────────────────

    function initMap() {
      map = L.map('bb-map', { zoomControl: false, scrollWheelZoom: true, tap: false, minZoom: 2 }).setView([20, 20], 2);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '© OpenStreetMap © CARTO', subdomains: 'abcd', maxZoom: 19, noWrap: true
      }).addTo(map);
      L.control.zoom({ position: 'bottomright' }).addTo(map);
      renderMarkers(locations);
    }

    function isNew(loc) {
      if (!loc.publishDate) return false;
      const days = (Date.now() - new Date(loc.publishDate).getTime()) / (1000 * 60 * 60 * 24);
      return days <= 30;
    }

    function makeIcon(published, active = false, saved = false, newBadge = false) {
      let cls = 'bb-pin';
      if (!published) cls += ' bb-pin-locked';
      else if (active) cls += ' bb-pin-active';
      else if (saved) cls += ' bb-pin-saved';
      const badge = (published && newBadge) ? `<div class="bb-pin-new"></div>` : '';
      return L.divIcon({
        className: '',
        html: `<div class="${cls}"><div class="bb-pin-dot"></div>${badge}</div>`,
        iconSize: [16, 22], iconAnchor: [8, 22]
      });
    }

    function renderMarkers(locs) {
      if (map._layers) Object.values(map._layers).forEach(l => { if (l._icon) map.removeLayer(l); });
      filteredLocations = locs;
      locs.forEach((loc, i) => {
        const published = loc.status === 'published';
        const marker = L.marker([loc.lat, loc.lng], { icon: makeIcon(published, false, published && isSaved(loc.slug), isNew(loc)) });
        if (published) {
          marker.on('click', () => {
            if (activeMarker) {
              const prev = locs[filteredLocations.indexOf(filteredLocations.find(l => l === filteredLocations[currentIndex]))];
              activeMarker.setIcon(makeIcon(true, false, isSaved(loc.slug), isNew(loc)));
            }
            marker.setIcon(makeIcon(true, true, false, false));
            activeMarker = marker;
            openPanel(i, locs);
          });
        }
        marker.addTo(map);
      });
    }

    function openPanel(index, locs) {
      currentIndex = index;
      const loc = locs[index];
      const top = document.getElementById('bb-panel-top');
      const body = document.getElementById('bb-panel-body');

      const previewImg = loc.images && loc.images.length ? loc.images[0].src : '';
      const saved = isSaved(loc.slug);

      top.innerHTML = `
        ${previewImg ? `<div class="bb-panel-preview" style="background-image:url('${previewImg}')"></div>` : ''}
        <div class="bb-panel-header">
          <div class="bb-panel-region">${loc.country} · ${loc.continent}${isNew(loc) ? ' <span class="bb-new-badge">Nuovo</span>' : ''}</div>
          <div class="bb-panel-name">${loc.title}</div>
          <div class="bb-panel-meta">
            ${loc.bestSeason ? `<div class="bb-panel-meta-row"><span class="bb-panel-meta-label">Periodo</span><span class="bb-panel-meta-val">${loc.bestSeason}</span></div>` : ''}
            ${loc.bestTime ? `<div class="bb-panel-meta-row"><span class="bb-panel-meta-label">Luce ottimale</span><span class="bb-panel-meta-val">${loc.bestTime}</span></div>` : ''}
          </div>
          ${loc.difficulty ? `<div class="bb-panel-block"><div class="bb-panel-block-label">Difficoltà fotografica</div><div class="bb-panel-block-text">${loc.difficulty}</div></div>` : ''}
        </div>
      `;

      const bodyHTML = `
        <div class="bb-panel-actions">
          <button class="bb-detail-btn" onclick="openOverlay(${index})">Scopri tutto</button>
          <button class="bb-save-btn ${saved ? 'is-saved' : ''}" onclick="handleSave('${loc.slug}', this)" title="${saved ? 'Rimuovi dai salvati' : 'Salva location'}">
            <svg viewBox="0 0 24 24" fill="${saved ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="1.5"><path d="M5 3h14a1 1 0 0 1 1 1v17l-7-3-7 3V4a1 1 0 0 1 1-1z"/></svg>
          </button>
        </div>
        <a class="bb-panel-gmaps" href="https://www.google.com/maps?q=${loc.lat},${loc.lng}" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          Apri in Google Maps
        </a>`;

      body.innerHTML = bodyHTML;

      document.getElementById('bb-panel-empty').style.display = 'none';
      document.getElementById('bb-panel-content').style.display = 'flex';

      const publishedLocs = locs.filter(l => l.status === 'published');
      const pos = publishedLocs.indexOf(loc) + 1;
      document.getElementById('bb-nav-pos').textContent = `${pos} / ${publishedLocs.length}`;

      map.panTo([loc.lat, loc.lng], { animate: true });
    }

    window.handleSave = function(slug, btn) {
      const nowSaved = toggleSave(slug);
      const saved = nowSaved.includes(slug);
      btn.classList.toggle('is-saved', saved);
      btn.querySelector('svg').setAttribute('fill', saved ? 'currentColor' : 'none');
      btn.title = saved ? 'Rimuovi dai salvati' : 'Salva location';
      // aggiorna icona pin sulla mappa
      renderMarkers(filteredLocations);
    };

    window.openOverlay = function(index) {
      const loc = filteredLocations[index];
      const overlay = document.getElementById('sb-overlay');
      const content = document.getElementById('sb-overlay-content');

      let html = `
        <div class="sbo-region">${loc.country}${loc.region ? ' · ' + loc.region : ''} · ${loc.type}</div>
        <div class="sbo-title">${loc.title}</div>
        <div class="sbo-meta">
          ${loc.bestSeason ? `<div class="sbo-meta-row"><span class="sbo-meta-label">Periodo</span><span class="sbo-meta-val">${loc.bestSeason}</span></div>` : ''}
          ${loc.bestTime ? `<div class="sbo-meta-row"><span class="sbo-meta-label">Luce ottimale</span><span class="sbo-meta-val">${loc.bestTime}</span></div>` : ''}
        </div>
      `;

      // Galleria immagini (cliccabili per lightbox)
      if (loc.images && loc.images.length) {
        html += `<div class="sbo-gallery">`;
        loc.images.forEach((img, i) => {
          html += `<div class="sbo-img" style="background-image:url('${img.src}')" role="button" tabindex="0" aria-label="${img.alt || 'Foto ' + (i+1)}" onclick="openLightbox('${img.src}', '${(img.alt || '').replace(/'/g, "\\'")}')"></div>`;
        });
        html += `</div>`;
      }

      // Focale, Difficoltà, Composizione consigliata, Anti-mainstream — stile blocco
      if (loc.difficulty) html += `<div class="sbo-block"><div class="sbo-block-label">Difficoltà fotografica</div><div class="sbo-block-text">${loc.difficulty}</div></div>`;
      if (loc.focalLength) html += `<div class="sbo-block"><div class="sbo-block-label">Tecnica consigliata</div><div class="sbo-block-text">${loc.focalLength}</div></div>`;
      if (loc.isoRange) html += `<div class="sbo-block"><div class="sbo-block-label">Composizione consigliata</div><div class="sbo-block-text">${loc.isoRange}</div></div>`;
      if (loc.antiMainstream) html += `<div class="sbo-block"><div class="sbo-block-label">↯ Anti-mainstream</div><div class="sbo-block-text">${loc.antiMainstream}</div></div>`;

      // Accesso e Stagione — griglia compatta
      const fields = [
        { label: 'Accesso', val: loc.access },
        { label: 'Difficoltà di avvicinamento', val: loc.avvicinamento },
      ].filter(f => f.val);

      if (fields.length) {
        html += `<div class="sbo-fields">`;
        fields.forEach(f => {
          html += `<div class="sbo-field"><div class="sbo-field-label">${f.label}</div><div class="sbo-field-val">${f.val}</div></div>`;
        });
        html += `</div>`;
      }

      // Annotazioni a mano
      loc.handnotes.forEach(note => {
        html += `<div class="sbo-handnote"><span>↳</span><span>${note}</span></div>`;
      });

      // Attrezzatura consigliata (statica, gestita dal CMS)
      if (loc.equipment && loc.equipment.length) {
        html += `<div class="sbo-equip-title">Attrezzatura</div>`;
        html += `<div class="sbo-equip-list">`;
        loc.equipment.forEach(item => {
          html += `<div class="sbo-equip-item"><span class="sbo-equip-box"></span><span class="sbo-equip-label">${item}</span></div>`;
        });
        html += `</div>`;
      }

      // Checklist CMS
      if (loc.checklist.length) {
        html += `<div class="sbo-checklist">`;
        loc.checklist.forEach(item => {
          html += `<div class="sbo-check"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7l3.5 3.5 6.5-6.5" stroke="#C4855A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>${item}</div>`;
        });
        html += `</div>`;
      }

      // Nota personale
      if (loc.personalNote) {
        html += `<div class="sbo-personal">★ ${loc.personalNote}</div>`;
      }

      // Coordinate copiabili + link Google Maps
      const coordText = loc.coordinates || `${loc.lat}, ${loc.lng}`;
      html += `<div class="sbo-coords-wrap">
        <span class="sbo-coords" id="sbo-coords-text">${coordText}</span>
        <button class="sbo-copy-btn" onclick="copyCoords('${coordText.replace(/'/g, "\\'")}', this)" title="Copia coordinate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13"><rect x="9" y="9" width="13" height="13" rx="1"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
        </button>
      </div>`;
      html += `<a class="sbo-gmaps" href="https://www.google.com/maps?q=${loc.lat},${loc.lng}" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        Apri in Google Maps
      </a>`;

      content.innerHTML = html;
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';

    };

    window.copyCoords = function(text, btn) {
      navigator.clipboard.writeText(text).then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1800);
      });
    };

    window.openLightbox = function(src, alt) {
      const lb = document.getElementById('sb-lightbox');
      const overlayOpen = document.getElementById('sb-overlay').classList.contains('is-open');
      document.getElementById('sb-lightbox-img').src = src;
      document.getElementById('sb-lightbox-img').alt = alt;
      document.getElementById('sb-lightbox-caption').textContent = alt;
      lb.classList.toggle('from-overlay', overlayOpen);
      lb.classList.add('is-open');
    };

    function closeLightbox() {
      document.getElementById('sb-lightbox').classList.remove('is-open');
    }

    document.getElementById('sb-lightbox-backdrop').addEventListener('click', closeLightbox);
    document.getElementById('sb-lightbox-close').addEventListener('click', closeLightbox);

    function closeOverlay() {
      closeLightbox();
      document.getElementById('sb-overlay').classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.getElementById('sb-overlay-backdrop').addEventListener('click', closeOverlay);
    document.getElementById('sb-overlay-close').addEventListener('click', closeOverlay);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (document.getElementById('sb-lightbox').classList.contains('is-open')) {
          closeLightbox();
        } else {
          closeOverlay();
        }
      }
    });

    let activeFilter = 'all';
    let searchQuery = '';

    function applyFilters() {
      let result = [...locations];
      if (activeFilter === 'saved') result = result.filter(l => isSaved(l.slug));
      else if (activeFilter !== 'all') result = result.filter(l => l.type === activeFilter || l.continent === activeFilter);
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        result = result.filter(l =>
          l.title.toLowerCase().includes(q) ||
          l.country.toLowerCase().includes(q) ||
          (l.region && l.region.toLowerCase().includes(q))
        );
      }
      renderMarkers(result);
      document.getElementById('bb-count').textContent = result.filter(l => l.status === 'published').length + ' location';
      document.getElementById('bb-panel-empty').style.display = 'flex';
      document.getElementById('bb-panel-content').style.display = 'none';
    }

    // Centri continentali per flyTo
    const continentViews = {
      'Africa':    { center: [5, 20],    zoom: 3 },
      'Europa':    { center: [52, 15],   zoom: 4 },
      'Asia':      { center: [35, 90],   zoom: 3 },
      'Americhe':  { center: [5, -75],   zoom: 3 },
      'Oceania':   { center: [-25, 135], zoom: 4 },
    };

    // Filtri chip
    document.querySelectorAll('.bb-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.bb-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        activeFilter = chip.dataset.filter;
        applyFilters();

        const view = continentViews[activeFilter];
        if (view) {
          const currentZoom = map.getZoom();
          map.flyTo(view.center, Math.min(currentZoom, view.zoom), { animate: true, duration: 1 });
        } else {
          map.flyTo([20, 20], 2, { animate: true, duration: 1 });
        }
      });
    });

    // Ricerca
    document.getElementById('bb-search').addEventListener('input', e => {
      searchQuery = e.target.value.trim();
      applyFilters();
    });

    // Navigazione pannello
    document.getElementById('bb-prev').addEventListener('click', () => {
      const published = filteredLocations.filter(l => l.status === 'published');
      const idx = published.indexOf(filteredLocations.find((l, i) => i === currentIndex));
      if (idx > 0) openPanel(filteredLocations.indexOf(published[idx - 1]), filteredLocations);
    });
    document.getElementById('bb-next').addEventListener('click', () => {
      const published = filteredLocations.filter(l => l.status === 'published');
      const idx = published.indexOf(filteredLocations.find((l, i) => i === currentIndex));
      if (idx < published.length - 1) openPanel(filteredLocations.indexOf(published[idx + 1]), filteredLocations);
    });
  </script>
)}

