---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

let currentUser: Awaited<ReturnType<typeof Astro.locals.currentUser>> = null;
try {
  currentUser = await Astro.locals.currentUser();
} catch (_) {}

if (!currentUser) {
  return Astro.redirect('/sign-in?redirect_url=/account');
}

const isPremium = !!(currentUser.publicMetadata?.isPremium);
const plan = (currentUser.publicMetadata?.plan as string) ?? null;
const purchasedSlugs = (currentUser.publicMetadata?.purchasedItinerari as string[]) ?? [];
const stripeCustomerId = (currentUser.publicMetadata?.stripeCustomerId as string) ?? null;

const tuttiItinerari = await getCollection('itinerari');
const itinerariAcquistati = tuttiItinerari.filter((it) => purchasedSlugs.includes(it.slug));

const userName = currentUser.firstName
  ? `${currentUser.firstName}${currentUser.lastName ? ' ' + currentUser.lastName : ''}`
  : null;
const userEmail = currentUser.emailAddresses?.[0]?.emailAddress ?? '';
const avatarUrl = currentUser.imageUrl ?? null;
const initiale = (userName || userEmail)[0].toUpperCase();
---

<BaseLayout title="Il mio account — Unmarked" description="Gestisci il tuo account Unmarked">

  <!-- HEADER DARK -->
  <div class="acc-hero">
    <div class="acc-hero-inner">
      <div class="acc-avatar">
        {avatarUrl
          ? <img src={avatarUrl} alt={userName || 'Avatar'} class="acc-avatar-img" />
          : <div class="acc-avatar-placeholder">{initiale}</div>
        }
      </div>
      <div class="acc-hero-info">
        <div class="acc-label">Account · Unmarked</div>
        {userName
          ? <h1 class="acc-name">{userName}</h1>
          : <h1 class="acc-name">{userEmail}</h1>
        }
        {userName && <div class="acc-email">{userEmail}</div>}
      </div>
      <div class="acc-hero-status">
        {isPremium
          ? <div class="acc-badge acc-badge-active">Abbonato</div>
          : <div class="acc-badge acc-badge-inactive">Free</div>
        }
      </div>
    </div>
  </div>

  <!-- CORPO -->
  <div class="acc-body">

    <!-- ABBONAMENTO -->
    <section class="acc-section">
      <div class="acc-section-label">Abbonamento</div>
      {isPremium ? (
        <div class="acc-plan-box acc-plan-active">
          <div class="acc-plan-top">
            <div>
              <div class="acc-plan-name">{plan === 'subscription' ? 'Piano mensile' : 'Accesso Premium'}</div>
              <div class="acc-plan-price">€29 / mese</div>
            </div>
            <div class="acc-plan-pill">Attivo</div>
          </div>
          <div class="acc-plan-desc">Accesso completo a tutti gli itinerari, allo Spotsbook e a ogni nuovo contenuto.</div>
          {stripeCustomerId && (
            <a
              href={`https://billing.stripe.com/p/login/test_28o3fF0Ym4MI3s4000?prefilled_email=${encodeURIComponent(userEmail)}`}
              class="acc-manage-link"
              target="_blank"
              rel="noopener"
            >
              Gestisci abbonamento →
            </a>
          )}
        </div>
      ) : (
        <div class="acc-plan-box acc-plan-inactive">
          <div class="acc-plan-name">Nessun abbonamento attivo</div>
          <div class="acc-plan-desc">Abbonati per accedere a tutti gli itinerari senza limiti e allo Spotsbook.</div>
          <div class="acc-plan-actions">
            <a href="/spotsbook" class="acc-cta-btn">Scopri lo Spotsbook</a>
            <a href="/itinerari" class="acc-cta-secondary">Vedi gli itinerari →</a>
          </div>
        </div>
      )}
    </section>

    <!-- ITINERARI ACQUISTATI -->
    {(itinerariAcquistati.length > 0) && (
      <section class="acc-section">
        <div class="acc-section-label">Itinerari acquistati</div>
        <div class="acc-it-list">
          {itinerariAcquistati.map((it) => (
            <a href={`/itinerari/${it.slug}`} class="acc-it-row">
              <div class="acc-it-img">
                <img src={it.data.coverImage.src} alt={it.data.coverImageAlt} />
              </div>
              <div class="acc-it-info">
                <div class="acc-it-tag">{it.data.country} · {it.data.duration} giorni</div>
                <div class="acc-it-title">{it.data.title}</div>
              </div>
              <div class="acc-it-arrow">→</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- LINK UTILI -->
    <section class="acc-section">
      <div class="acc-section-label">Esplora</div>
      <div class="acc-links">
        <a href="/spotsbook" class="acc-link-row">
          <span class="acc-link-title">Spotsbook</span>
          <span class="acc-link-sub">Location fotografiche segrete</span>
          <span class="acc-link-arrow">→</span>
        </a>
        <a href="/itinerari" class="acc-link-row">
          <span class="acc-link-title">Itinerari</span>
          <span class="acc-link-sub">Tutti i viaggi Unmarked</span>
          <span class="acc-link-arrow">→</span>
        </a>
        <a href="/film" class="acc-link-row">
          <span class="acc-link-title">Film</span>
          <span class="acc-link-sub">Documentari e cortometraggi</span>
          <span class="acc-link-arrow">→</span>
        </a>
      </div>
    </section>

    <!-- LOGOUT -->
    <section class="acc-section acc-section-last">
      <button class="acc-logout-btn" id="logout-btn">Esci dall'account</button>
    </section>

  </div>

  <script is:inline>
    document.getElementById('logout-btn').addEventListener('click', async function () {
      try {
        await window.Clerk.signOut();
        window.location.href = '/';
      } catch (e) {
        window.location.href = '/sign-in';
      }
    });
  </script>

</BaseLayout>

<style>
  /* HERO DARK */
  .acc-hero {
    background: #1A1814;
    padding: 56px 56px 48px;
    border-bottom: 1px solid rgba(201,185,154,0.12);
  }
  .acc-hero-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .acc-avatar-img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(201,185,154,0.2);
    flex-shrink: 0;
  }
  .acc-avatar-placeholder {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: none;
    border: 1px solid rgba(201,185,154,0.3);
    color: #C4855A;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    flex-shrink: 0;
  }
  .acc-hero-info { flex: 1; }
  .acc-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #C4855A;
    margin-bottom: 8px;
  }
  .acc-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 40px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1;
    margin-bottom: 4px;
  }
  .acc-email {
    font-size: 12px;
    font-weight: 300;
    color: rgba(250,250,248,0.35);
    letter-spacing: 0.04em;
  }
  .acc-hero-status { flex-shrink: 0; }
  .acc-badge {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 5px 14px;
  }
  .acc-badge-active { background: #C4855A; color: #fff; }
  .acc-badge-inactive { background: none; border: 1px solid rgba(201,185,154,0.3); color: rgba(250,250,248,0.4); }

  /* CORPO */
  .acc-body {
    max-width: 800px;
    margin: 0 auto;
    padding: 56px 56px 100px;
  }

  /* SEZIONI */
  .acc-section { margin-bottom: 56px; }
  .acc-section-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .acc-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(201,185,154,0.2);
  }
  .acc-section-last {
    padding-top: 16px;
    border-top: 1px solid rgba(201,185,154,0.15);
    margin-bottom: 0;
  }

  /* PIANO */
  .acc-plan-box {
    padding: 28px 32px;
    border: 1px solid rgba(201,185,154,0.2);
  }
  .acc-plan-active { background: rgba(201,185,154,0.04); }
  .acc-plan-inactive { background: transparent; }
  .acc-plan-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .acc-plan-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 300;
    color: var(--dark);
    margin-bottom: 2px;
  }
  .acc-plan-price {
    font-size: 11px;
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .acc-plan-pill {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: #C4855A;
    padding: 4px 12px;
  }
  .acc-plan-desc {
    font-size: 13px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .acc-manage-link {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terra);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .acc-manage-link:hover { opacity: 0.7; }
  .acc-plan-actions { display: flex; align-items: center; gap: 24px; }
  .acc-cta-btn {
    display: inline-block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: var(--terra);
    padding: 12px 28px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .acc-cta-btn:hover { opacity: 0.85; }
  .acc-cta-secondary {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--terra);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .acc-cta-secondary:hover { opacity: 0.7; }

  /* ITINERARI */
  .acc-it-list { display: flex; flex-direction: column; gap: 1px; background: rgba(201,185,154,0.15); }
  .acc-it-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 20px;
    background: #FAFAF8;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .acc-it-row:hover { background: rgba(201,185,154,0.08); }
  .acc-it-img { width: 64px; height: 46px; overflow: hidden; flex-shrink: 0; }
  .acc-it-img img { width: 100%; height: 100%; object-fit: cover; }
  .acc-it-info { flex: 1; }
  .acc-it-tag {
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 3px;
  }
  .acc-it-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 300;
    color: var(--dark);
  }
  .acc-it-arrow { color: var(--muted); font-size: 14px; flex-shrink: 0; }

  /* LINK ESPLORA */
  .acc-links { display: flex; flex-direction: column; gap: 1px; background: rgba(201,185,154,0.15); }
  .acc-link-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    background: #FAFAF8;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .acc-link-row:hover { background: rgba(201,185,154,0.08); }
  .acc-link-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 300;
    color: var(--dark);
    min-width: 100px;
  }
  .acc-link-sub {
    font-size: 11px;
    font-weight: 300;
    color: var(--muted);
    flex: 1;
  }
  .acc-link-arrow { font-size: 13px; color: var(--muted); }

  /* LOGOUT */
  .acc-logout-btn {
    background: none;
    border: 1px solid rgba(201,185,154,0.3);
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 11px 24px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .acc-logout-btn:hover {
    border-color: var(--dark);
    color: var(--dark);
  }

  @media (max-width: 768px) {
    .acc-hero { padding: 40px 24px 36px; }
    .acc-hero-inner { flex-wrap: wrap; gap: 20px; }
    .acc-hero-status { order: -1; margin-left: auto; }
    .acc-name { font-size: 32px; }
    .acc-body { padding: 40px 24px 80px; }
    .acc-plan-box { padding: 20px; }
    .acc-plan-top { flex-direction: column; gap: 12px; }
    .acc-plan-actions { flex-direction: column; align-items: flex-start; }
    .acc-link-sub { display: none; }
  }
</style>
