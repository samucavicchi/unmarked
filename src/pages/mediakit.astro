---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Media Kit — Unmarked"
  description="Collabora con Unmarked. Reportage fotografici, itinerari premium e storytelling di viaggio."
  ogImage="/about-hero.jpg"
>

  <!-- HERO -->
  <section class="mk-hero">
    <div class="mk-hero-bg" style="background-image:url('/about-hero.jpg')"></div>
    <div class="mk-hero-overlay"></div>
    <div class="mk-hero-content">
      <div class="mk-hero-tag">Media Kit · 2026</div>
      <h1 class="mk-hero-title">I luoghi che non trovi<br/>sulle guide.</h1>
      <p class="mk-hero-sub">Reportage fotografici, itinerari premium e storytelling autentico per chi vuole scoprire il mondo oltre le rotte battute.</p>
    </div>
  </section>

  <!-- CHI SIAMO -->
  <section class="mk-section mk-about">
    <div class="mk-inner">
      <div class="mk-label">Chi siamo</div>
      <div class="mk-about-grid">
        <div class="mk-person">
          <div class="mk-person-photo" style="background-image:url('/samuele.jpg')"></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Samuele Cavicchi</div>
            <div class="mk-person-role">Fotografo naturalista & direttore creativo</div>
            <p class="mk-person-bio">Vent'anni di fotografia naturalistica e di reportage. Porta in ogni viaggio uno sguardo allenato a trovare quello che gli altri non vedono — la luce giusta, il momento nascosto, la storia autentica.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">63.2K</div><div class="mk-stat-label">Follower Instagram</div></div>
              <div class="mk-stat"><div class="mk-stat-num">233K</div><div class="mk-stat-label">Visualizzazioni medie</div></div>
            </div>
          </div>
        </div>
        <div class="mk-person">
          <div class="mk-person-photo" style="background-image:url('/alice.jpg')"></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Alice</div>
            <div class="mk-person-role">Storyteller & travel curator</div>
            <p class="mk-person-bio">Viaggiatrice da sempre, con una passione per i luoghi autentici e le storie che non finiscono nelle brochure. Trasforma ogni destinazione in un racconto preciso, onesto e capace di ispirare.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">15.4K</div><div class="mk-stat-label">Follower Instagram</div></div>
              <div class="mk-stat"><div class="mk-stat-num">150K</div><div class="mk-stat-label">Visualizzazioni medie</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMERI -->
  <section class="mk-section mk-numbers">
    <div class="mk-inner">
      <div class="mk-label mk-label-light">La nostra reach</div>
      <div class="mk-numbers-grid">
        <div class="mk-num-item">
          <div class="mk-num-val">78.6K</div>
          <div class="mk-num-desc">Follower totali Instagram</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">383K</div>
          <div class="mk-num-desc">Views medie mensili</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">1.000+</div>
          <div class="mk-num-desc">Iscritti newsletter</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">50%+</div>
          <div class="mk-num-desc">Audience italiana</div>
        </div>
      </div>
      <div class="mk-audience-note">
        Il restante pubblico è distribuito tra le principali nazioni europee — Germania, Francia, Spagna, UK, Svizzera, Paesi Bassi.
        Un'audience colta, curiosa, con alto potere d'acquisto e propensione al viaggio premium.
      </div>
    </div>
  </section>

  <!-- COLLABORAZIONI -->
  <section class="mk-section mk-collabs">
    <div class="mk-inner">
      <div class="mk-label">Hanno già scelto Unmarked</div>
      <div class="mk-collabs-grid">
        <div class="mk-brand-item"><img src="/loghi/mazda.svg" alt="Mazda" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/nikon.svg" alt="Nikon" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/dji.svg" alt="DJI" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/hellyhansen.svg" alt="Helly Hansen" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/hamilton.svg" alt="Hamilton" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/NOMATIC.png" alt="Nomatic" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/Suunto-Logo.png" alt="Suunto" class="mk-logo" /></div>
        <div class="mk-brand-item"><img src="/loghi/BASECAMP.png" alt="Basecamp Explore" class="mk-logo" /></div>
        <div class="mk-brand-item mk-brand-text">Four Seasons</div>
        <div class="mk-brand-item mk-brand-text">Explore Namibia</div>
        <div class="mk-brand-item mk-brand-text mk-brand-muted">+ strutture partner</div>
      </div>
    </div>
  </section>

  <!-- COSA OFFRIAMO -->
  <section class="mk-section mk-offer">
    <div class="mk-inner">
      <div class="mk-label">Cosa possiamo fare insieme</div>
      <div class="mk-offer-grid">
        <div class="mk-offer-item">
          <div class="mk-offer-num">01</div>
          <div class="mk-offer-name">Reportage fotografico</div>
          <p class="mk-offer-desc">Racconto visivo autentico della destinazione, dell'esperienza o del prodotto. Fotografia d'autore, non stock. Consegna file ad alta risoluzione + licenza d'uso.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">02</div>
          <div class="mk-offer-name">Itinerario editoriale</div>
          <p class="mk-offer-desc">Guida premium sulla piattaforma Unmarked, con la destinazione o l'esperienza integrata nel percorso. Accesso diretto a un pubblico di viaggiatori qualificati.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">03</div>
          <div class="mk-offer-name">Contenuti social</div>
          <p class="mk-offer-desc">Post, reel e stories su Instagram. Stile editoriale coerente con il brand Unmarked — mai patinato, sempre autentico. Reach combinata 78K+ follower.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">04</div>
          <div class="mk-offer-name">Newsletter dedicata</div>
          <p class="mk-offer-desc">Menzione o articolo dedicato nella newsletter Unmarked, inviata a 1.000+ abbonati attivi. Audience altamente fidelizzata e orientata al viaggio premium.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">05</div>
          <div class="mk-offer-name">Podcast</div>
          <p class="mk-offer-desc">Episodio dedicato o menzione nel podcast Unmarked. Storytelling autentico della destinazione o dell'esperienza, senza formati pubblicitari tradizionali.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">06</div>
          <div class="mk-offer-name">Pacchetti integrati</div>
          <p class="mk-offer-desc">Combinazione di più formati per una presenza editoriale completa — dalla foto al testo, dai social alla newsletter, pensata per massimizzare l'impatto.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA CONTATTI -->
  <section class="mk-cta">
    <div class="mk-cta-inner">
      <div class="mk-label mk-label-light">Lavoriamo insieme</div>
      <h2 class="mk-cta-title">Raccontiamo il tuo<br/>posto nel mondo.</h2>
      <p class="mk-cta-sub">Se stai cercando un racconto autentico, fotografia d'autore e un pubblico che ama davvero viaggiare — siamo quelli giusti.</p>
      <a href="mailto:samu.cavicchi@gmail.com" class="mk-cta-btn">Scrivici</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .mk-hero {
    position: relative;
    height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .mk-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
  }
  .mk-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,24,20,0.9) 0%, rgba(26,24,20,0.4) 60%, rgba(26,24,20,0.1) 100%);
  }
  .mk-hero-content {
    position: relative;
    padding: 56px 56px;
    max-width: 860px;
  }
  .mk-hero-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 20px;
  }
  .mk-hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1.05;
    margin: 0 0 20px;
  }
  .mk-hero-sub {
    font-size: 15px;
    font-weight: 300;
    color: rgba(250,250,248,0.7);
    line-height: 1.7;
    max-width: 560px;
    margin: 0;
  }

  /* LAYOUT */
  .mk-section { padding: 80px 0; }
  .mk-inner { max-width: 1100px; margin: 0 auto; padding: 0 56px; }
  .mk-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mk-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--terra); }
  .mk-label-light { color: var(--sand); }
  .mk-label-light::before { background: var(--sand); }

  /* CHI SIAMO */
  .mk-about { background: var(--cream); }
  .mk-about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
  .mk-person { display: flex; flex-direction: column; gap: 24px; }
  .mk-person-photo {
    height: 340px;
    border-radius: 3px;
    background-size: cover;
    background-position: center top;
  }
  .mk-person-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 300;
    color: var(--dark);
    margin-bottom: 4px;
  }
  .mk-person-role {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 14px;
  }
  .mk-person-bio {
    font-size: 14px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 20px;
  }
  .mk-person-stats { display: flex; gap: 32px; }
  .mk-stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
  }
  .mk-stat-label {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* NUMERI */
  .mk-numbers { background: var(--dark); }
  .mk-numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid rgba(201,185,154,0.15);
    border-bottom: 1px solid rgba(201,185,154,0.15);
    margin-bottom: 32px;
  }
  .mk-num-item {
    padding: 40px 32px;
    border-right: 1px solid rgba(201,185,154,0.15);
  }
  .mk-num-item:last-child { border-right: none; }
  .mk-num-val {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1;
    margin-bottom: 10px;
  }
  .mk-num-desc {
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250,250,248,0.45);
  }
  .mk-audience-note {
    font-size: 13px;
    font-weight: 300;
    color: rgba(250,250,248,0.5);
    line-height: 1.75;
    max-width: 680px;
  }

  /* COLLABORAZIONI */
  .mk-collabs { background: #fff; border-top: 1px solid var(--light-border); }
  .mk-collabs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--light-border);
    border-radius: 3px;
    overflow: hidden;
  }
  .mk-brand-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    border-right: 1px solid var(--light-border);
    border-bottom: 1px solid var(--light-border);
    min-height: 90px;
    background: #fff;
  }
  .mk-brand-item:nth-child(4n) { border-right: none; }
  .mk-brand-item:nth-last-child(-n+3) { border-bottom: none; }
  .mk-logo {
    max-width: 130px;
    max-height: 44px;
    width: auto;
    height: auto;
    filter: grayscale(1) opacity(0.65);
    mix-blend-mode: multiply;
    transition: filter 0.2s;
  }
  .mk-brand-item:hover .mk-logo { filter: grayscale(1) opacity(1); }
  .mk-brand-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 300;
    color: var(--dark);
    letter-spacing: 0.03em;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .mk-brand-item:hover .mk-brand-text { opacity: 1; }
  .mk-brand-muted .mk-brand-text,
  .mk-brand-muted { opacity: 0.4; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; }

  /* COSA OFFRIAMO */
  .mk-offer { background: var(--cream); }
  .mk-offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .mk-offer-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 40px;
    font-weight: 300;
    color: var(--beige);
    line-height: 1;
    margin-bottom: 12px;
  }
  .mk-offer-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--dark);
    margin-bottom: 10px;
    letter-spacing: 0.02em;
  }
  .mk-offer-desc {
    font-size: 13px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.75;
    margin: 0;
  }

  /* CTA */
  .mk-cta {
    background: var(--dark);
    padding: 100px 56px;
    text-align: center;
  }
  .mk-cta-inner { max-width: 640px; margin: 0 auto; }
  .mk-cta .mk-label { justify-content: center; }
  .mk-cta .mk-label::before { display: none; }
  .mk-cta-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .mk-cta-sub {
    font-size: 14px;
    font-weight: 300;
    color: rgba(250,250,248,0.5);
    line-height: 1.75;
    margin-bottom: 40px;
  }
  .mk-cta-btn {
    display: inline-block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: var(--terra);
    color: #fff;
    padding: 16px 36px;
    border-radius: 2px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .mk-cta-btn:hover { opacity: 0.85; }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .mk-hero-content { padding: 32px 20px; }
    .mk-hero-title { font-size: 38px; }
    .mk-inner { padding: 0 20px; }
    .mk-about-grid { grid-template-columns: 1fr; gap: 48px; }
    .mk-numbers-grid { grid-template-columns: 1fr 1fr; }
    .mk-num-item { padding: 28px 20px; }
    .mk-num-val { font-size: 38px; }
    .mk-offer-grid { grid-template-columns: 1fr; gap: 32px; }
    .mk-brand { flex: 1 1 50%; }
    .mk-cta { padding: 60px 20px; }
    .mk-cta-title { font-size: 36px; }
    .mk-person-stats { gap: 20px; }
  }
</style>
