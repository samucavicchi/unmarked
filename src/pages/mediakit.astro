---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Media Kit — Unmarked"
  description="Collabora con Unmarked. Reportage fotografici, itinerari premium e storytelling di viaggio."
  ogImage="/about-hero.jpg"
>

  <!-- HERO -->
  <section class="mk-hero">
    <div class="mk-hero-bg" style="background-image:url('/about-hero.jpg')"></div>
    <div class="mk-hero-overlay"></div>
    <div class="mk-hero-content">
      <div class="mk-hero-tag">Media Kit · 2026</div>
      <h1 class="mk-hero-title">I luoghi che non trovi<br/>sulle guide.</h1>
      <p class="mk-hero-sub">Reportage fotografici, itinerari premium e storytelling autentico per chi vuole scoprire il mondo oltre le rotte battute.</p>
    </div>
  </section>

  <!-- CHI SIAMO -->
  <section class="mk-section mk-about">
    <div class="mk-inner">
      <div class="mk-label">Chi siamo</div>
      <div class="mk-about-grid">
        <div class="mk-person">
          <div class="mk-person-photo" style="background-image:url('/samuele.jpg')"></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Samuele Cavicchi</div>
            <div class="mk-person-role">Fotografo naturalista & direttore creativo</div>
            <a href="https://instagram.com/samuele_cavicchi" target="_blank" rel="noopener" class="mk-person-ig">
              <svg class="mk-ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              @samuele_cavicchi
            </a>
            <p class="mk-person-bio">Vent'anni di fotografia naturalistica e di reportage. Porta in ogni viaggio uno sguardo allenato a trovare quello che gli altri non vedono — la luce giusta, il momento nascosto, la storia autentica.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">63.2K</div><div class="mk-stat-label">Follower Instagram</div></div>
              <div class="mk-stat"><div class="mk-stat-num">233K</div><div class="mk-stat-label">Visualizzazioni medie</div></div>
            </div>
          </div>
        </div>
        <div class="mk-person">
          <div class="mk-person-photo" style="background-image:url('/alice.jpg')"></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Alice</div>
            <div class="mk-person-role">Storyteller & travel curator</div>
            <a href="https://instagram.com/poli_alice_" target="_blank" rel="noopener" class="mk-person-ig">
              <svg class="mk-ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              @poli_alice_
            </a>
            <p class="mk-person-bio">Viaggiatrice da sempre, con una passione per i luoghi autentici e le storie che non finiscono nelle brochure. Trasforma ogni destinazione in un racconto preciso, onesto e capace di ispirare.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">15.4K</div><div class="mk-stat-label">Follower Instagram</div></div>
              <div class="mk-stat"><div class="mk-stat-num">150K</div><div class="mk-stat-label">Visualizzazioni medie</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMERI -->
  <section class="mk-section mk-numbers">
    <div class="mk-inner">
      <div class="mk-label mk-label-light">La nostra reach</div>
      <div class="mk-numbers-grid">
        <div class="mk-num-item">
          <div class="mk-num-val">78.6K</div>
          <div class="mk-num-desc">Follower totali Instagram</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">383K</div>
          <div class="mk-num-desc">Views medie mensili</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">1.000+</div>
          <div class="mk-num-desc">Iscritti newsletter</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">50%+</div>
          <div class="mk-num-desc">Audience italiana</div>
        </div>
      </div>
      <div class="mk-audience-note">
        Il restante pubblico è distribuito tra le principali nazioni europee — Germania, Francia, Spagna, UK, Svizzera, Paesi Bassi.
        Un'audience colta, curiosa, con alto potere d'acquisto e propensione al viaggio premium.
      </div>
    </div>
  </section>

  <!-- COLLABORAZIONI -->
  <section class="mk-section mk-collabs">
    <div class="mk-inner">
      <div class="mk-label">Hanno già scelto Unmarked</div>
      <div class="mk-marquee-wrap">
        <div class="mk-marquee-track">
          <div class="mk-brand-item"><img src="/loghi/mazda.svg" alt="Mazda" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/nikon.svg" alt="Nikon" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/dji.svg" alt="DJI" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hellyhansen.svg" alt="Helly Hansen" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hamilton.svg" alt="Hamilton" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/NOMATIC.png" alt="Nomatic" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Suunto-Logo.png" alt="Suunto" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/BASECAMP.png" alt="Basecamp Explore" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/fourseasons.png" alt="Four Seasons" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Logo_explore_namibia_header02.png" alt="Explore Namibia" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/rangerover logo.png" alt="Range Rover" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/ascocar.png" alt="Asco Car" class="mk-logo" /></div>
          <div class="mk-brand-item mk-brand-plus">100+<span>strutture partner</span></div>
          <!-- Duplicati per loop infinito -->
          <div class="mk-brand-item"><img src="/loghi/mazda.svg" alt="Mazda" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/nikon.svg" alt="Nikon" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/dji.svg" alt="DJI" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hellyhansen.svg" alt="Helly Hansen" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hamilton.svg" alt="Hamilton" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/NOMATIC.png" alt="Nomatic" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Suunto-Logo.png" alt="Suunto" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/BASECAMP.png" alt="Basecamp Explore" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/fourseasons.png" alt="Four Seasons" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Logo_explore_namibia_header02.png" alt="Explore Namibia" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/rangerover logo.png" alt="Range Rover" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/ascocar.png" alt="Asco Car" class="mk-logo" /></div>
          <div class="mk-brand-item mk-brand-plus">100+<span>strutture partner</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- REEL -->
  <section class="mk-section mk-reels">
    <div class="mk-inner">
      <div class="mk-label">Il nostro lavoro, sui loro canali</div>
      <p class="mk-reels-intro">Contenuti pubblicati direttamente dai brand sui loro profili ufficiali Instagram. Perché il risultato finale è quello che conta.</p>
      <div class="mk-reels-grid">

        <a href="https://www.instagram.com/reel/DWbEpc3AAMP/" target="_blank" rel="noopener" class="mk-reel-card">
          <div class="mk-reel-cover" style="background-image:url('/reel-covers/mazda-1.jpg')">
            <div class="mk-reel-overlay"></div>
            <div class="mk-reel-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div class="mk-reel-ig">
              <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
            </div>
          </div>
          <div class="mk-reel-meta">
            <div class="mk-reel-brand">Mazda Europe</div>
            <div class="mk-reel-handle">@mazdaeurope</div>
          </div>
        </a>

        <a href="https://www.instagram.com/reel/C66WnGVokcN/" target="_blank" rel="noopener" class="mk-reel-card">
          <div class="mk-reel-cover" style="background-image:url('/reel-covers/mazda-2.jpg')">
            <div class="mk-reel-overlay"></div>
            <div class="mk-reel-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div class="mk-reel-ig">
              <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
            </div>
          </div>
          <div class="mk-reel-meta">
            <div class="mk-reel-brand">Mazda Europe</div>
            <div class="mk-reel-handle">@mazdaeurope</div>
          </div>
        </a>

        <a href="https://www.instagram.com/reel/DYe4siMEfjt/" target="_blank" rel="noopener" class="mk-reel-card">
          <div class="mk-reel-cover" style="background-image:url('/reel-covers/nikon.jpg')">
            <div class="mk-reel-overlay"></div>
            <div class="mk-reel-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div class="mk-reel-ig">
              <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
            </div>
          </div>
          <div class="mk-reel-meta">
            <div class="mk-reel-brand">Nikon Europe</div>
            <div class="mk-reel-handle">@nikoneurope</div>
          </div>
        </a>

        <a href="https://www.instagram.com/reel/DL4odqiIgFd/" target="_blank" rel="noopener" class="mk-reel-card">
          <div class="mk-reel-cover" style="background-image:url('/reel-covers/asus.jpg')">
            <div class="mk-reel-overlay"></div>
            <div class="mk-reel-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div class="mk-reel-ig">
              <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
            </div>
          </div>
          <div class="mk-reel-meta">
            <div class="mk-reel-brand">ASUS Italia</div>
            <div class="mk-reel-handle">@asusitalia</div>
          </div>
        </a>

        <a href="https://www.instagram.com/reel/DMQWifqo-t2/" target="_blank" rel="noopener" class="mk-reel-card">
          <div class="mk-reel-cover" style="background-image:url('/reel-covers/lexar.jpg')">
            <div class="mk-reel-overlay"></div>
            <div class="mk-reel-play">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <div class="mk-reel-ig">
              <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
            </div>
          </div>
          <div class="mk-reel-meta">
            <div class="mk-reel-brand">Lexar</div>
            <div class="mk-reel-handle">@lexarmemory</div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- COSA OFFRIAMO -->
  <section class="mk-section mk-offer">
    <div class="mk-inner">
      <div class="mk-label">Cosa possiamo fare insieme</div>
      <div class="mk-offer-grid">
        <div class="mk-offer-item">
          <div class="mk-offer-num">01</div>
          <div class="mk-offer-name">Pacchetto contenuti fotografici e video</div>
          <p class="mk-offer-desc">Ti consegniamo un archivio di fotografie e video ad alta risoluzione — pronti per l'uso sui tuoi canali social, sito e materiali di comunicazione. Contenuti d'autore, coerenti con il tuo brand, realizzati sul campo. Non stock, non generici: immagini che raccontano davvero quello che fai.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">02</div>
          <div class="mk-offer-name">Visibilità sui nostri social</div>
          <p class="mk-offer-desc">Post e reel in collaborazione sui profili Unmarked — 78K+ follower, un'audience colta, curiosa, con alta propensione al viaggio e agli acquisti premium. Il formato collab di Instagram porta il tuo brand direttamente nel feed di entrambe le community. Niente pubblicità, solo racconto autentico.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">03</div>
          <div class="mk-offer-name">Short film dedicato</div>
          <p class="mk-offer-desc">Un film breve, con la cura visiva e narrativa dei nostri documentari, costruito attorno alla tua destinazione o esperienza. Non uno spot — una storia. Il tipo di contenuto che le persone guardano fino alla fine, salvano, condividono. E che rimane.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">04</div>
          <div class="mk-offer-name">Articolo e newsletter dedicati</div>
          <p class="mk-offer-desc">Un racconto editoriale completo sulla piattaforma Unmarked e una newsletter dedicata agli abbonati. Parole scelte, nessuna retorica da brochure. Il tuo progetto presentato a una community di lettori che legge davvero — e che si fida di quello che consigliamo.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">05</div>
          <div class="mk-offer-name">Product placement nei documentari</div>
          <p class="mk-offer-desc">Se il tuo progetto si intreccia con uno dei nostri documentari in produzione, possiamo costruire insieme una presenza naturale e integrata nel film — product placement, menzioni come partner, presenza nei credits. Il modo più efficace per raggiungere un pubblico che ha scelto di sedersi ad ascoltare.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">06</div>
          <div class="mk-offer-name">Pacchetti su misura</div>
          <p class="mk-offer-desc">Ogni progetto è diverso. Se hai un obiettivo specifico — lancio, awareness, racconto di territorio, campagna stagionale — costruiamo insieme la combinazione di formati più efficace. Dalla foto al film, dai social alla newsletter: un ecosistema di contenuti pensato per durare, non per sparire in 24 ore.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA CONTATTI -->
  <section class="mk-cta">
    <div class="mk-cta-inner">
      <div class="mk-label mk-label-light">Lavoriamo insieme</div>
      <h2 class="mk-cta-title">Raccontiamo il tuo<br/>posto nel mondo.</h2>
      <p class="mk-cta-sub">Se stai cercando un racconto autentico, fotografia d'autore e un pubblico che ama davvero viaggiare — siamo quelli giusti.</p>
      <a href="mailto:samu.cavicchi@gmail.com" class="mk-cta-btn">Scrivici</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .mk-hero {
    position: relative;
    height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .mk-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
  }
  .mk-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,24,20,0.9) 0%, rgba(26,24,20,0.4) 60%, rgba(26,24,20,0.1) 100%);
  }
  .mk-hero-content {
    position: relative;
    padding: 56px 56px;
    max-width: 860px;
  }
  .mk-hero-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 20px;
  }
  .mk-hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1.05;
    margin: 0 0 20px;
  }
  .mk-hero-sub {
    font-size: 15px;
    font-weight: 300;
    color: rgba(250,250,248,0.7);
    line-height: 1.7;
    max-width: 560px;
    margin: 0;
  }

  /* LAYOUT */
  .mk-section { padding: 80px 0; }
  .mk-inner { max-width: 1100px; margin: 0 auto; padding: 0 56px; }
  .mk-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mk-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--terra); }
  .mk-label-light { color: var(--sand); }
  .mk-label-light::before { background: var(--sand); }

  /* CHI SIAMO */
  .mk-about { background: var(--cream); }
  .mk-about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
  .mk-person { display: flex; flex-direction: column; gap: 24px; }
  .mk-person-photo {
    height: 340px;
    border-radius: 3px;
    background-size: cover;
    background-position: center top;
  }
  .mk-person-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 300;
    color: var(--dark);
    margin-bottom: 4px;
  }
  .mk-person-role {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 14px;
  }
  .mk-person-ig {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--terra);
    text-decoration: none;
    margin-bottom: 14px;
    transition: opacity 0.2s;
  }
  .mk-person-ig:hover { opacity: 0.7; }
  .mk-ig-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .mk-person-bio {
    font-size: 14px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 20px;
  }
  .mk-person-stats { display: flex; gap: 32px; }
  .mk-stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
  }
  .mk-stat-label {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* NUMERI */
  .mk-numbers { background: var(--dark); }
  .mk-numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid rgba(201,185,154,0.15);
    border-bottom: 1px solid rgba(201,185,154,0.15);
    margin-bottom: 32px;
  }
  .mk-num-item {
    padding: 40px 32px;
    border-right: 1px solid rgba(201,185,154,0.15);
  }
  .mk-num-item:last-child { border-right: none; }
  .mk-num-val {
    font-family: 'Cormorant Garamond', serif;
    font-size: 52px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1;
    margin-bottom: 10px;
  }
  .mk-num-desc {
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250,250,248,0.45);
  }
  .mk-audience-note {
    font-size: 13px;
    font-weight: 300;
    color: rgba(250,250,248,0.5);
    line-height: 1.75;
    max-width: 680px;
  }

  /* COLLABORAZIONI */
  .mk-collabs { background: var(--cream); }
  .mk-marquee-wrap {
    overflow: hidden;
    position: relative;
    /* fade sui lati */
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .mk-marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee 45s linear infinite;
  }
  .mk-marquee-track:hover { animation-play-state: paused; }
  .mk-brand-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 40px;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .mk-brand-item:hover { opacity: 1; }
