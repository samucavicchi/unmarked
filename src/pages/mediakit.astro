---
import BaseLayout from '../layouts/BaseLayout.astro';
import { mediakitData as d } from '../data/mediakit-data';
---

<BaseLayout
  title="Media Kit — Unmarked"
  description="Collabora con Unmarked. Reportage fotografici, itinerari premium e storytelling di viaggio."
  ogImage={d.heroImage}
>

  <!-- HERO -->
  <section class="mk-hero">
    <div class="mk-hero-bg" style={`background-image:url('${d.heroImage}')`}></div>
    <div class="mk-hero-overlay"></div>
    <div class="mk-hero-content">
      <div class="mk-hero-tag">Media Kit · {d.year}</div>
      <h1 class="mk-hero-title">Scopri il mondo<br/>con noi.</h1>
      <p class="mk-hero-sub">Diamo valore al tuo mondo con le nostre immagini, creiamo, raccontiamo, facciamo scoprire.</p>
    </div>
  </section>

  <!-- CHI SIAMO -->
  <section class="mk-section mk-about">
    <div class="mk-inner">
      <div class="mk-label">Chi siamo</div>
      <div class="mk-about-grid">
        <div class="mk-person">
          <div class="mk-person-photo" style={`background-image:url('${d.samuele.photo}')`}></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Samuele Cavicchi</div>
            <div class="mk-person-role">Fotografo naturalista & direttore creativo</div>
            <a href={d.samuele.igUrl} target="_blank" rel="noopener" class="mk-person-ig">
              <svg class="mk-ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              {d.samuele.igHandle}
            </a>
            <p class="mk-person-bio">Vent'anni di fotografia naturalistica e di reportage. Porta in ogni viaggio uno sguardo allenato a trovare quello che gli altri non vedono — la luce giusta, il momento nascosto, la storia autentica.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">{d.samuele.followers}</div><div class="mk-stat-label">Follower Instagram</div></div>
              <div class="mk-stat"><div class="mk-stat-num">{d.samuele.avgViews}</div><div class="mk-stat-label">Visualizzazioni medie</div></div>
            </div>
          </div>
        </div>
        <div class="mk-person">
          <div class="mk-person-photo" style={`background-image:url('${d.alice.photo}')`}></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Alice</div>
            <div class="mk-person-role">Storyteller & travel curator</div>
            <a href={d.alice.igUrl} target="_blank" rel="noopener" class="mk-person-ig">
              <svg class="mk-ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              {d.alice.igHandle}
            </a>
            <p class="mk-person-bio">Viaggiatrice da sempre, con una passione per i luoghi autentici e le storie che non finiscono nelle brochure. Trasforma ogni destinazione in un racconto preciso, onesto e capace di ispirare.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">{d.alice.followers}</div><div class="mk-stat-label">Follower Instagram</div></div>
              <div class="mk-stat"><div class="mk-stat-num">{d.alice.avgViews}</div><div class="mk-stat-label">Visualizzazioni medie</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMERI -->
  <section class="mk-section mk-numbers">
    <div class="mk-inner">
      <div class="mk-label mk-label-light">La nostra reach</div>
      <div class="mk-numbers-grid">
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.totalFollowers}</div>
          <div class="mk-num-desc">Follower totali Instagram</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.monthlyViews}</div>
          <div class="mk-num-desc">Views medie mensili</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.newsletter}</div>
          <div class="mk-num-desc">Iscritti newsletter</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.italianAudience}</div>
          <div class="mk-num-desc">Audience italiana</div>
        </div>
      </div>
      <div class="mk-audience-note">
        Il restante pubblico è distribuito tra le principali nazioni europee — Germania, Francia, Spagna, UK, Svizzera, Paesi Bassi.
        Un'audience colta, curiosa, con alto potere d'acquisto e propensione al viaggio premium.
      </div>
    </div>
  </section>

  <!-- AUDIENCE -->
  <section class="mk-section mk-audience">
    <div class="mk-inner">
      <div class="mk-label">Chi ci segue</div>
      <div class="mk-audience-grid">
        <div class="mk-aud-block">
          <div class="mk-aud-title">Fascia d'età principale</div>
          <div class="mk-aud-bar-wrap">
            {d.ageGroups.map(g => (
              <div class={`mk-aud-bar-row${g.highlight ? ' mk-aud-highlight' : ''}`}>
                <span class="mk-aud-age">{g.label}</span>
                <div class="mk-aud-bar"><div class="mk-aud-fill" style={`width:${g.pct}%`}></div></div>
                <span class="mk-aud-pct">{g.pct}%</span>
              </div>
            ))}
          </div>
          <p class="mk-aud-note">Il core audience — 25–44 anni — rappresenta il 70% della community. Adulti con capacità di spesa, abituati a scegliere esperienze di qualità.</p>
        </div>
        <div class="mk-aud-block">
          <div class="mk-aud-title">Distribuzione geografica</div>
          <div class="mk-geo-list">
            {d.geoGroups.map(g => (
              <div class={`mk-geo-row${g.main ? ' mk-geo-main' : ''}`}>
                <span class="mk-geo-country">{g.country}</span>
                <div class="mk-aud-bar"><div class={`mk-aud-fill${g.main ? '' : ' mk-aud-fill-light'}`} style={`width:${g.pct}%`}></div></div>
                {g.main && <span class="mk-aud-pct">{g.pct}%+</span>}
              </div>
            ))}
          </div>
        </div>
        <div class="mk-aud-block">
          <div class="mk-aud-title">Interessi</div>
          <div class="mk-tags">
            <span class="mk-tag">Viaggi</span>
            <span class="mk-tag">Natura</span>
            <span class="mk-tag">Fotografia</span>
            <span class="mk-tag">Avventura</span>
            <span class="mk-tag">Wildlife</span>
            <span class="mk-tag">Outdoor</span>
            <span class="mk-tag">Documentari</span>
            <span class="mk-tag">Sostenibilità</span>
          </div>
          <p class="mk-aud-note">Un pubblico che non subisce i contenuti — li cerca. Alto tasso di salvataggio, condivisione e interazione rispetto alla media dei profili travel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COLLABORAZIONI -->
  <section class="mk-section mk-collabs">
    <div class="mk-inner">
      <div class="mk-label">Hanno già scelto Unmarked</div>
      <div class="mk-marquee-wrap">
        <div class="mk-marquee-track">
          <div class="mk-brand-item"><img src="/loghi/mazda.svg" alt="Mazda" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/nikon.svg" alt="Nikon" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/dji.svg" alt="DJI" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hellyhansen.svg" alt="Helly Hansen" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hamilton.svg" alt="Hamilton" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/NOMATIC.png" alt="Nomatic" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Suunto-Logo.png" alt="Suunto" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/BASECAMP.png" alt="Basecamp Explore" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/fourseasons.png" alt="Four Seasons" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Logo_explore_namibia_header02.png" alt="Explore Namibia" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/rangerover logo.png" alt="Range Rover" class="mk-logo mk-logo-wide" /></div>
          <div class="mk-brand-item"><img src="/loghi/ascocar.png" alt="Asco Car" class="mk-logo" /></div>
          <div class="mk-brand-item mk-brand-plus">100+<span>strutture partner</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- REEL -->
  <section class="mk-section mk-reels">
    <div class="mk-inner">
      <div class="mk-label">Il nostro lavoro, sui loro canali</div>
      <p class="mk-reels-intro">Contenuti pubblicati direttamente dai brand sui loro profili ufficiali Instagram. Perché il risultato finale è quello che conta.</p>
      <div class="mk-reels-grid">

        {d.reels.map(reel => (
          <a href={reel.url} class="mk-reel-card" data-reel={reel.url}>
            <div class="mk-reel-cover" style={`background-image:url('${reel.cover}')`}>
              <div class="mk-reel-overlay"></div>
              <div class="mk-reel-play">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="mk-reel-ig">
                <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
              </div>
            </div>
            <div class="mk-reel-meta">
              <div class="mk-reel-brand">{reel.brand}</div>
              <div class="mk-reel-handle">{reel.handle}</div>
            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <!-- COSA OFFRIAMO -->
  <section class="mk-section mk-offer">
    <div class="mk-inner">
      <div class="mk-label">Cosa possiamo fare insieme</div>
      <div class="mk-offer-grid">
        <div class="mk-offer-item">
          <div class="mk-offer-num">01</div>
          <div class="mk-offer-name">Pacchetto contenuti fotografici e video</div>
          <p class="mk-offer-desc">Ti consegniamo un archivio di fotografie e video ad alta risoluzione — pronti per l'uso sui tuoi canali social, sito e materiali di comunicazione. Contenuti d'autore, coerenti con il tuo brand, realizzati sul campo. Non stock, non generici: immagini che raccontano davvero quello che fai.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">02</div>
          <div class="mk-offer-name">Visibilità sui nostri social</div>
          <p class="mk-offer-desc">Post e reel in collaborazione sui profili Unmarked — 78K+ follower, un'audience colta, curiosa, con alta propensione al viaggio e agli acquisti premium. Il formato collab di Instagram porta il tuo brand direttamente nel feed di entrambe le community. Niente pubblicità, solo racconto autentico.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">03</div>
          <div class="mk-offer-name">Short film dedicato</div>
          <p class="mk-offer-desc">Un film breve, con la cura visiva e narrativa dei nostri documentari, costruito attorno alla tua destinazione o esperienza. Non uno spot — una storia. Il tipo di contenuto che le persone guardano fino alla fine, salvano, condividono. E che rimane.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">04</div>
          <div class="mk-offer-name">Articolo e newsletter dedicati</div>
          <p class="mk-offer-desc">Un racconto editoriale completo sulla piattaforma Unmarked e una newsletter dedicata agli abbonati. Parole scelte, nessuna retorica da brochure. Il tuo progetto presentato a una community di lettori che legge davvero — e che si fida di quello che consigliamo.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">05</div>
          <div class="mk-offer-name">Product placement nei documentari</div>
          <p class="mk-offer-desc">Se il tuo progetto si intreccia con uno dei nostri documentari in produzione, possiamo costruire insieme una presenza naturale e integrata nel film — product placement, menzioni come partner, presenza nei credits. Il modo più efficace per raggiungere un pubblico che ha scelto di sedersi ad ascoltare.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">06</div>
          <div class="mk-offer-name">Pacchetti su misura</div>
          <p class="mk-offer-desc">Ogni progetto è diverso. Se hai un obiettivo specifico — lancio, awareness, racconto di territorio, campagna stagionale — costruiamo insieme la combinazione di formati più efficace. Dalla foto al film, dai social alla newsletter: un ecosistema di contenuti pensato per durare, non per sparire in 24 ore.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="mk-section mk-cases">
    <div class="mk-inner">
      <div class="mk-label">Progetti realizzati</div>
      <div class="mk-cases-grid">

        <div class="mk-case" data-case="hidden-path">
          <button class="mk-case-header" aria-expanded="false" aria-controls="case-hidden-path">
            <div class="mk-case-header-left">
              <div class="mk-case-num">01</div>
              <div>
                <div class="mk-case-client">Mazda Europe</div>
                <div class="mk-case-title">The Hidden Path</div>
              </div>
            </div>
            <div class="mk-case-header-right">
              <div class="mk-case-tags">
                <span>Short film</span>
                <span>Contenuti social</span>
                <span>Reportage fotografico</span>
                <span>Product placement</span>
              </div>
              <div class="mk-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="mk-case-body" id="case-hidden-path">
            <div class="mk-case-body-inner">
              <p class="mk-case-desc">Un viaggio dalle Dolomiti ai Monti Carpazi in Romania, sulle tracce dell'orso bruno. Obiettivo: raccontare la Mazda CX-60 non come un'auto da città, ma come compagna di percorsi estremi — capace di macinare migliaia di chilometri e di affrontare strade sterrate in ambienti wild e remoti. Il progetto ha coinvolto enti del turismo locali e strutture partner lungo il percorso.</p>
              <div class="mk-case-gallery">
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
              </div>
              <div class="mk-case-film">
                <iframe src="https://www.youtube.com/embed/G1LZG6bczmw" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          </div>
        </div>

        <div class="mk-case" data-case="eyes-of-africa">
          <button class="mk-case-header" aria-expanded="false" aria-controls="case-eyes-of-africa">
            <div class="mk-case-header-left">
              <div class="mk-case-num">02</div>
              <div>
                <div class="mk-case-client">Lobelias Safaris</div>
                <div class="mk-case-title">The Eyes of Africa</div>
              </div>
            </div>
            <div class="mk-case-header-right">
              <div class="mk-case-tags">
                <span>Short film</span>
                <span>Contenuti social</span>
                <span>Storytelling editoriale</span>
              </div>
              <div class="mk-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="mk-case-body" id="case-eyes-of-africa">
            <div class="mk-case-body-inner">
              <p class="mk-case-desc">Nella foresta di Bwindi, in Uganda, alla scoperta dei gorilla di montagna. Il progetto nasceva da una richiesta precisa: raccontare non solo la destinazione, ma l'esperienza vissuta a fianco di una guida locale di altissima competenza — quella conoscenza del territorio che nessuna app o guida cartacea può replicare. Il risultato è un film che porta lo spettatore dentro la foresta, nel silenzio prima dell'incontro.</p>
              <div class="mk-case-gallery">
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
                <div class="mk-case-photo mk-case-photo-placeholder"></div>
              </div>
              <div class="mk-case-film" id="eyes-film-embed">
                <iframe src="https://www.youtube.com/embed/B34AQ0RULeo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PREZZI -->
  <section class="mk-section mk-pricing">
    <div class="mk-inner">
      <div class="mk-label">Investimento</div>
      <p class="mk-pricing-intro">Ogni progetto è diverso, ogni preventivo è su misura. Di seguito i valori di partenza per orientarsi.</p>
      <div class="mk-pricing-grid">
        <div class="mk-price-card">
          <div class="mk-price-name">Pacchetto contenuti</div>
          <div class="mk-price-desc">Foto e video ad alta risoluzione pronti per i tuoi canali. Produzione sul campo, licenza d'uso inclusa.</div>
          <div class="mk-price-val">a partire da <strong>€ {d.pricing.contents}</strong></div>
        </div>
        <div class="mk-price-card">
          <div class="mk-price-name">Visibilità social</div>
          <div class="mk-price-desc">Post e reel in collaborazione sui canali Unmarked. Reach combinata 78K+ follower, audience premium.</div>
          <div class="mk-price-val">a partire da <strong>€ {d.pricing.social}</strong></div>
        </div>
        <div class="mk-price-card mk-price-featured">
          <div class="mk-price-name">Short film</div>
          <div class="mk-price-desc">Un film breve con la cura visiva e narrativa dei nostri documentari. Dalla pre-produzione alla consegna del master.</div>
          <div class="mk-price-val">a partire da <strong>€ {d.pricing.film}</strong></div>
        </div>
      </div>
      <p class="mk-pricing-note">I pacchetti integrati — che combinano più formati — sono sempre la soluzione più efficace e vengono costruiti su misura in base agli obiettivi del progetto.</p>
    </div>
  </section>

  <!-- CTA CONTATTI -->
  <section class="mk-cta">
    <div class="mk-cta-inner">
      <div class="mk-label mk-label-light">Lavoriamo insieme</div>
      <h2 class="mk-cta-title">Raccontiamo il tuo<br/>posto nel mondo.</h2>
      <p class="mk-cta-sub">Se stai cercando un racconto autentico, fotografia d'autore e un pubblico che ama davvero viaggiare — siamo quelli giusti.</p>
      <a href={`mailto:${d.contactEmail}`} class="mk-cta-btn">Scrivici</a>
    </div>
  </section>

<!-- LIGHTBOX REEL -->
<div id="reel-lightbox" class="reel-lb" aria-hidden="true">
  <div class="reel-lb-backdrop"></div>
  <div class="reel-lb-panel">
    <button class="reel-lb-close" aria-label="Chiudi">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="reel-lb-embed" id="reel-lb-embed"></div>
    <a id="reel-lb-link" href="#" target="_blank" rel="noopener" class="reel-lb-openig">
      <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
      Apri su Instagram
    </a>
  </div>
</div>

<script>
  // ACCORDION
  document.querySelectorAll('.mk-case-header').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const body = document.getElementById(btn.getAttribute('aria-controls'));
      btn.setAttribute('aria-expanded', !isOpen);
      body.classList.toggle('is-open', !isOpen);
    });
  });

  // LIGHTBOX
  const lightbox = document.getElementById('reel-lightbox');
  const embedContainer = document.getElementById('reel-lb-embed');
  const lbLink = document.getElementById('reel-lb-link');

  function openLightbox(url) {
    embedContainer.innerHTML = `<blockquote class="instagram-media" data-instgrm-captioned data-instgrm-permalink="${url}" data-instgrm-version="14" style="width:100%;max-width:400px;margin:0 auto;"></blockquote>`;
    lbLink.href = url;
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';

    if (window.instgrm) {
      window.instgrm.Embeds.process();
    } else {
      const s = document.createElement('script');
      s.src = 'https://www.instagram.com/embed.js';
      s.async = true;
      document.body.appendChild(s);
    }
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { embedContainer.innerHTML = ''; }, 300);
  }

  document.querySelectorAll('.mk-reel-card[data-reel]').forEach(card => {
    card.addEventListener('click', e => {
      e.preventDefault();
      openLightbox(card.dataset.reel);
    });
  });

  document.querySelector('.reel-lb-backdrop').addEventListener('click', closeLightbox);
  document.querySelector('.reel-lb-close').addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>

</BaseLayout>

<style>
  /* HERO */
  .mk-hero {
    position: relative;
    height: 560px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .mk-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
  }
  .mk-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,24,20,0.9) 0%, rgba(26,24,20,0.4) 60%, rgba(26,24,20,0.1) 100%);
