---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { portfolioData as d } from '../../data/portfolio-data';
---

<BaseLayout
  title="Portfolio — Unmarked"
  description="Unmarked portfolio — photography, video and brand campaigns."
>

  <!-- HERO -->
  <section class="pf-hero">
    <div class="pf-hero-bg" style="background-image:url('/portfolio/hero.jpg')"></div>
    <div class="pf-hero-overlay"></div>
    <div class="pf-hero-content">
      <div class="pf-hero-tag">Portfolio · 2024–2025</div>
      <h1 class="pf-hero-title">Our work.</h1>
      <p class="pf-hero-sub">Photography, video and campaigns made with the brands that chose Unmarked.</p>
    </div>
  </section>

  <!-- ── PHOTOGRAPHY ── -->
  <section class="pf-section" id="photography">
    <div class="pf-inner">
      <div class="pf-label">Photography</div>

      {d.photoGroups.map(group => (
        <div class="pf-photo-group">
          <div class="pf-photo-group-header">
            <span class="pf-photo-group-brand">{group.brand}</span>
            <span class="pf-photo-group-year">{group.year}</span>
          </div>
          <div class="pf-photo-grid">
            {group.photos.map((photo) => (
              <div
                class="pf-photo-item"
                data-src={photo.src}
                data-brand={group.brand}
                role={photo.src ? 'button' : undefined}
                tabindex={photo.src ? '0' : undefined}
              >
                <div
                  class="pf-photo-placeholder"
                  style={photo.src ? `background-image:url('${photo.src}')` : ''}
                >
                  {!photo.src && <span class="pf-placeholder-hint">{photo.hint}</span>}
                  {photo.src && (
                    <div class="pf-photo-overlay">
                      <span class="pf-overlay-label">Client</span>
                      <span class="pf-overlay-brand">{group.brand}</span>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <!-- ── VIDEO ── -->
  <section class="pf-section pf-section-dark" id="video">
    <div class="pf-inner">
      <div class="pf-label pf-label-light">Video</div>

      <div class="pf-video-grid">
        {d.videos.map(video => {
          const thumb = video.youtubeId
            ? `https://img.youtube.com/vi/${video.youtubeId}/hqdefault.jpg`
            : video.thumb || '';
          const hasVideo = !!(video.youtubeId || video.videoSrc);
          return (
            <div
              class={`pf-video-card${hasVideo ? ' is-clickable' : ''}`}
              data-yt={video.youtubeId}
              data-src={video.videoSrc}
            >
              <div class="pf-video-thumb" style={thumb ? `background-image:url('${thumb}')` : ''}>
                {hasVideo && (
                  <div class="pf-video-card-overlay">
                    <div class="pf-play-btn">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                )}
                {!hasVideo && (
                  <div class="pf-video-ph-inner">
                    <div class="pf-play-btn pf-play-btn-muted">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                )}
              </div>
              <div class="pf-video-meta">
                {video.brand && <div class="pf-video-brand">{video.brand}</div>}
                <div class="pf-video-title">{video.title}</div>
                <div class="pf-video-desc">{video.descEn}</div>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- ── RATES ── -->
  <section class="pf-section" id="rates">
    <div class="pf-inner">
      <div class="pf-label">Rates</div>
      <p class="pf-tariffe-intro">Base packages — every project can be tailored to your needs.</p>

      <div class="pf-tariffe-grid">
        {d.tariffe.map((t, i) => (
          <div class="pf-tariffa">
            <div class="pf-tariffa-num">0{i + 1}</div>
            <div class="pf-tariffa-name">{t.nameEn}</div>
            <div class="pf-tariffa-price">€ {t.price}</div>
            <ul class="pf-tariffa-items">
              {t.itemsEn.map(item => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="pf-tariffe-note">
        All prices exclude VAT. For custom projects or combined packages, get in touch.
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="pf-section pf-cta-section" style="background-image:url('/portfolio/cta.jpg')">
    <div class="pf-inner pf-cta-inner">
      <div class="pf-cta-label">Let's work together</div>
      <h2 class="pf-cta-title">Have a project in mind?</h2>
      <p class="pf-cta-sub">Tell us your goal — we'll build the right format together.</p>
      <a href={`mailto:${d.contactEmail}`} class="pf-cta-btn">Get in touch</a>
    </div>
  </section>

  <!-- PHOTO LIGHTBOX -->
  <div class="pf-lightbox" id="pf-lightbox" aria-hidden="true">
    <div class="pf-lb-backdrop"></div>
    <button class="pf-lb-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <div class="pf-lb-content">
      <img class="pf-lb-img" src="" alt="" />
      <div class="pf-lb-meta">
        <span class="pf-lb-label">Client</span>
        <span class="pf-lb-brand"></span>
      </div>
    </div>
  </div>

  <!-- VIDEO OVERLAY -->
  <div class="pf-video-lb" id="pf-video-lb" aria-hidden="true">
    <div class="pf-vlb-backdrop"></div>
    <button class="pf-vlb-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <div class="pf-vlb-content">
      <div class="pf-vlb-embed" id="pf-vlb-embed"></div>
    </div>
  </div>

</BaseLayout>

<script>
  // ── PHOTO LIGHTBOX ──
  const lb = document.getElementById('pf-lightbox');
  const lbImg = lb.querySelector('.pf-lb-img');
  const lbBrand = lb.querySelector('.pf-lb-brand');

  function openPhoto(src, brand) {
    lbImg.src = src; lbImg.alt = brand; lbBrand.textContent = brand;
    lb.classList.add('is-open'); lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closePhoto() {
    lb.classList.remove('is-open'); lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { lbImg.src = ''; }, 300);
  }

  document.querySelectorAll('.pf-photo-item[data-src]').forEach(item => {
    if (!item.dataset.src) return;
    item.addEventListener('click', () => openPhoto(item.dataset.src, item.dataset.brand));
    item.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') openPhoto(item.dataset.src, item.dataset.brand); });
  });
  lb.querySelector('.pf-lb-backdrop').addEventListener('click', closePhoto);
  lb.querySelector('.pf-lb-close').addEventListener('click', closePhoto);

  // ── VIDEO OVERLAY ──
  const vlb = document.getElementById('pf-video-lb');
  const vlbEmbed = document.getElementById('pf-vlb-embed');

  function calcVideoDims() {
    const maxW = Math.min(900, window.innerWidth * 0.88);
    const maxH = window.innerHeight * 0.82;
    let w = maxW;
    let h = Math.round(w * 9 / 16);
    if (h > maxH) { h = Math.round(maxH); w = Math.round(h * 16 / 9); }
    return { w, h };
  }

  function openVideo(ytId, videoSrc) {
    const { w, h } = calcVideoDims();
    if (ytId) {
      vlbEmbed.innerHTML = `<iframe width="${w}" height="${h}" src="https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0" frameborder="0" allow="autoplay; accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
    } else if (videoSrc) {
      vlbEmbed.innerHTML = `<video width="${w}" height="${h}" src="${videoSrc}" autoplay controls playsinline style="display:block;object-fit:contain;background:#000"></video>`;
    }
    vlb.classList.add('is-open'); vlb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeVideo() {
    vlb.classList.remove('is-open'); vlb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { vlbEmbed.innerHTML = ''; }, 300);
  }

  document.querySelectorAll('.pf-video-card.is-clickable').forEach(card => {
    card.addEventListener('click', () => openVideo(card.dataset.yt, card.dataset.src));
  });
  vlb.querySelector('.pf-vlb-backdrop').addEventListener('click', closeVideo);
  vlb.querySelector('.pf-vlb-close').addEventListener('click', closeVideo);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closePhoto(); closeVideo(); }
  });
</script>

<style>
  .pf-hero { position: relative; height: 480px; display: flex; align-items: flex-end; overflow: hidden; background: var(--dark); }
  .pf-hero-bg { position: absolute; inset: 0; background: var(--dark); }
  .pf-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.95) 0%, rgba(26,24,20,0.5) 100%); }
  .pf-hero-content { position: relative; padding: 56px; max-width: 860px; }
  .pf-hero-tag { font-size: 9px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: var(--terra); margin-bottom: 20px; }
  .pf-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 72px; font-weight: 300; color: #FAFAF8; line-height: 1.05; margin: 0 0 20px; }
  .pf-hero-sub { font-size: 15px; font-weight: 300; color: rgba(250,250,248,0.6); line-height: 1.7; max-width: 500px; }

  .pf-section { padding: 80px 0; }
  .pf-section-dark { background: var(--dark); }
  .pf-inner { max-width: 1100px; margin: 0 auto; padding: 0 56px; }
  .pf-label { font-size: 9px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--terra); margin-bottom: 48px; display: flex; align-items: center; gap: 12px; }
  .pf-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--terra); }
  .pf-label-light { color: var(--sand); }
  .pf-label-light::before { background: var(--sand); }

  .pf-photo-group { margin-bottom: 52px; }
  .pf-photo-group:last-child { margin-bottom: 0; }
  .pf-photo-group-header { display: flex; align-items: baseline; gap: 16px; padding-bottom: 14px; margin-bottom: 3px; border-bottom: 1px solid var(--light-border); }
  .pf-photo-group-brand { font-size: 9px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--dark); }
  .pf-photo-group-year { font-size: 9px; font-weight: 300; letter-spacing: 0.12em; color: var(--muted); }
  .pf-photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
  .pf-photo-item { display: flex; flex-direction: column; cursor: pointer; }
  .pf-photo-item[data-src=""] { cursor: default; }
  .pf-photo-placeholder { aspect-ratio: 4/5; background: var(--beige); background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
  .pf-placeholder-hint { font-size: 9px; font-weight: 300; letter-spacing: 0.1em; color: var(--muted); text-transform: uppercase; text-align: center; padding: 12px; }
  .pf-photo-overlay { position: absolute; inset: 0; background: rgba(26,24,20,0.72); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; opacity: 0; transition: opacity 0.25s; }
  .pf-photo-item:hover .pf-photo-overlay { opacity: 1; }
  .pf-overlay-label { font-size: 8px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--terra); }
  .pf-overlay-brand { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 300; color: #FAFAF8; letter-spacing: 0.04em; }

  .pf-video-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3px; }
  .pf-video-card { display: flex; flex-direction: column; }
  .pf-video-card.is-clickable { cursor: pointer; }
  .pf-video-thumb { aspect-ratio: 16/9; background: rgba(250,250,248,0.06); background-size: cover; background-position: center; position: relative; overflow: hidden; }
  .pf-video-card-overlay { position: absolute; inset: 0; background: rgba(26,24,20,0.35); display: flex; align-items: center; justify-content: center; transition: background 0.25s; }
  .pf-video-card.is-clickable:hover .pf-video-card-overlay { background: rgba(26,24,20,0.55); }
  .pf-video-ph-inner { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .pf-play-btn { width: 56px; height: 56px; border-radius: 50%; background: rgba(250,250,248,0.15); border: 1px solid rgba(250,250,248,0.3); display: flex; align-items: center; justify-content: center; color: #FAFAF8; transition: background 0.2s, transform 0.2s; }
  .pf-play-btn svg { width: 22px; height: 22px; margin-left: 3px; }
  .pf-video-card.is-clickable:hover .pf-play-btn { background: var(--terra); border-color: var(--terra); transform: scale(1.08); }
  .pf-play-btn-muted { background: rgba(250,250,248,0.06); border-color: rgba(250,250,248,0.12); color: rgba(250,250,248,0.25); }
  .pf-video-meta { padding: 16px 0 8px; }
  .pf-video-brand { font-size: 9px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--terra); margin-bottom: 5px; }
  .pf-video-title { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 300; color: #FAFAF8; margin-bottom: 5px; }
  .pf-video-desc { font-size: 11px; font-weight: 300; letter-spacing: 0.08em; color: rgba(250,250,248,0.35); }

  .pf-tariffe-intro { font-size: 14px; font-weight: 300; color: var(--muted); line-height: 1.7; margin-bottom: 48px; margin-top: -24px; }
  .pf-tariffe-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--light-border); border: 1px solid var(--light-border); margin-bottom: 28px; }
  .pf-tariffa { background: var(--cream); padding: 40px 36px; display: flex; flex-direction: column; gap: 16px; }
  .pf-tariffa-num { font-family: 'Cormorant Garamond', serif; font-size: 13px; font-weight: 300; color: var(--muted); letter-spacing: 0.06em; }
  .pf-tariffa-name { font-size: 9px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--dark); line-height: 1.5; }
  .pf-tariffa-price { font-family: 'Cormorant Garamond', serif; font-size: 48px; font-weight: 300; color: var(--terra); line-height: 1; margin: 4px 0; }
  .pf-tariffa-items { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .pf-tariffa-items li { font-size: 13px; font-weight: 300; color: var(--muted); line-height: 1.5; padding-left: 14px; position: relative; }
  .pf-tariffa-items li::before { content: '—'; position: absolute; left: 0; color: var(--sand); font-size: 11px; }
  .pf-tariffe-note { font-size: 11px; font-weight: 300; color: var(--muted); letter-spacing: 0.04em; line-height: 1.7; }

  .pf-lightbox { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .pf-lightbox.is-open { opacity: 1; pointer-events: all; }
  .pf-lb-backdrop { position: absolute; inset: 0; background: rgba(26,24,20,0.94); }
  .pf-lb-close { position: absolute; top: 24px; right: 28px; width: 40px; height: 40px; background: none; border: none; cursor: pointer; color: rgba(250,250,248,0.6); z-index: 1; transition: color 0.2s; }
  .pf-lb-close:hover { color: #FAFAF8; }
  .pf-lb-close svg { width: 24px; height: 24px; }
  .pf-lb-content { position: relative; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .pf-lb-img { max-width: 90vw; max-height: 80vh; object-fit: contain; border-radius: 2px; }
  .pf-lb-meta { display: flex; align-items: center; gap: 12px; }
  .pf-lb-label { font-size: 8px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--terra); }
  .pf-lb-brand { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 300; color: rgba(250,250,248,0.7); }

  .pf-video-lb {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 32px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .pf-video-lb.is-open { opacity: 1; pointer-events: all; }
  .pf-vlb-backdrop { position: absolute; inset: 0; background: rgba(26,24,20,0.96); }
  .pf-vlb-close {
    position: fixed;
    top: 20px;
    right: 24px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(250,250,248,0.6);
    z-index: 1;
    transition: color 0.2s;
  }
  .pf-vlb-close:hover { color: #FAFAF8; }
  .pf-vlb-close svg { width: 24px; height: 24px; }
  .pf-vlb-content {
    position: relative;
    z-index: 1;
  }
  .pf-vlb-embed {
    display: block;
    background: #000;
    border-radius: 2px;
    line-height: 0;
  }
  .pf-vlb-embed iframe,
  .pf-vlb-embed video {
    display: block;
    border: none;
  }

  .pf-cta-section { position: relative; background: var(--dark); background-size: cover; background-position: center; padding: 100px 0; }
  .pf-cta-section::before { content: ''; position: absolute; inset: 0; background: rgba(26,24,20,0.75); }
  .pf-cta-inner { position: relative; z-index: 1; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .pf-cta-label { font-size: 9px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: var(--terra); }
  .pf-cta-title { font-family: 'Cormorant Garamond', serif; font-size: 52px; font-weight: 300; color: #FAFAF8; line-height: 1.1; margin: 0; }
  .pf-cta-sub { font-size: 15px; font-weight: 300; color: rgba(250,250,248,0.5); line-height: 1.7; }
  .pf-cta-btn { margin-top: 12px; display: inline-block; padding: 14px 40px; border: 1px solid rgba(201,185,154,0.4); color: #FAFAF8; font-size: 10px; font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none; transition: background 0.2s, border-color 0.2s; }
  .pf-cta-btn:hover { background: var(--terra); border-color: var(--terra); }

  @media (max-width: 768px) {
    .pf-inner { padding: 0 24px; }
    .pf-hero-content { padding: 36px 24px; }
    .pf-hero-title { font-size: 46px; }
    .pf-photo-grid { grid-template-columns: 1fr 1fr; }
    .pf-video-grid { grid-template-columns: 1fr; }
    .pf-tariffe-grid { grid-template-columns: 1fr; }
    .pf-cta-title { font-size: 36px; }
  }
</style>
