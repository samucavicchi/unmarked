---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mediakitData as d } from '../../data/mediakit-data';
---

<BaseLayout
  title="Media Kit — Unmarked"
  description="Partner with Unmarked. Photography reportages, premium itineraries and authentic travel storytelling."
  ogImage={d.heroImage}
>

  <!-- HERO -->
  <section class="mk-hero">
    <div class="mk-hero-bg" style={`background-image:url('${d.heroImage}')`}></div>
    <div class="mk-hero-overlay"></div>
    <div class="mk-hero-content">
      <div class="mk-hero-tag">Media Kit · {d.year}</div>
      <h1 class="mk-hero-title">Discover the world<br/>with us.</h1>
      <p class="mk-hero-sub">We bring value to your world through our images — we create, we tell stories, we make people discover.</p>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="mk-section mk-about">
    <div class="mk-inner">
      <div class="mk-label">Who we are</div>
      <div class="mk-about-grid">
        <div class="mk-person">
          <div class="mk-person-photo" style={`background-image:url('${d.samuele.photo}')`}></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Samuele</div>
            <div class="mk-person-role">Nature photographer & creative director</div>
            <a href={d.samuele.igUrl} target="_blank" rel="noopener" class="mk-person-ig">
              <svg class="mk-ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              {d.samuele.igHandle}
            </a>
            <p class="mk-person-bio">Twenty years of nature and reportage photography. Every journey is an exercise in seeing what others miss — the right light, the hidden moment, the authentic story.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">{d.samuele.followers}</div><div class="mk-stat-label">Instagram Followers</div></div>
              <div class="mk-stat"><div class="mk-stat-num">{d.samuele.avgViews}</div><div class="mk-stat-label">Avg. Views</div></div>
            </div>
          </div>
        </div>
        <div class="mk-person">
          <div class="mk-person-photo" style={`background-image:url('${d.alice.photo}')`}></div>
          <div class="mk-person-info">
            <div class="mk-person-name">Alice</div>
            <div class="mk-person-role">Storyteller & travel curator</div>
            <a href={d.alice.igUrl} target="_blank" rel="noopener" class="mk-person-ig">
              <svg class="mk-ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>
              {d.alice.igHandle}
            </a>
            <p class="mk-person-bio">A lifelong traveller with a passion for authentic places and stories that don't end up in brochures. She turns every destination into a precise, honest narrative that inspires.</p>
            <div class="mk-person-stats">
              <div class="mk-stat"><div class="mk-stat-num">{d.alice.followers}</div><div class="mk-stat-label">Instagram Followers</div></div>
              <div class="mk-stat"><div class="mk-stat-num">{d.alice.avgViews}</div><div class="mk-stat-label">Avg. Views</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS -->
  <section class="mk-section mk-numbers">
    <div class="mk-inner">
      <div class="mk-label mk-label-light">Our reach</div>
      <div class="mk-numbers-grid">
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.totalFollowers}</div>
          <div class="mk-num-desc">Total Instagram Followers</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.monthlyViews}</div>
          <div class="mk-num-desc">Avg. Monthly Views</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.newsletter}</div>
          <div class="mk-num-desc">Newsletter Subscribers</div>
        </div>
        <div class="mk-num-item">
          <div class="mk-num-val">{d.reach.italianAudience}</div>
          <div class="mk-num-desc">Italian Audience</div>
        </div>
      </div>
      <div class="mk-audience-note">
        The remaining audience is distributed across major European countries — Germany, France, Spain, UK, Switzerland, the Netherlands.
        An educated, curious community with high purchasing power and a strong inclination for premium travel.
      </div>
    </div>
  </section>

  <!-- AUDIENCE -->
  <section class="mk-section mk-audience">
    <div class="mk-inner">
      <div class="mk-label">Who follows us</div>
      <div class="mk-audience-grid">
        <div class="mk-aud-block">
          <div class="mk-aud-title">Primary age range</div>
          <div class="mk-aud-bar-wrap">
            {d.ageGroups.map(g => (
              <div class={`mk-aud-bar-row${g.highlight ? ' mk-aud-highlight' : ''}`}>
                <span class="mk-aud-age">{g.label}</span>
                <div class="mk-aud-bar"><div class="mk-aud-fill" style={`width:${g.pct}%`}></div></div>
                <span class="mk-aud-pct">{g.pct}%</span>
              </div>
            ))}
          </div>
          <p class="mk-aud-note">The core audience — 25–44 — represents 70% of the community. Adults with spending power, accustomed to choosing quality experiences.</p>
        </div>
        <div class="mk-aud-block">
          <div class="mk-aud-title">Geographic distribution</div>
          <div class="mk-geo-list">
            {d.geoGroups.map(g => (
              <div class={`mk-geo-row${g.main ? ' mk-geo-main' : ''}`}>
                <span class="mk-geo-country">{g.country}</span>
                <div class="mk-aud-bar"><div class={`mk-aud-fill${g.main ? '' : ' mk-aud-fill-light'}`} style={`width:${g.pct}%`}></div></div>
                {g.main && <span class="mk-aud-pct">{g.pct}%+</span>}
              </div>
            ))}
          </div>
        </div>
        <div class="mk-aud-block">
          <div class="mk-aud-title">Interests</div>
          <div class="mk-tags">
            <span class="mk-tag">Travel</span>
            <span class="mk-tag">Nature</span>
            <span class="mk-tag">Photography</span>
            <span class="mk-tag">Adventure</span>
            <span class="mk-tag">Wildlife</span>
            <span class="mk-tag">Outdoor</span>
            <span class="mk-tag">Documentaries</span>
            <span class="mk-tag">Sustainability</span>
          </div>
          <p class="mk-aud-note">An audience that doesn't scroll past content — it seeks it out. Above-average save, share and engagement rates compared to other travel profiles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="mk-section mk-collabs">
    <div class="mk-inner">
      <div class="mk-label">Brands that chose Unmarked</div>
      <div class="mk-marquee-wrap">
        <div class="mk-marquee-track">
          <div class="mk-brand-item"><img src="/loghi/mazda.svg" alt="Mazda" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/nikon.svg" alt="Nikon" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/dji.svg" alt="DJI" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hellyhansen.svg" alt="Helly Hansen" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/hamilton.svg" alt="Hamilton" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/NOMATIC.png" alt="Nomatic" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Suunto-Logo.png" alt="Suunto" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/BASECAMP.png" alt="Basecamp Explore" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/fourseasons.png" alt="Four Seasons" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/Logo_explore_namibia_header02.png" alt="Explore Namibia" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/rangerover logo.png" alt="Range Rover" class="mk-logo mk-logo-wide" /></div>
          <div class="mk-brand-item"><img src="/loghi/ascocar.png" alt="Asco Car" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/evolveback.png" alt="Evolve Back" class="mk-logo" /></div>
          <div class="mk-brand-item"><img src="/loghi/mogothlo.png" alt="Mogothlo" class="mk-logo" /></div>
          <div class="mk-brand-item mk-brand-plus">100+<span>partner structures</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- REELS -->
  <section class="mk-section mk-reels">
    <div class="mk-inner">
      <div class="mk-label">Our work, on their channels</div>
      <p class="mk-reels-intro">Content published directly by brands on their official Instagram profiles. Because the final result is what matters.</p>
      <div class="mk-reels-grid">
        {d.reels.map(reel => (
          <a href={reel.url} class="mk-reel-card" data-reel={reel.url}>
            <div class="mk-reel-cover" style={`background-image:url('${reel.cover}')`}>
              <div class="mk-reel-overlay"></div>
              <div class="mk-reel-play">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <div class="mk-reel-ig">
                <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
              </div>
            </div>
            <div class="mk-reel-meta">
              <div class="mk-reel-brand">{reel.brand}</div>
              <div class="mk-reel-handle">{reel.handle}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT WE OFFER -->
  <section class="mk-section mk-offer">
    <div class="mk-inner">
      <div class="mk-label">What we can do together</div>
      <div class="mk-offer-grid">
        <div class="mk-offer-item">
          <div class="mk-offer-num">01</div>
          <div class="mk-offer-name">Photo & video content package</div>
          <p class="mk-offer-desc">We deliver a library of high-resolution photos and videos — ready to use across your social channels, website and communications. Author-made, brand-consistent, shot on location. Not stock, not generic: images that genuinely tell what you do.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">02</div>
          <div class="mk-offer-name">Social media visibility</div>
          <p class="mk-offer-desc">Collaborative posts and reels on Unmarked profiles — 78K+ followers, an educated, curious audience with strong premium travel intent. Instagram's collab format puts your brand directly in both communities' feeds. No advertising — only authentic storytelling.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">03</div>
          <div class="mk-offer-name">Dedicated short film</div>
          <p class="mk-offer-desc">A short film with the visual and narrative care of our documentaries, built around your destination or experience. Not a spot — a story. The kind of content people watch to the end, save, share. And remember.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">04</div>
          <div class="mk-offer-name">Editorial article & newsletter</div>
          <p class="mk-offer-desc">A full editorial piece on the Unmarked platform and a dedicated newsletter to our subscribers. Carefully chosen words, no brochure rhetoric. Your project introduced to a community that actually reads — and trusts what we recommend.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">05</div>
          <div class="mk-offer-name">Product placement in documentaries</div>
          <p class="mk-offer-desc">If your project connects with one of our documentaries in production, we can build a natural, integrated presence in the film — product placement, partner mentions, credits. The most effective way to reach an audience that chose to sit down and listen.</p>
        </div>
        <div class="mk-offer-item">
          <div class="mk-offer-num">06</div>
          <div class="mk-offer-name">Custom packages</div>
          <p class="mk-offer-desc">Every project is different. If you have a specific goal — a launch, awareness campaign, territory narrative, seasonal push — we'll build the most effective combination of formats together. From photo to film, from social to newsletter: a content ecosystem designed to last, not disappear in 24 hours.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  <section class="mk-section mk-cases">
    <div class="mk-inner">
      <div class="mk-label">Projects we've made</div>
      <div class="mk-cases-grid">

        <div class="mk-case" data-case="hidden-path">
          <button class="mk-case-header" aria-expanded="false" aria-controls="case-hidden-path-en">
            <div class="mk-case-header-left">
              <div class="mk-case-num">01</div>
              <div>
                <div class="mk-case-client">Mazda Europe</div>
                <div class="mk-case-title">The Hidden Path</div>
              </div>
            </div>
            <div class="mk-case-header-right">
              <div class="mk-case-tags">
                <span>Short film</span>
                <span>Social content</span>
                <span>Photography reportage</span>
                <span>Product placement</span>
              </div>
              <div class="mk-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="mk-case-body" id="case-hidden-path-en">
            <div class="mk-case-body-inner">
              <p class="mk-case-desc">A journey from the Dolomites to the Carpathian Mountains in Romania, tracking the brown bear. The goal: to tell the story of the Mazda CX-60 not as a city car, but as a companion for extreme routes — capable of covering thousands of kilometres while tackling off-road tracks in wild, remote environments. The project involved local tourism boards and partner accommodations along the way.</p>
              <div class="mk-case-gallery">
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-hiddenpath1.jpg')"></div>
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-hiddenpath2.jpg')"></div>
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-hiddenpath3.jpg')"></div>
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-hiddenpath4.jpg')"></div>
              </div>
              <div class="mk-case-film">
                <iframe src="https://www.youtube.com/embed/G1LZG6bczmw" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          </div>
        </div>

        <div class="mk-case" data-case="eyes-of-africa">
          <button class="mk-case-header" aria-expanded="false" aria-controls="case-eyes-of-africa-en">
            <div class="mk-case-header-left">
              <div class="mk-case-num">02</div>
              <div>
                <div class="mk-case-client">Lobelias Safaris</div>
                <div class="mk-case-title">The Eyes of Africa</div>
              </div>
            </div>
            <div class="mk-case-header-right">
              <div class="mk-case-tags">
                <span>Short film</span>
                <span>Social content</span>
                <span>Editorial storytelling</span>
              </div>
              <div class="mk-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="mk-case-body" id="case-eyes-of-africa-en">
            <div class="mk-case-body-inner">
              <p class="mk-case-desc">Deep in the Bwindi forest in Uganda, tracking mountain gorillas. The brief was precise: tell not just the destination, but the experience of travelling alongside a local guide of exceptional expertise — the kind of territorial knowledge no app or guidebook can replicate. The result is a film that places the viewer inside the forest, in the silence just before the encounter.</p>
              <div class="mk-case-gallery">
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-eyesofafrica-1.jpg')"></div>
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-eyesofafrica-2.jpg')"></div>
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-eyesofafrica-3.jpg')"></div>
                <div class="mk-case-photo" style="background-image:url('/mediakit/mediakit-project-eyesofafrica-4.jpg')"></div>
              </div>
              <div class="mk-case-film" id="eyes-film-embed-en">
                <iframe src="https://www.youtube.com/embed/B34AQ0RULeo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="mk-section mk-pricing">
    <div class="mk-inner">
      <div class="mk-label">Investment</div>
      <p class="mk-pricing-intro">Every project is different, every quote is tailored. Below are our starting figures to help you orient.</p>
      <div class="mk-pricing-grid">
        <div class="mk-price-card">
          <div class="mk-price-name">Content package</div>
          <div class="mk-price-desc">High-resolution photos and videos ready for your channels. On-location production, usage licence included.</div>
          <div class="mk-price-val">starting from <strong>€ {d.pricing.contents}</strong></div>
        </div>
        <div class="mk-price-card">
          <div class="mk-price-name">Social visibility</div>
          <div class="mk-price-desc">Collaborative posts and reels on Unmarked channels. Combined reach 78K+ followers, premium audience.</div>
          <div class="mk-price-val">starting from <strong>€ {d.pricing.social}</strong></div>
        </div>
        <div class="mk-price-card mk-price-featured">
          <div class="mk-price-name">Short film</div>
          <div class="mk-price-desc">A short film with the visual and narrative care of our documentaries. From pre-production to master delivery.</div>
          <div class="mk-price-val">starting from <strong>€ {d.pricing.film}</strong></div>
        </div>
      </div>
      <p class="mk-pricing-note">Integrated packages — combining multiple formats — are always the most effective solution and are built to measure based on each project's goals.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="mk-cta">
    <div class="mk-cta-inner">
      <div class="mk-label mk-label-light">Let's work together</div>
      <h2 class="mk-cta-title">We'll tell your<br/>place in the world.</h2>
      <p class="mk-cta-sub">If you're looking for authentic storytelling, author photography and an audience that genuinely loves to travel — we're the right fit.</p>
      <a href={`mailto:${d.contactEmail}`} class="mk-cta-btn">Write to us</a>
    </div>
  </section>

<!-- LIGHTBOX REEL -->
<div id="reel-lightbox" class="reel-lb" aria-hidden="true">
  <div class="reel-lb-backdrop"></div>
  <div class="reel-lb-panel">
    <button class="reel-lb-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="reel-lb-embed" id="reel-lb-embed"></div>
    <a id="reel-lb-link" href="#" target="_blank" rel="noopener" class="reel-lb-openig">
      <svg viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="0.8"/></svg>
      Open on Instagram
    </a>
  </div>
</div>

<script>
  document.querySelectorAll('.mk-case-header').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      const body = document.getElementById(btn.getAttribute('aria-controls'));
      btn.setAttribute('aria-expanded', !isOpen);
      body.classList.toggle('is-open', !isOpen);
    });
  });

  const lightbox = document.getElementById('reel-lightbox');
  const embedContainer = document.getElementById('reel-lb-embed');
  const lbLink = document.getElementById('reel-lb-link');

  function openLightbox(url) {
    embedContainer.innerHTML = `<blockquote class="instagram-media" data-instgrm-captioned data-instgrm-permalink="${url}" data-instgrm-version="14" style="width:100%;max-width:400px;margin:0 auto;"></blockquote>`;
    lbLink.href = url;
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (window.instgrm) {
      window.instgrm.Embeds.process();
    } else {
      const s = document.createElement('script');
      s.src = 'https://www.instagram.com/embed.js';
      s.async = true;
      document.body.appendChild(s);
    }
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(() => { embedContainer.innerHTML = ''; }, 300);
  }

  document.querySelectorAll('.mk-reel-card[data-reel]').forEach(card => {
    card.addEventListener('click', e => {
      e.preventDefault();
      openLightbox(card.dataset.reel);
    });
  });

  document.querySelector('.reel-lb-backdrop').addEventListener('click', closeLightbox);
  document.querySelector('.reel-lb-close').addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>

</BaseLayout>

<style>
  /* ---- copia esatta degli stili da mediakit.astro ---- */
  /* HERO */
  .mk-hero { position: relative; height: 560px; display: flex; align-items: flex-end; overflow: hidden; }
  .mk-hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center 30%; }
  .mk-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(26,24,20,0.9) 0%, rgba(26,24,20,0.4) 60%, rgba(26,24,20,0.1) 100%); }
  .mk-hero-content { position: relative; padding: 56px 56px; max-width: 860px; }
  .mk-hero-tag { font-size: 9px; font-weight: 500; letter-spacing: 0.3em; text-transform: uppercase; color: var(--terra); margin-bottom: 20px; }
  .mk-hero-title { font-family: 'Cormorant Garamond', serif; font-size: 64px; font-weight: 300; color: #FAFAF8; line-height: 1.05; margin: 0 0 20px; }
  .mk-hero-sub { font-size: 15px; font-weight: 300; color: rgba(250,250,248,0.7); line-height: 1.7; max-width: 560px; margin: 0; }
  .mk-section { padding: 80px 0; }
  .mk-inner { max-width: 1100px; margin: 0 auto; padding: 0 56px; }
  .mk-label { font-size: 9px; font-weight: 500; letter-spacing: 0.28em; text-transform: uppercase; color: var(--terra); margin-bottom: 40px; display: flex; align-items: center; gap: 12px; }
  .mk-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--terra); }
  .mk-label-light { color: var(--sand); }
  .mk-label-light::before { background: var(--sand); }
  .mk-about { background: var(--cream); }
