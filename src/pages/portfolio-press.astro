---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Portfolio — Unmarked"
  description="Portfolio lavori Unmarked — fotografia, video e campagne."
>

  <!-- HERO -->
  <section class="pf-hero">
    <div class="pf-hero-bg"></div>
    <div class="pf-hero-overlay"></div>
    <div class="pf-hero-content">
      <div class="pf-hero-tag">Portfolio · 2024–2025</div>
      <h1 class="pf-hero-title">Il nostro lavoro.</h1>
      <p class="pf-hero-sub">Fotografia, video e campagne realizzate con i brand che hanno scelto Unmarked.</p>
    </div>
  </section>

  <!-- ── FOTOGRAFIA ── -->
  <section class="pf-section" id="fotografia">
    <div class="pf-inner">
      <div class="pf-label">Fotografia</div>

      <div class="pf-photo-grid">

        <!-- PROGETTO 1 -->
        <div class="pf-photo-item pf-photo-large">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 1 — paesaggio wide</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Mazda Europe</span>
            <span class="pf-photo-caption">Dolomiti – Romania, 2024</span>
          </div>
        </div>

        <div class="pf-photo-item">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 2 — wildlife / animale</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Mazda Europe</span>
            <span class="pf-photo-caption">Orso bruno, Carpazi 2024</span>
          </div>
        </div>

        <div class="pf-photo-item">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 3 — auto nel paesaggio</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Mazda Europe</span>
            <span class="pf-photo-caption">CX-60 in Carpazi, 2024</span>
          </div>
        </div>

        <!-- PROGETTO 2 -->
        <div class="pf-photo-item">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 4 — attrezzatura / prodotto</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Nikon</span>
            <span class="pf-photo-caption">Campagna fotografica, 2024</span>
          </div>
        </div>

        <div class="pf-photo-item pf-photo-large">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 5 — scatto editoriale wide</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Nikon</span>
            <span class="pf-photo-caption">Wildlife portrait, 2024</span>
          </div>
        </div>

        <!-- PROGETTO 3 -->
        <div class="pf-photo-item">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 6 — ambiente / destinazione</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Four Seasons</span>
            <span class="pf-photo-caption">Reportage struttura, 2024</span>
          </div>
        </div>

        <div class="pf-photo-item">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 7 — interno / dettaglio</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Four Seasons</span>
            <span class="pf-photo-caption">Dettaglio architettura, 2024</span>
          </div>
        </div>

        <div class="pf-photo-item">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 8 — outdoor / action</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Helly Hansen</span>
            <span class="pf-photo-caption">Campagna outdoor, 2025</span>
          </div>
        </div>

        <div class="pf-photo-item pf-photo-large">
          <div class="pf-photo-placeholder">
            <span class="pf-placeholder-hint">Foto 9 — paesaggio wide</span>
          </div>
          <div class="pf-photo-meta">
            <span class="pf-photo-brand">Helly Hansen</span>
            <span class="pf-photo-caption">Lofoten, Norvegia 2025</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── VIDEO ── -->
  <section class="pf-section pf-section-dark" id="video">
    <div class="pf-inner">
      <div class="pf-label pf-label-light">Video</div>

      <div class="pf-video-grid">

        <div class="pf-video-item">
          <div class="pf-video-embed">
            <!-- Sostituisci YOUTUBE_ID con l'ID del video -->
            <!-- <iframe src="https://www.youtube.com/embed/YOUTUBE_ID" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe> -->
            <div class="pf-video-placeholder">
              <div class="pf-play-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="pf-placeholder-hint">Video 1 — Short film Mazda</span>
            </div>
          </div>
          <div class="pf-video-meta">
            <div class="pf-video-brand">Mazda Europe</div>
            <div class="pf-video-title">The Hidden Path</div>
            <div class="pf-video-desc">Short film · Dolomiti → Carpazi · 8 min</div>
          </div>
        </div>

        <div class="pf-video-item">
          <div class="pf-video-embed">
            <!-- <iframe src="https://www.youtube.com/embed/YOUTUBE_ID" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe> -->
            <div class="pf-video-placeholder">
              <div class="pf-play-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="pf-placeholder-hint">Video 2 — Short film / campagna</span>
            </div>
          </div>
          <div class="pf-video-meta">
            <div class="pf-video-brand">—</div>
            <div class="pf-video-title">Titolo progetto</div>
            <div class="pf-video-desc">Tipo video · Luogo · Durata</div>
          </div>
        </div>

        <div class="pf-video-item">
          <div class="pf-video-embed">
            <!-- <iframe src="https://www.youtube.com/embed/YOUTUBE_ID" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe> -->
            <div class="pf-video-placeholder">
              <div class="pf-play-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="pf-placeholder-hint">Video 3 — Reel brand / campagna</span>
            </div>
          </div>
          <div class="pf-video-meta">
            <div class="pf-video-brand">—</div>
            <div class="pf-video-title">Titolo progetto</div>
            <div class="pf-video-desc">Tipo video · Luogo · Durata</div>
          </div>
        </div>

        <div class="pf-video-item">
          <div class="pf-video-embed">
            <!-- <iframe src="https://www.youtube.com/embed/YOUTUBE_ID" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe> -->
            <div class="pf-video-placeholder">
              <div class="pf-play-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="pf-placeholder-hint">Video 4 — Documentario / reportage</span>
            </div>
          </div>
          <div class="pf-video-meta">
            <div class="pf-video-brand">—</div>
            <div class="pf-video-title">Titolo progetto</div>
            <div class="pf-video-desc">Tipo video · Luogo · Durata</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CAMPAGNE ── -->
  <section class="pf-section" id="campagne">
    <div class="pf-inner">
      <div class="pf-label">Campagne</div>

      <div class="pf-cases">

        <!-- CAMPAGNA 1 -->
        <div class="pf-case" data-case="mazda">
          <button class="pf-case-header" aria-expanded="false" aria-controls="pf-case-mazda">
            <div class="pf-case-header-left">
              <div class="pf-case-num">01</div>
              <div>
                <div class="pf-case-client">Mazda Europe</div>
                <div class="pf-case-title">The Hidden Path</div>
              </div>
            </div>
            <div class="pf-case-header-right">
              <div class="pf-case-tags">
                <span>Short film</span>
                <span>Fotografia</span>
                <span>Social content</span>
                <span>Product placement</span>
              </div>
              <div class="pf-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="pf-case-body" id="pf-case-mazda">
            <div class="pf-case-body-inner">
              <p class="pf-case-desc">Un viaggio dalle Dolomiti ai Monti Carpazi in Romania, sulle tracce dell'orso bruno. Racconto della Mazda CX-60 come compagna di percorsi estremi — sterrate, ambienti wild e remoti, migliaia di chilometri di wilderness.</p>
              <div class="pf-case-gallery">
                <!-- Sostituisci i placeholder con le immagini reali -->
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 1</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 2</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 3</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 4</span></div>
              </div>
              <div class="pf-case-film">
                <iframe src="https://www.youtube.com/embed/G1LZG6bczmw" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          </div>
        </div>

        <!-- CAMPAGNA 2 -->
        <div class="pf-case" data-case="nikon">
          <button class="pf-case-header" aria-expanded="false" aria-controls="pf-case-nikon">
            <div class="pf-case-header-left">
              <div class="pf-case-num">02</div>
              <div>
                <div class="pf-case-client">Nikon</div>
                <div class="pf-case-title">Titolo campagna</div>
              </div>
            </div>
            <div class="pf-case-header-right">
              <div class="pf-case-tags">
                <span>Fotografia</span>
                <span>Social content</span>
              </div>
              <div class="pf-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="pf-case-body" id="pf-case-nikon">
            <div class="pf-case-body-inner">
              <p class="pf-case-desc">Descrizione del progetto e degli obiettivi della campagna.</p>
              <div class="pf-case-gallery">
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 1</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 2</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 3</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 4</span></div>
              </div>
              <!-- Rimuovi il commento quando hai il video -->
              <!-- <div class="pf-case-film">
                <iframe src="https://www.youtube.com/embed/YOUTUBE_ID" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div> -->
            </div>
          </div>
        </div>

        <!-- CAMPAGNA 3 -->
        <div class="pf-case" data-case="fourseas">
          <button class="pf-case-header" aria-expanded="false" aria-controls="pf-case-fourseas">
            <div class="pf-case-header-left">
              <div class="pf-case-num">03</div>
              <div>
                <div class="pf-case-client">Four Seasons</div>
                <div class="pf-case-title">Titolo campagna</div>
              </div>
            </div>
            <div class="pf-case-header-right">
              <div class="pf-case-tags">
                <span>Reportage</span>
                <span>Fotografia</span>
              </div>
              <div class="pf-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="pf-case-body" id="pf-case-fourseas">
            <div class="pf-case-body-inner">
              <p class="pf-case-desc">Descrizione del progetto e degli obiettivi della campagna.</p>
              <div class="pf-case-gallery">
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 1</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 2</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 3</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 4</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- CAMPAGNA 4 — duplica questo blocco per aggiungerne altre -->
        <div class="pf-case" data-case="altro">
          <button class="pf-case-header" aria-expanded="false" aria-controls="pf-case-altro">
            <div class="pf-case-header-left">
              <div class="pf-case-num">04</div>
              <div>
                <div class="pf-case-client">Brand</div>
                <div class="pf-case-title">Titolo campagna</div>
              </div>
            </div>
            <div class="pf-case-header-right">
              <div class="pf-case-tags">
                <span>Tipo</span>
              </div>
              <div class="pf-case-arrow">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
          </button>
          <div class="pf-case-body" id="pf-case-altro">
            <div class="pf-case-body-inner">
              <p class="pf-case-desc">Descrizione del progetto.</p>
              <div class="pf-case-gallery">
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 1</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 2</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 3</span></div>
                <div class="pf-case-photo pf-case-photo-ph"><span>Foto progetto 4</span></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CTA CONTATTO ── -->
  <section class="pf-section pf-cta-section">
    <div class="pf-inner pf-cta-inner">
      <div class="pf-cta-label">Lavoriamo insieme</div>
      <h2 class="pf-cta-title">Hai un progetto in mente?</h2>
      <p class="pf-cta-sub">Raccontaci l'obiettivo — costruiamo insieme il formato giusto.</p>
      <a href="mailto:info@unmarked.it" class="pf-cta-btn">Scrivici</a>
    </div>
  </section>

</BaseLayout>

<!-- ── ACCORDION JS ── -->
<script>
  document.querySelectorAll('.pf-case-header').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      // chiudi tutti
      document.querySelectorAll('.pf-case-header').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        b.closest('.pf-case').classList.remove('is-open');
      });
      // apri questo se era chiuso
      if (!expanded) {
        btn.setAttribute('aria-expanded', 'true');
        btn.closest('.pf-case').classList.add('is-open');
      }
    });
  });
</script>

<style>
  /* ── HERO ── */
  .pf-hero {
    position: relative;
    height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--dark);
  }
  .pf-hero-bg {
    position: absolute;
    inset: 0;
    background: var(--dark);
  }
  .pf-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,24,20,0.95) 0%, rgba(26,24,20,0.5) 100%);
  }
  .pf-hero-content {
    position: relative;
    padding: 56px;
    max-width: 860px;
  }
  .pf-hero-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 20px;
  }
  .pf-hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 72px;
    font-weight: 300;
    color: #FAFAF8;
    line-height: 1.05;
    margin: 0 0 20px;
  }
  .pf-hero-sub {
    font-size: 15px;
    font-weight: 300;
    color: rgba(250,250,248,0.6);
    line-height: 1.7;
    max-width: 500px;
  }

  /* ── LAYOUT ── */
  .pf-section { padding: 80px 0; }
  .pf-section-dark { background: var(--dark); }
  .pf-inner { max-width: 1100px; margin: 0 auto; padding: 0 56px; }

  .pf-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 48px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pf-label::before {
    content: '';
    display: block;
    width: 24px;
    height: 1px;
    background: var(--terra);
  }
  .pf-label-light { color: var(--sand); }
  .pf-label-light::before { background: var(--sand); }

  /* ── FOTOGRAFIA GRID ── */
  .pf-photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
  }
  .pf-photo-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .pf-photo-item.pf-photo-large {
    grid-column: span 2;
  }
  .pf-photo-placeholder {
    aspect-ratio: 4/3;
    background: var(--beige);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }
  .pf-photo-item.pf-photo-large .pf-photo-placeholder {
    aspect-ratio: 16/9;
  }
  /* Quando hai l'immagine reale: aggiungi style="background-image:url('...')" e background-size/position */
  .pf-photo-placeholder.has-image {
    background-size: cover;
    background-position: center;
  }
  .pf-placeholder-hint {
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    text-align: center;
    padding: 12px;
  }
  .pf-photo-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: var(--cream);
    border-bottom: 1px solid var(--light-border);
  }
  .pf-photo-brand {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terra);
  }
  .pf-photo-caption {
    font-size: 10px;
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  /* ── VIDEO GRID ── */
  .pf-video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .pf-video-item { display: flex; flex-direction: column; gap: 16px; }
  .pf-video-embed {
    position: relative;
    aspect-ratio: 16/9;
    background: rgba(250,250,248,0.05);
    border: 1px solid rgba(201,185,154,0.12);
    overflow: hidden;
  }
  .pf-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .pf-video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .pf-play-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(201,185,154,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(250,250,248,0.4);
  }
  .pf-play-icon svg { width: 22px; height: 22px; }
  .pf-video-meta { }
  .pf-video-brand {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 6px;
  }
  .pf-video-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 300;
    color: #FAFAF8;
    margin-bottom: 6px;
  }
  .pf-video-desc {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: rgba(250,250,248,0.35);
  }

  /* ── CAMPAGNE ACCORDION ── */
  .pf-cases { display: flex; flex-direction: column; }
  .pf-case { border-top: 1px solid var(--light-border); }
  .pf-case:last-child { border-bottom: 1px solid var(--light-border); }

  .pf-case-header {
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    text-align: left;
  }
  .pf-case-header:hover .pf-case-client { color: var(--terra); }

  .pf-case-header-left {
    display: flex;
    align-items: center;
    gap: 28px;
    flex: 1;
    min-width: 0;
  }
  .pf-case-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    width: 20px;
  }
  .pf-case-client {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dark);
    margin-bottom: 6px;
    transition: color 0.2s;
  }
  .pf-case-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 300;
    color: var(--dark);
    line-height: 1.1;
  }
  .pf-case-header-right {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }
  .pf-case-tags {
    display: flex;
