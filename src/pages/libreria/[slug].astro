---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinazioneCard from '../../components/DestinazioneCard.astro';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';

export async function getStaticPaths() {
  const destinazioni = await getCollection('libreria');
  return destinazioni.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'libreria'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;

const formattedDate = data.publishDate.toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Articoli correlati: 3 destinazioni più recenti, escluso quello attuale
const tutte = await getCollection('libreria');
const correlati = tutte
  .filter((e) => e.slug !== entry.slug)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

// Itinerario correlato — il CMS salva il titolo, cerchiamo per titolo
let itinerarioCorrelato: CollectionEntry<'itinerari'> | undefined;
if (data.relatedItinerary) {
  const tuttiItinerari = await getCollection('itinerari');
  itinerarioCorrelato = tuttiItinerari.find(
    (it) => it.data.title.toLowerCase() === data.relatedItinerary!.toLowerCase()
  );
}

// Renderizza bodyText2 da markdown
const bodyText2Html = data.bodyText2 ? await marked(data.bodyText2) : '';
---

<BaseLayout
  title={`${data.title} — Unmarked`}
  description={data.seoMetaDescription || data.excerpt}
  ogImage={data.coverImage.src}
>

  <!-- BARRA DI LETTURA -->
  <div class="reading-bar" id="reading-bar"></div>

  <article>
    <!-- HERO cinematica con parallax -->
    <header class="article-hero">
      <img src={data.coverImage.src} alt={data.coverImageAlt} class="article-hero-bg" id="article-hero-bg" />
      <div class="article-hero-overlay"></div>
      <div class="article-hero-content">
        <div class="article-tag">
          {data.category || 'Libreria'}{data.country ? ` · ${data.country}` : ''}{data.continent ? ` · ${data.continent}` : ''}{data.region ? ` · ${data.region}` : ''}
        </div>
        <h1 class="article-title">{data.title}</h1>
        {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
        <div class="article-meta">{formattedDate}</div>
      </div>
    </header>

    <!-- APERTURA: striscia scura con excerpt + meta -->
    <div class="article-apertura">
      <div class="article-apertura-inner">
        <p class="article-apertura-excerpt">{data.excerpt}</p>
        <div class="article-apertura-meta">
          <span>{formattedDate}</span>
          {data.category && <span class="article-apertura-dot">·</span>}
          {data.category && <span>{data.category}</span>}
        </div>
      </div>
    </div>

    <!-- BODY editoriale con drop cap -->
    <div class="article-body">
      <Content />
    </div>

    <!-- INTERLUDIO foto full-screen -->
    {data.interludeImage && (
      <section class="article-interlude">
        <img src={data.interludeImage.src} alt={data.interludeCaption || data.coverImageAlt} class="article-interlude-img" />
        {data.interludeCaption && <div class="article-interlude-caption">{data.interludeCaption}</div>}
      </section>
    )}

    <!-- PULL QUOTE full-bleed -->
    {data.pullQuote && (
      <section class="article-pullquote">
        <blockquote>
          <p>{data.pullQuote}</p>
        </blockquote>
      </section>
    )}

    <!-- CORPO ARTICOLO 2 -->
    {data.bodyText2 && (
      <div class="article-body article-body-2">
        <Fragment set:html={bodyText2Html} />
      </div>
    )}

    <!-- SCHEDE EDITORIALI -->
    {data.schede && data.schede.length > 0 && (
      <div class="article-schede">
        {data.schede.map((s) => (
          <div class="article-scheda">
            <div class="article-scheda-label">{s.label}</div>
            <div class="article-scheda-text">{s.text}</div>
          </div>
        ))}
      </div>
    )}

    <!-- GALLERIA 2 -->
    {data.gallery2 && data.gallery2.length > 0 && (
      <section class="article-gallery-2">
        <div class="gallery-grid">
          {data.gallery2.map((item) => (
            <figure class="gallery-item">
              <div class="gallery-img-wrap">
                <img src={item.image.src} alt={item.caption || 'Foto'} />
              </div>
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ESSENZIALE DA SAPERE -->
    {data.essentialToKnow && data.essentialToKnow.length > 0 && (
      <section class="article-essential">
        <div class="essential-inner">
          <div class="essential-title">Essenziale da sapere</div>
          <div class="essential-grid">
            {data.essentialToKnow.map((tip) => (
              <div class="essential-item">
                <h3 class="essential-item-title">{tip.title}</h3>
                <p class="essential-item-desc">{tip.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- MAPPA Leaflet -->
    {data.mapCenter?.lat && data.mapCenter?.lng && (
      <section class="article-map-section">
        <div class="article-map-head">
          <div class="article-map-title">Dove siamo stati</div>
        </div>
        <div
          id="leaflet-map"
          class="article-map"
          data-center={JSON.stringify(data.mapCenter)}
          data-markers={JSON.stringify(data.mapMarkers || [])}
        ></div>
      </section>
    )}

    <!-- CTA ITINERARIO CORRELATO -->
    {itinerarioCorrelato && (
      <section class="article-itinerario-cta">
        <div class="cta-inner">
          <div class="cta-eyebrow">C'è un itinerario per questo posto</div>
          <h2 class="cta-headline">Hai letto la storia.<br />Adesso vai.</h2>
          <p class="cta-sub">
            Te lo abbiamo costruito noi: giorno per giorno, contatti locali verificati, budget reali, mappe offline.
            Quello che non leggi mai sui blog.
          </p>
          <a href={`/itinerari/${itinerarioCorrelato.slug}`} class="cta-card">
            <div class="cta-card-img">
              <img src={itinerarioCorrelato.data.coverImage.src} alt={itinerarioCorrelato.data.coverImageAlt} />
              <div class="cta-card-price">€{itinerarioCorrelato.data.price}</div>
            </div>
            <div class="cta-card-info">
              <div class="cta-card-tag">{itinerarioCorrelato.data.country} · {itinerarioCorrelato.data.duration} giorni</div>
              <h3 class="cta-card-title">{itinerarioCorrelato.data.title}</h3>
              <p class="cta-card-excerpt">{itinerarioCorrelato.data.excerpt}</p>
              <span class="cta-card-action">Scopri l'itinerario →</span>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- FINE ARTICOLO -->
    <div class="article-end">
      <div class="article-end-line"></div>
      <div class="article-end-mark">Unmarked</div>
      <div class="article-end-line"></div>
    </div>

    <!-- ARTICOLI CORRELATI -->
    {correlati.length > 0 && (
      <section class="article-related">
        <div class="related-head">
          <h2 class="related-title">Reportage correlati</h2>
          <a href="/libreria" class="related-link">Tutta la libreria →</a>
        </div>
        <div class="related-grid">
          {correlati.map((e) => <DestinazioneCard entry={e} />)}
        </div>
      </section>
    )}

    <nav class="article-back">
      <a href="/libreria" class="back-link">← Tutta la libreria</a>
    </nav>
  </article>

  <!-- Barra di lettura -->
  <script is:inline>
    (function() {
      var bar = document.getElementById('reading-bar');
      var article = document.querySelector('article');
      if (!bar || !article) return;
      function update() {
        var rect = article.getBoundingClientRect();
        var total = article.offsetHeight - window.innerHeight;
        var progress = Math.min(Math.max(-rect.top / total, 0), 1);
        bar.style.width = (progress * 100) + '%';
      }
      window.addEventListener('scroll', update, { passive: true });
      update();
    })();
  </script>

  <!-- Parallax sottile sulla hero -->
  <script is:inline>
    (function () {
      var img = document.getElementById('article-hero-bg');
      if (!img) return;
      var hero = img.parentElement;
      function onScroll() {
        var rect = hero.getBoundingClientRect();
        if (rect.bottom < 0) return;
        var y = -rect.top * 0.25;
        img.style.transform = 'translate3d(0, ' + y + 'px, 0) scale(1.08)';
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>

  <!-- Leaflet: caricamento dinamico per non interrompere ViewTransitions -->
  {data.mapCenter?.lat && data.mapCenter?.lng && (
    <script is:inline>
      async function initLeafletMap() {
        var mapEl = document.getElementById('leaflet-map');
        if (!mapEl) return;

        if (!document.querySelector('link[href*="leaflet"]')) {
          await new Promise(function(resolve) {
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
            link.onload = resolve;
            document.head.appendChild(link);
          });
        }

        if (!window.L) {
          await new Promise(function(resolve) {
            var s = document.createElement('script');
            s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
            s.onload = resolve;
            document.head.appendChild(s);
          });
        }

        if (mapEl._leaflet_id) return;
        var center = JSON.parse(mapEl.dataset.center);
        var markers = JSON.parse(mapEl.dataset.markers || '[]');
        var map = L.map('leaflet-map').setView([center.lat, center.lng], center.zoom || 8);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          attribution: '© OpenStreetMap © CARTO',
          subdomains: 'abcd',
          maxZoom: 14,
        }).addTo(map);
        markers.forEach(function(m) {
          L.marker([m.lat, m.lng]).addTo(map).bindPopup(m.label);
        });
      }

      document.addEventListener('astro:page-load', initLeafletMap);
    </script>
  )}
</BaseLayout>

<style>
  /* HERO con parallax */
  .article-hero {
    position: relative;
    min-height: 80vh;
    height: 720px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 60px 56px 70px;
  }
  .article-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform: translate3d(0, 0, 0) scale(1.08);
  }
  .article-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(26,24,20,0.78) 0%, rgba(26,24,20,0.2) 55%, rgba(26,24,20,0) 100%);
  }
  .article-hero-content {
    position: relative;
    color: #FAFAF8;
    max-width: 880px;
  }
  .article-tag {
    font-size: 10px;
    font-weight: 300;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--sand);
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .article-tag::before {
    content: '';
    display: inline-block;
    width: 36px;
    height: 1px;
    background: var(--terra);
  }
  .article-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 78px;
    font-weight: 300;
    line-height: 1.0;
    margin: 0 0 22px;
    letter-spacing: 0.005em;
    max-width: 900px;
  }
  .article-subtitle {
    font-size: 19px;
    font-weight: 300;
    color: rgba(250, 250, 248, 0.85);
    line-height: 1.5;
    margin: 0 0 26px;
    max-width: 720px;
    font-style: italic;
  }
  .article-meta {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.55);
  }

  /* APERTURA */
  .article-apertura {
    background: var(--dark);
    border-bottom: 1px solid rgba(201,185,154,0.15);
  }
  .article-apertura-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 40px 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .article-apertura-excerpt {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.55;
    color: rgba(250,250,248,0.82);
    margin: 0;
    padding-left: 24px;
    border-left: 2px solid var(--terra);
  }
  .article-apertura-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(250,250,248,0.3);
  }
  .article-apertura-dot { color: var(--terra); }

  /* BODY editoriale */
  .article-body {
    max-width: 680px;
    margin: 0 auto;
    padding: 72px 40px 80px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.75;
    color: var(--dark);
    counter-reset: section;
  }
  .article-body :global(p:first-of-type::first-letter) {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: 88px;
    line-height: 0.85;
    float: left;
    padding: 8px 14px 0 0;
    color: var(--terra);
    margin-top: 4px;
  }
  .article-body :global(p) { margin-bottom: 26px; }
  .article-body :global(h2) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin: 64px 0 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(177,113,74,0.25);
    counter-increment: section;
  }
  .article-body :global(h2::before) {
    content: counter(section, decimal-leading-zero) " — ";
    color: rgba(177,113,74,0.45);
    font-size: 10px;
    letter-spacing: 0.2em;
    margin-right: 4px;
  }
  .article-body :global(h3) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 300;
    line-height: 1.3;
    margin: 44px 0 14px;
    color: var(--dark);
  }
  .article-body :global(blockquote) {
    border: 0;
    border-left: 3px solid var(--terra);
    padding: 8px 0 8px 28px;
    margin: 52px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    font-style: italic;
    line-height: 1.5;
    color: var(--dark);
  }
  .article-body :global(blockquote p) { margin: 0; }
  .article-body :global(a) {
    color: var(--terra);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .article-body :global(img) {
    display: block;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: 56px;
    margin-bottom: 12px;
    border-radius: 0;
  }

  /* CORPO ARTICOLO 2 */
  .article-body-2 {
    margin-top: 60px;
    margin-bottom: 60px;
  }

  /* GALLERIA 2 */
  .article-gallery-2 {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: 80px;
    margin-bottom: 80px;
    padding: 0 40px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .gallery-item {
    margin: 0;
    overflow: visible;
    position: relative;
  }
  .gallery-item .gallery-img-wrap {
    overflow: hidden;
  }
  .gallery-item img {
    display: block;
    width: 100%;
    height: 400px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gallery-item:hover img { transform: scale(1.03); }

  /* ESSENZIALE DA SAPERE */
  .article-essential {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--dark);
    padding: 72px 40px;
    margin-top: 80px;
    margin-bottom: 80px;
  }
  .essential-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .essential-title {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--terra);
    margin: 0 0 48px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .essential-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(201,185,154,0.15);
  }
  .essential-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    border-top: 1px solid rgba(201,185,154,0.12);
  }
  .essential-item {
    padding: 32px 28px 32px 0;
    border-bottom: 1px solid rgba(201,185,154,0.12);
    border-right: 1px solid rgba(201,185,154,0.12);
  }
  .essential-item:nth-child(3n) { border-right: none; }
  .essential-item-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 300;
    color: #FAFAF8;
    margin: 0 0 10px;
    line-height: 1.25;
  }
  .essential-item-desc {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(250,250,248,0.45);
    margin: 0;
  }

  /* INTERLUDIO foto full-screen */
  .article-interlude {  padding: 0;
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: 80px;
    margin-bottom: 80px;
  }
  .article-interlude-img {
    display: block;
    width: 100vw;
    height: 90vh;
    object-fit: cover;
  }
  .article-interlude-caption {
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-style: italic;
    color: var(--muted);
    margin-top: 12px;
    padding: 0 40px;
    font-weight: 300;
  }

  /* PULL QUOTE full-bleed */
  .article-pullquote {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--dark);
    padding: 80px 40px;
    margin-top: 0;
    margin-bottom: 80px;
  }
  .article-pullquote blockquote {
    border: 0;
    margin: 0 auto;
    max-width: 720px;
    text-align: center;
    border-top: 1px solid rgba(201,185,154,0.25);
    border-bottom: 1px solid rgba(201,185,154,0.25);
    padding: 48px 0;
  }
  .article-pullquote blockquote p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.4;
    color: #FAFAF8;
    letter-spacing: 0.01em;
    margin: 0;
  }

  /* MAPPA */
  .article-map-section {
    max-width: 1100px;
    margin: 0 auto 80px;
    padding: 0 40px;
  }
  .article-map-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .article-map-title {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin: 0;
  }
  .article-map-head::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--light-border);
  }
  .article-map {
    height: 400px;
    overflow: hidden;
    border: 1px solid var(--light-border);
  }

  /* CTA ITINERARIO CORRELATO */
  .article-itinerario-cta {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--beige);
    padding: 40px 40px;
    margin-bottom: 60px;
  }
  .cta-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .cta-eyebrow {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 10px;
  }
  .cta-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 300;
    line-height: 1.0;
    color: var(--dark);
    margin: 0 0 10px;
    letter-spacing: 0.005em;
  }
  .cta-sub {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 380px;
  }
  .cta-card {
    background: #fff;
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: grid;
    grid-template-columns: 200px 1fr;
    box-shadow: 0 8px 28px rgba(26, 24, 20, 0.12);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .cta-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(26, 24, 20, 0.18);
  }
  .cta-card-img {
    position: relative;
    overflow: hidden;
    min-height: 140px;
  }
  .cta-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-card-price {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: var(--terra);
    color: #fff;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    padding: 4px 12px;
    border-radius: 2px;
    letter-spacing: 0.02em;
  }
  .cta-card-info {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cta-card-tag {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 8px;
  }
  .cta-card-title {
