---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DestinazioniArchive from '../../../components/DestinazioniArchive.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tutte = await getCollection('libreria');
  const paesi = [...new Set(tutte.map((e) => e.data.country).filter(Boolean))] as string[];
  return paesi.map((paese) => ({
    params: { paese: paese.toLowerCase().replace(/\s+/g, '-') },
    props: {
      paese,
      entries: tutte
        .filter((e) => e.data.country === paese)
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
      allContinenti: [...new Set(tutte.map((e) => e.data.continent).filter(Boolean))].sort(),
    },
  }));
}

const { paese, entries, allContinenti } = Astro.props;
const slugify = (s) => s.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout
  title={`${paese} — Destinazioni — Unmarked`}
  description={`Reportage e racconti di viaggio dal ${paese}.`}
>
  <DestinazioniArchive
    items={entries}
    continenti={allContinenti}
    eyebrow="Destinazioni · Paese"
    title={paese}
    description={`${entries.length} ${entries.length === 1 ? 'reportage' : 'reportage'} dal ${paese}.`}
    currentPaese={slugify(paese)}
    backLink={true}
  />
</BaseLayout>
