---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinazioniArchive from '../../components/DestinazioniArchive.astro';
import { getCollection } from 'astro:content';

const tutte = (await getCollection('libreria')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const continenti = [...new Set(tutte.map((e) => e.data.continent).filter(Boolean))].sort();
---

<BaseLayout
  title="Libreria — Unmarked"
  description="Destinazioni, attrezzatura, consigli di viaggio e ispirazione fotografica. Tutto quello che serve per fotografare il mondo."
>
  <DestinazioniArchive
    items={tutte}
    continenti={continenti}
    eyebrow="Libreria · Unmarked"
    title="Libreria"
    description="Destinazioni, attrezzatura, consigli e ispirazione. Tutto quello che serve per fotografare il mondo."
    grouped={true}
  />
</BaseLayout>
