---
// Pagina nascosta — non in navigazione, noindex
// Accessibile solo tramite link diretto: /northernlinepremier
export const prerender = true;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Northern Line — Première · Unmarked</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --dark: #0E0C0A;
      --dark2: #161310;
      --terra: #C4855A;
      --cream: #FAFAF8;
      --muted: rgba(250,250,248,0.45);
      --border: rgba(201,185,154,0.15);
    }

    html, body {
      background: var(--dark);
      color: var(--cream);
      font-family: 'Inter', sans-serif;
      font-weight: 300;
      min-height: 100vh;
    }

    /* ── HEADER ── */
    .nlp-header {
      padding: 28px 40px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nlp-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      font-weight: 400;
      letter-spacing: 0.12em;
      color: var(--cream);
      text-decoration: none;
      text-transform: uppercase;
    }
    .nlp-logo-dot {
      color: var(--terra);
    }
    .nlp-header-label {
      font-size: 9px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--terra);
    }

    /* ── CINEMATIC HERO ── */
    .nlp-hero {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      overflow: hidden;
      display: block;
    }
    .nlp-hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    /* Gradient: solo fade sul fondo per raccordo con la pagina */
    .nlp-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(14,12,10,0.0) 0%,
        rgba(14,12,10,0.0) 70%,
        rgba(14,12,10,0.85) 100%
      );
    }
    .nlp-hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 0 40px;
    }
    .nlp-eyebrow {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--terra);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    .nlp-eyebrow::before,
    .nlp-eyebrow::after {
      content: '';
      display: block;
      width: 32px;
      height: 1px;
      background: var(--terra);
      opacity: 0.6;
    }
    .nlp-film-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(64px, 10vw, 120px);
      font-weight: 300;
      font-style: italic;
      line-height: 0.9;
      color: var(--cream);
      letter-spacing: -0.01em;
      margin-bottom: 14px;
      text-shadow: 0 2px 40px rgba(0,0,0,0.4);
    }
    .nlp-film-sub {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(12px, 1.5vw, 16px);
      font-weight: 300;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: rgba(250,250,248,0.45);
    }
    /* Sezione testo sotto l'hero */
    .nlp-intro-wrap {
      max-width: 700px;
      margin: 0 auto;
      padding: 72px 40px 64px;
      text-align: center;
    }
    .nlp-divider {
      width: 48px;
      height: 1px;
      background: var(--terra);
      opacity: 0.5;
      margin: 0 auto 40px;
    }
    .nlp-invite-text {
      font-family: 'Inter', sans-serif;
      font-size: clamp(14px, 1.6vw, 17px);
      font-weight: 300;
      color: rgba(250,250,248,0.65);
      line-height: 1.8;
    }
    .nlp-invite-text em {
      font-style: italic;
      color: rgba(250,250,248,0.85);
    }

    /* ── EVENT INFO ── */
    .nlp-info {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--border);
      border: 1px solid var(--border);
      max-width: 720px;
      margin: 0 auto 80px;
    }
    .nlp-info-cell {
      background: var(--dark2);
      padding: 28px 24px;
      text-align: center;
    }
    .nlp-info-label {
      font-size: 8px;
      font-weight: 500;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--terra);
      margin-bottom: 10px;
    }
    .nlp-info-val {
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px;
      font-weight: 400;
      color: var(--cream);
      line-height: 1.4;
    }
    .nlp-info-small {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
      font-family: 'Inter', sans-serif;
      font-weight: 300;
    }

    /* ── SINOSSI ── */
    .nlp-synopsis {
      max-width: 680px;
      margin: 0 auto 72px;
      padding: 0 40px;
      text-align: center;
    }
    .nlp-synopsis-text {
      font-family: 'Inter', sans-serif;
      font-size: clamp(13px, 1.4vw, 15px);
      font-weight: 300;
      line-height: 1.9;
      color: rgba(250,250,248,0.5);
    }
    .nlp-synopsis-text em {
      font-style: italic;
      color: rgba(250,250,248,0.72);
    }

    /* ── PREMI ── */
    .nlp-awards {
      max-width: 680px;
      margin: 0 auto 80px;
      padding: 0 40px;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 40px;
      flex-wrap: wrap;
    }
    .nlp-award {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-align: center;
    }
    .nlp-award-icon {
      width: 36px;
      height: 36px;
      color: rgba(201,185,154,0.6);
    }
    .nlp-award-title {
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--terra);
      line-height: 1.5;
    }
    .nlp-award-festival {
      font-size: 10px;
      font-weight: 300;
      color: rgba(250,250,248,0.35);
      letter-spacing: 0.08em;
      line-height: 1.5;
    }
    .nlp-awards-divider {
      width: 1px;
      height: 48px;
      background: var(--border);
      align-self: center;
    }

    /* ── PROGRAM ── */
    .nlp-program {
      max-width: 560px;
      margin: 0 auto 96px;
      border-top: 1px solid var(--border);
      padding-top: 48px;
    }
    .nlp-section-label {
      font-size: 8px;
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--terra);
      margin-bottom: 32px;
      text-align: center;
    }
    .nlp-prog-row {
      display: flex;
      align-items: baseline;
      gap: 20px;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
    }
    .nlp-prog-time {
      font-family: 'Cormorant Garamond', serif;
      font-size: 14px;
      font-weight: 400;
      color: var(--terra);
      min-width: 48px;
      flex-shrink: 0;
    }
    .nlp-prog-event {
      font-family: 'Cormorant Garamond', serif;
      font-size: 17px;
      font-weight: 300;
      color: var(--cream);
    }
    .nlp-prog-note {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    /* ── FORM ── */
    .nlp-form-wrap {
      max-width: 560px;
      margin: 0 auto 96px;
      border-top: 1px solid var(--border);
      padding-top: 48px;
    }
    .nlp-form-intro {
      text-align: center;
      margin-bottom: 36px;
    }
    .nlp-form-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px;
      font-weight: 300;
      color: var(--cream);
      margin-bottom: 10px;
    }
    .nlp-form-note {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.7;
    }
    .nlp-badge-limited {
      display: inline-block;
      font-size: 8px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dark);
      background: var(--terra);
      padding: 4px 10px;
      margin-bottom: 14px;
    }

    form .nlp-field {
      margin-bottom: 20px;
    }
    form label {
      display: block;
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(250,250,248,0.45);
      margin-bottom: 8px;
    }
    form input,
    form select {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(201,185,154,0.25);
      color: var(--cream);
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 300;
      padding: 10px 0;
      outline: none;
      transition: border-color 0.2s;
      -webkit-appearance: none;
      border-radius: 0;
    }
    form input::placeholder { color: rgba(250,250,248,0.2); }
    form input:focus,
    form select:focus { border-bottom-color: var(--terra); }
    form select { cursor: pointer; }
    form select option { background: #1A1814; color: var(--cream); }

    .nlp-field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .nlp-privacy-field {
      margin-top: 8px;
    }
    .nlp-privacy-label {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      cursor: pointer;
      font-size: 11px !important;
      font-weight: 300 !important;
      color: rgba(250,250,248,0.38);
      line-height: 1.5;
      letter-spacing: 0 !important;
      text-transform: none !important;
    }
    .nlp-privacy-label input[type="checkbox"] {
      width: 14px;
      height: 14px;
      min-width: 14px;
      border: 1px solid rgba(201,185,154,0.3);
      border-bottom: 1px solid rgba(201,185,154,0.3);
      background: transparent;
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
      margin-top: 3px;
      padding: 0;
      transition: border-color 0.2s, background 0.2s;
      border-radius: 0;
    }
    .nlp-privacy-label input[type="checkbox"]:checked {
      background: var(--terra);
      border-color: var(--terra);
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 12 12' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 6l3 3 5-5' stroke='%23fff' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-size: 10px;
      background-repeat: no-repeat;
      background-position: center;
    }
    .nlp-privacy-label a {
      color: rgba(250,250,248,0.6);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .nlp-privacy-label a:hover { color: var(--terra); }

    .nlp-submit {
      margin-top: 32px;
      width: 100%;
      background: var(--terra);
      color: #fff;
      border: none;
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      padding: 16px;
      cursor: pointer;
      transition: opacity 0.2s;
    }
    .nlp-submit:hover { opacity: 0.88; }
    .nlp-submit:disabled { opacity: 0.45; cursor: not-allowed; }

    /* ── SUCCESS ── */
    .nlp-success {
      display: none;
      text-align: center;
      padding: 48px 0;
    }
    .nlp-success-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--terra);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: var(--terra);
    }
    .nlp-success h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 26px;
      font-weight: 300;
      color: var(--cream);
      margin-bottom: 10px;
    }
    .nlp-success p {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.75;
    }

    /* ── FOOTER ── */
    .nlp-footer {
      border-top: 1px solid var(--border);
      padding: 32px 40px;
      text-align: center;
      font-size: 11px;
      color: rgba(250,250,248,0.2);
      letter-spacing: 0.05em;
    }
    .nlp-footer a {
      color: rgba(250,250,248,0.3);
      text-decoration: none;
    }
    .nlp-footer a:hover { color: var(--terra); }

    /* ── POSTER MOBILE (6.5:9) ── visibile solo su mobile, sostituisce l'hero landscape */
    .nlp-poster-mobile-hero {
      display: none; /* nascosto su desktop */
      width: 100%;
      position: relative;
      aspect-ratio: 6.5/9;
      overflow: hidden;
    }
    .nlp-poster-mobile-hero img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .nlp-poster-mobile-hero .nlp-hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(14,12,10,0.1) 0%,
        rgba(14,12,10,0.0) 25%,
        rgba(14,12,10,0.6) 70%,
        rgba(14,12,10,0.97) 100%
      );
    }
    .nlp-poster-mobile-hero .nlp-hero-content {
      position: absolute;
      bottom: 64px;
      left: 0; right: 0;
    }

    /* ── TRAILER ── */
    .nlp-trailer {
      max-width: 800px;
      margin: 0 auto 80px;
      padding: 0 40px;
    }
    .nlp-trailer-label {
      font-size: 8px;
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--terra);
      margin-bottom: 16px;
      text-align: center;
    }
    .nlp-trailer-embed {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      background: #0E0C0A;
      border: 1px solid var(--border);
      overflow: hidden;
    }
    .nlp-trailer-embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    .nlp-trailer-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      color: rgba(250,250,248,0.2);
    }
    .nlp-trailer-play {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      border: 1px solid rgba(201,185,154,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .nlp-trailer-play svg { opacity: 0.3; }
    .nlp-trailer-placeholder span {
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    /* ── PARTNER STRIPE ── */
    .nlp-partners {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 36px 40px;
      margin-bottom: 80px;
      text-align: center;
    }
    .nlp-partners-label {
      font-size: 8px;
      font-weight: 500;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: rgba(250,250,248,0.25);
      margin-bottom: 28px;
    }
    .nlp-partners-logos {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 48px;
      flex-wrap: wrap;
    }
    .nlp-partner-logo {
      height: 36px;
      width: auto;
      max-width: 120px;
      object-fit: contain;
      opacity: 0.6;
      filter: brightness(0) invert(1);
      transition: opacity 0.2s;
    }
    .nlp-partner-logo:hover { opacity: 0.9; }

    @media (max-width: 640px) {
      .nlp-header { padding: 20px 24px; }
      .nlp-hero { padding: 64px 24px 60px; }
      .nlp-hero { display: none; }
      .nlp-poster-mobile-hero { display: block; }
      .nlp-intro-wrap { padding: 56px 24px 48px; }
      .nlp-info { grid-template-columns: 1fr; max-width: 100%; margin: 0 24px 56px; }
      .nlp-synopsis { padding: 0 24px; margin-bottom: 48px; }
      .nlp-awards { padding: 0 24px; gap: 24px; }
      .nlp-awards-divider { display: none; }
      .nlp-info { grid-template-columns: 1fr; max-width: 100%; margin: 0 24px 64px; }
      .nlp-partners { padding: 28px 24px; margin-bottom: 56px; }
      .nlp-partners-logos { gap: 24px; }
      .nlp-program { margin: 0 24px 64px; }
      .nlp-form-wrap { margin: 0 24px 64px; }
      .nlp-field-row { grid-template-columns: 1fr; }
      .nlp-footer { padding: 28px 24px; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="nlp-header">
    <a href="/" class="nlp-logo">Unmarked<span class="nlp-logo-dot">.</span></a>
    <span class="nlp-header-label">Première · Su invito</span>
  </header>

  <!-- HERO DESKTOP — locandina 16:9 -->
  <section class="nlp-hero">
    <img class="nlp-hero-img" src="/northernline-poster-landscape.jpg" alt="Northern Line" />
    <div class="nlp-hero-overlay"></div>
  </section>

  <!-- HERO MOBILE — locandina 6.5:9 -->
  <div class="nlp-poster-mobile-hero">
    <img src="/northernline-poster-portrait.jpg" alt="Northern Line" />
    <div class="nlp-hero-overlay"></div>
  </div>

  <!-- TESTO + INFO EVENTO -->
  <div class="nlp-intro-wrap">
    <p class="nlp-invite-text">
      Siamo felici di invitarti alla première di <em>Northern Line</em>,<br/>il nostro documentario.
    </p>
  </div>

  <!-- SINOSSI -->
  <div class="nlp-synopsis">
    <p class="nlp-synopsis-text">
      Un viaggio verso nord. <em>L'idea di cercare l'emozione delle condizioni perfette nella tranquillità della Lapponia.</em><br/><br/>
      Samuele e Alice affrontano un viaggio elettrico, lungo ma pianificato — ma il nord ha altri piani per loro.
    </p>
  </div>

  <!-- INFO EVENTO -->
  <div class="nlp-info">
    <div class="nlp-info-cell">
      <div class="nlp-info-label">Data</div>
      <div class="nlp-info-val">17 Dicembre 2026</div>
      <div class="nlp-info-small">ore 20:00</div>
    </div>
    <div class="nlp-info-cell">
      <div class="nlp-info-label">Luogo</div>
      <div class="nlp-info-val">Sala Martinovich</div>
      <div class="nlp-info-small">Bassano del Grappa</div>
    </div>
    <div class="nlp-info-cell">
      <div class="nlp-info-label">Ingresso</div>
      <div class="nlp-info-val">Libero</div>
      <div class="nlp-info-small">Prenotazione consigliata</div>
    </div>
  </div>

  <!-- TRAILER -->
  <div class="nlp-trailer">
    <div class="nlp-trailer-label">Trailer</div>
    <div class="nlp-trailer-embed">
      <video
        controls
        preload="metadata"
        poster="/northernline-poster-landscape.jpg"
        style="position:absolute;inset:0;width:100%;height:100%;display:block;background:#000;"
      >
        <source src="/northernline-trailer.mp4" type="video/mp4" />
      </video>
    </div>
  </div>

  <!-- PARTNER DELLA SERATA -->
  <div class="nlp-partners">
    <div class="nlp-partners-label">Partner della serata</div>
    <div class="nlp-partners-logos">
      <img src="/partners/partner-1.png" alt="Partner" class="nlp-partner-logo" />
      <img src="/partners/partner-2.png" alt="Partner" class="nlp-partner-logo" />
      <img src="/partners/partner-3.png" alt="Partner" class="nlp-partner-logo" />
      <img src="/partners/partner-4.png" alt="Partner" class="nlp-partner-logo" />
      <img src="/partners/partner-5.png" alt="Partner" class="nlp-partner-logo" />
    </div>
  </div>

  <!-- PROGRAMMA -->
  <div class="nlp-program">
    <div class="nlp-section-label">Programma della serata</div>
    <div class="nlp-prog-row">
      <div class="nlp-prog-time">20:00</div>
      <div>
        <div class="nlp-prog-event">Apertura porte</div>
      </div>
    </div>
    <div class="nlp-prog-row">
      <div class="nlp-prog-time">20:30</div>
      <div>
        <div class="nlp-prog-event">Proiezione — <em>Northern Line</em></div>
        <div class="nlp-prog-note">Documentario Unmarked</div>
      </div>
    </div>
    <div class="nlp-prog-row">
      <div class="nlp-prog-time">——</div>
      <div>
        <div class="nlp-prog-event">Talk con i realizzatori</div>
        <div class="nlp-prog-note">Q&amp;A, dietro le quinte, storie dal campo</div>
      </div>
    </div>
  </div>

  <!-- FORM REGISTRAZIONE -->
  <div class="nlp-form-wrap">
    <div class="nlp-form-intro">
      <div class="nlp-badge-limited">Posti limitati</div>
      <div class="nlp-form-title">Prenota il tuo posto</div>
      <p class="nlp-form-note">
        Compila il modulo per riservare il tuo ingresso.<br/>
        Riceverai una conferma via email.
      </p>
    </div>

    <!-- Netlify Forms: data-netlify="true" cattura le submission nel dashboard Netlify -->
    <form
      id="nlp-reg-form"
      name="northern-line-premier"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="northern-line-premier" />
      <p style="display:none"><label>Non compilare: <input name="bot-field" /></label></p>

      <div class="nlp-field-row">
        <div class="nlp-field">
          <label for="nome">Nome</label>
          <input type="text" id="nome" name="nome" placeholder="Il tuo nome" required />
        </div>
        <div class="nlp-field">
          <label for="cognome">Cognome</label>
          <input type="text" id="cognome" name="cognome" placeholder="Il tuo cognome" required />
        </div>
      </div>

      <div class="nlp-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="tua@email.com" required />
      </div>

      <div class="nlp-field">
        <label for="partecipanti">Numero di partecipanti</label>
        <select id="partecipanti" name="partecipanti" required>
          <option value="" disabled selected>Seleziona</option>
          <option value="1">1 persona</option>
          <option value="2">2 persone</option>
          <option value="3">3 persone</option>
          <option value="4">4 persone</option>
          <option value="5+">5 o più persone</option>
        </select>
      </div>

      <div class="nlp-field nlp-privacy-field">
        <label class="nlp-privacy-label">
          <input type="checkbox" name="privacy" required />
          <span>Ho letto l'<a href="/privacy" target="_blank">Informativa privacy</a> e acconsento al trattamento del mio nome, cognome e indirizzo e-mail per la gestione della mia adesione alla proiezione di "Northern Line" del 17 dicembre 2026 e per l'invio delle relative comunicazioni organizzative.</span>
        </label>
      </div>

      <button type="submit" class="nlp-submit" id="nlp-submit-btn">
        Prenota il mio posto
      </button>
    </form>

    <!-- Messaggio di successo -->
    <div class="nlp-success" id="nlp-success">
      <div class="nlp-success-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <h3>Posto riservato.</h3>
      <p>Ti aspettiamo il 17 dicembre alle 20:00<br/>alla Sala Martinovich, Via Ognissanti 2, Bassano del Grappa.<br/><br/>Controlla la tua email per la conferma.</p>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="nlp-footer">
    <p>Bassano del Grappa &nbsp;·&nbsp; 17 Dicembre 2026 &nbsp;·&nbsp; <a href="/">unmarked.it</a></p>
  </footer>

  <script>
    const form = document.getElementById('nlp-reg-form');
    const success = document.getElementById('nlp-success');
    const btn = document.getElementById('nlp-submit-btn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Invio in corso…';

      const data = new FormData(form);

      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString(),
        });

        if (res.ok) {
          form.style.display = 'none';
          success.style.display = 'block';
        } else {
          throw new Error();
        }
      } catch {
        btn.disabled = false;
        btn.textContent = 'Prenota il mio posto';
        alert('Qualcosa è andato storto. Riprova o scrivi a info@unmarked.it');
      }
    });
  </script>

</body>
</html>
