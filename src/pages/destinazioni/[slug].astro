---
import { getCollection } from 'astro:content';
export const prerender = true;

export async function getStaticPaths() {
  const libreria = await getCollection('libreria');
  return libreria.map((entry) => ({
    params: { slug: entry.slug },
  }));
}
const { slug } = Astro.params;
---
<meta http-equiv="refresh" content={`0;url=/libreria/${slug}`} />
<script define:vars={{ slug }}>window.location.replace('/libreria/' + slug);</script>
