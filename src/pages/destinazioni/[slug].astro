---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const destinazioni = await getCollection('destinazioni');
  return destinazioni.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'destinazioni'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { data } = entry;

const formattedDate = data.publishDate.toLocaleDateString('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${data.title} — Unmarked`}
  description={data.seoMetaDescription || data.excerpt}
  ogImage={data.coverImage.src}
>
  <article>
    <header class="article-hero">
      <img
        src={data.coverImage.src}
        alt={data.coverImageAlt}
        class="article-hero-bg"
      />
      <div class="article-hero-overlay"></div>
      <div class="article-hero-content">
        <div class="article-tag">
          {data.country} · {data.continent}{data.region ? ` · ${data.region}` : ''}
        </div>
        <h1 class="article-title">{data.title}</h1>
        {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
        <div class="article-meta">{formattedDate}</div>
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <nav class="article-back">
      <a href="/destinazioni" class="back-link">← Tutte le destinazioni</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .article-hero {
    position: relative;
    height: 480px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 52px 48px;
  }
  .article-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(26,24,20,0.78) 0%, rgba(26,24,20,0.25) 55%, rgba(26,24,20,0.05) 100%);
  }
  .article-hero-content {
    position: relative;
    color: #FAFAF8;
    max-width: 800px;
  }
  .article-tag {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--sand);
    margin-bottom: 14px;
  }
  .article-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 56px;
    font-weight: 300;
    line-height: 1.05;
    margin-bottom: 16px;
    letter-spacing: 0.01em;
  }
  .article-subtitle {
    font-size: 16px;
    color: rgba(250, 250, 248, 0.75);
    line-height: 1.5;
    margin-bottom: 18px;
    max-width: 640px;
  }
  .article-meta {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.55);
  }
  .article-body {
    max-width: 720px;
    margin: 60px auto 60px;
    padding: 0 40px;
    font-size: 16px;
    line-height: 1.78;
    color: var(--dark);
  }
  .article-body :global(h2) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 300;
    line-height: 1.2;
    margin: 44px 0 14px;
  }
  .article-body :global(h3) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.3;
    margin: 36px 0 10px;
  }
  .article-body :global(p) {
    margin-bottom: 18px;
  }
  .article-body :global(blockquote) {
    border-left: 2px solid var(--terra);
    padding-left: 24px;
    margin: 32px 0;
    font-style: italic;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }
  .article-body :global(img) {
    width: 100%;
    border-radius: 3px;
    margin: 32px 0 6px;
  }
  .article-body :global(a) {
    color: var(--terra);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-back {
    max-width: 720px;
    margin: 0 auto 80px;
    padding: 0 40px;
  }
  .back-link {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terra);
    text-decoration: none;
  }
  .back-link:hover {
    text-decoration: underline;
  }
</style>
