---
import { getCollection } from 'astro:content';
export const prerender = true;

export async function getStaticPaths() {
  const libreria = await getCollection('libreria');
  const continenti = [...new Set(libreria.map((e) => e.data.continent).filter(Boolean))];
  return continenti.map((c) => ({
    params: { continente: c.toLowerCase().replace(/\s+/g, '-') },
  }));
}
const { continente } = Astro.params;
---
<meta http-equiv="refresh" content={`0;url=/libreria/continente/${continente}`} />
<script define:vars={{ continente }}>window.location.replace('/libreria/continente/' + continente);</script>
