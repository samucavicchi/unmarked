---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DestinazioniArchive from '../../../components/DestinazioniArchive.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tutte = await getCollection('destinazioni');
  const continenti = [...new Set(tutte.map((e) => e.data.continent))];
  return continenti.map((continente) => ({
    params: { continente: continente.toLowerCase().replace(/\s+/g, '-') },
    props: {
      continente,
      entries: tutte
        .filter((e) => e.data.continent === continente)
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
      allContinenti: [...new Set(tutte.map((e) => e.data.continent))].sort(),
    },
  }));
}

const { continente, entries, allContinenti } = Astro.props;
const slugify = (s) => s.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout
  title={`${continente} — Destinazioni — Unmarked`}
  description={`Reportage e racconti di viaggio dal continente ${continente}.`}
>
  <DestinazioniArchive
    items={entries}
    continenti={allContinenti}
    eyebrow="Destinazioni · Continente"
    title={continente}
    description={`${entries.length} ${entries.length === 1 ? 'reportage' : 'reportage'} dal continente ${continente}.`}
    currentContinent={slugify(continente)}
    backLink={true}
  />
</BaseLayout>
