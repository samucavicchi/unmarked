---
import { getCollection } from 'astro:content';
export const prerender = true;

export async function getStaticPaths() {
  const libreria = await getCollection('libreria');
  const paesi = [...new Set(libreria.map((e) => e.data.country).filter(Boolean))];
  return paesi.map((paese) => ({
    params: { paese: paese.toLowerCase().replace(/\s+/g, '-') },
  }));
}
const { paese } = Astro.params;
---
<meta http-equiv="refresh" content={`0;url=/libreria/paese/${paese}`} />
<script define:vars={{ paese }}>window.location.replace('/libreria/paese/' + paese);</script>
