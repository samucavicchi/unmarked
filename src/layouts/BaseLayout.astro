---
// Layout base usato da tutte le pagine.
// Carica font, CSS globale, navbar, footer, Netlify Identity widget.

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Unmarked — Luoghi non segnati sulle mappe',
  description = 'Reportage fotografici, itinerari premium e racconti dai posti che non trovi sulle guide.',
  ogImage = '/hero.jpg'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph / social -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Netlify Identity widget — gestisce inviti, login, recupero password.
       Caricato in tutte le pagine pubbliche perché i link email di invito
       reindirizzano alla home del sito (non al pannello admin). -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
  <Navbar />

  <slot />

  <Footer />

  <!-- Quando l'utente fa login via Netlify Identity, lo redirigiamo all'admin del CMS -->
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function (user) {
        if (!user) {
          window.netlifyIdentity.on("login", function () {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
